---
// src/pages/en/classroom-gradebook.astro
// Classroom Management (Lesson Progress), Gradebook (Exercises), and Individual Student Feedback Reports
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const catalogUrl = appLink('catalog', '/');
const appUrl = appLink('app', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classroom Management, Exercise Gradebook & Student Feedback | ColabEdu.net</title>
    <meta name="description" content="View real-time student lesson progress during class or across the week. Manage the authentic exercise Gradebook and generate personalized feedback reports for every student.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-gradebook {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.7) 0%, rgba(243, 232, 255, 0.5) 50%, rgba(254, 243, 199, 0.4) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
        }
        .pulse-live {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse-ring 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
        }
        @keyframes pulse-ring {
            to {
                box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
            }
        }
        /* Alternating chromatic rhythm */
        .section-tint-blue {
            background: linear-gradient(180deg, #FFFFFF 0%, rgba(239, 246, 255, 0.45) 100%);
            border: 1px solid #BFDBFE;
        }
        .section-tint-purple {
            background: linear-gradient(180deg, #FFFFFF 0%, rgba(243, 232, 255, 0.4) 100%);
            border: 1px solid #DDD6FE;
        }
        .section-tint-emerald {
            background: linear-gradient(180deg, #FFFFFF 0%, rgba(209, 250, 229, 0.45) 100%);
            border: 1px solid #A7F3D0;
        }
    </style>
</head>
<body class="selection:bg-purple-600 selection:text-white">

    <Header lang="en" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-gradebook p-8 sm:p-14 text-center mb-16">
                <span class="inline-block text-xs font-mono font-bold tracking-widest uppercase text-purple-900 bg-white/80 px-4 py-1.5 rounded-full border border-purple-300 mb-6">
                    <i class="fas fa-chalkboard-user mr-1.5 text-purple-600"></i> Comprehensive Teacher Analytics
                </span>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Classroom Management, Gradebook<br/>
                    and Student-Level Feedback.
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto mb-8">
                    Three complementary layers for everyday classroom excellence: monitor live lesson pacing during class or across the week, manage the authentic exercise gradebook, and generate individualized pedagogical feedback reports with 1 click.
                </p>
                
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="#view-classes" class="px-6 py-3 rounded-xl bg-purple-600 text-white font-bold text-sm shadow-md hover:bg-purple-700 transition flex items-center gap-2">
                        <i class="fas fa-radar text-xs"></i>
                        <span>1. Lesson Progress (Live & Weekly)</span>
                    </a>
                    <a href="#demo-gradebook" class="px-6 py-3 rounded-xl bg-white text-slate-800 font-bold text-sm border border-slate-300 hover:bg-slate-50 transition flex items-center gap-2">
                        <i class="fas fa-table text-purple-600"></i>
                        <span>2. Exercise Gradebook</span>
                    </a>
                    <a href={appUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl bg-slate-900 text-white font-bold text-sm hover:bg-slate-800 transition flex items-center gap-2">
                        <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                        <span>Open Teacher Dashboard</span>
                    </a>
                </div>
            </div>

            <!-- THREE CLASSROOM MODULES -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
                <!-- Module 1 -->
                <div class="precision-card p-6 border-blue-200 bg-blue-50/20 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg mb-4">
                            <i class="fas fa-person-chalkboard"></i>
                        </div>
                        <span class="text-xs font-mono font-bold text-blue-700 uppercase tracking-wider block mb-1">Module 1 · Classroom Management</span>
                        <h3 class="text-base font-black text-slate-900 mb-2">Lesson Progress</h3>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Know exactly which slide or Socratic checkpoint each student is exploring during class, or track weekly home mastery pacing.
                        </p>
                    </div>
                    <a href="#view-classes" class="text-xs font-bold text-blue-700 hover:underline flex items-center gap-1">
                        <span>View live monitor</span>
                        <i class="fas fa-chevron-down text-[10px]"></i>
                    </a>
                </div>

                <!-- Module 2 -->
                <div class="precision-card p-6 border-purple-200 bg-purple-50/20 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg mb-4">
                            <i class="fas fa-table-list"></i>
                        </div>
                        <span class="text-xs font-mono font-bold text-purple-700 uppercase tracking-wider block mb-1">Module 2 · Gradebook</span>
                        <h3 class="text-base font-black text-slate-900 mb-2">Exercise Grading</h3>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Quantitative and competency-based scores from OCR scanned exams, oral tasks, and reasoned tests synced with Canvas and Moodle.
                        </p>
                    </div>
                    <a href="#demo-gradebook" class="text-xs font-bold text-purple-700 hover:underline flex items-center gap-1">
                        <span>View gradebook</span>
                        <i class="fas fa-chevron-down text-[10px]"></i>
                    </a>
                </div>

                <!-- Module 3 -->
                <div class="precision-card p-6 border-emerald-200 bg-emerald-50/20 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg mb-4">
                            <i class="fas fa-file-waveform"></i>
                        </div>
                        <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wider block mb-1">Module 3 · Individual Feedback</span>
                        <h3 class="text-base font-black text-slate-900 mb-2">Student Feedback Reports</h3>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Personalized narrative diagnostic reports: demonstrated strengths, resolved misconceptions, and targeted Safe Space remediation suggestions.
                        </p>
                    </div>
                    <a href="#feedback-reports" class="text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1">
                        <span>View narrative report</span>
                        <i class="fas fa-chevron-down text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- SECTION 1: CLASSROOM MANAGEMENT & LIVE LESSON MONITOR -->
            <div id="view-classes" class="precision-card section-tint-blue p-6 sm:p-10 mb-16 shadow-lg border-blue-200 scroll-mt-24">
                
                <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-6">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 pulse-live"></span>
                            <span class="text-xs font-mono font-bold text-blue-700 uppercase tracking-widest">
                                Live Classroom Monitor · Active Class Mode
                            </span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-black text-slate-950">
                            Active Lesson: Projectile Motion Kinematics (Grade 11 Honors)
                        </h2>
                    </div>

                    <!-- View Selector: Live vs Weekly -->
                    <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-bold text-slate-600">
                        <button id="btn-view-live" class="px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs">
                            <i class="fas fa-bolt text-amber-500 mr-1"></i> In Class (Live)
                        </button>
                        <button id="btn-view-week" class="px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-900">
                            <i class="fas fa-calendar-week text-indigo-500 mr-1"></i> Weekly Summary
                        </button>
                    </div>
                </div>

                <!-- LIVE STUDENT RADAR VIEW -->
                <div id="panel-live" class="space-y-6">
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        During the classroom session, educators see exactly where each student is working, who needs Socratic support, and who has completed the virtual lab:
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- Step 1 Column -->
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-bold text-slate-700">Step 1: Hook & Theory</span>
                                <span class="text-[11px] font-mono bg-slate-200 px-2 py-0.5 rounded font-bold">2 students</span>
                            </div>
                            <div class="space-y-2">
                                <div class="p-2.5 bg-white rounded-lg border border-slate-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Sophia M.</span>
                                    <span class="text-[10px] text-slate-400 font-mono">02:15 min</span>
                                </div>
                                <div class="p-2.5 bg-white rounded-lg border border-slate-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">David R.</span>
                                    <span class="text-[10px] text-slate-400 font-mono">01:40 min</span>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2 Column -->
                        <div class="p-4 rounded-xl bg-teal-50/60 border border-teal-200">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-bold text-teal-900">Step 2: Interactive Lab</span>
                                <span class="text-[11px] font-mono bg-teal-200 text-teal-950 px-2 py-0.5 rounded font-bold">14 students</span>
                            </div>
                            <div class="space-y-2">
                                <div class="p-2.5 bg-white rounded-lg border border-teal-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Marcus R.</span>
                                    <span class="text-[10px] text-teal-600 font-bold"><i class="fas fa-sliders mr-1"></i>Adjusting</span>
                                </div>
                                <div class="p-2.5 bg-white rounded-lg border border-teal-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Elena G.</span>
                                    <span class="text-[10px] text-teal-600 font-bold"><i class="fas fa-sliders mr-1"></i>Adjusting</span>
                                </div>
                                <div class="p-2.5 bg-white rounded-lg border border-teal-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Lucy N.</span>
                                    <span class="text-[10px] text-teal-600 font-bold"><i class="fas fa-sliders mr-1"></i>Adjusting</span>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3 Column -->
                        <div class="p-4 rounded-xl bg-amber-50/70 border border-amber-200">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-bold text-amber-950">Step 3: Socratic Check</span>
                                <span class="text-[11px] font-mono bg-amber-200 text-amber-950 px-2 py-0.5 rounded font-bold">8 students</span>
                            </div>
                            <div class="space-y-2">
                                <div class="p-2.5 bg-white rounded-lg border border-amber-300 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Charles M.</span>
                                    <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-bold">Hint 2</span>
                                </div>
                                <div class="p-2.5 bg-white rounded-lg border border-amber-300 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Javier V.</span>
                                    <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-bold">Hint 1</span>
                                </div>
                            </div>
                        </div>

                        <!-- Step 4 Column -->
                        <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs font-bold text-emerald-950">Step 4: Mastered</span>
                                <span class="text-[11px] font-mono bg-emerald-200 text-emerald-950 px-2 py-0.5 rounded font-bold">4 students</span>
                            </div>
                            <div class="space-y-2">
                                <div class="p-2.5 bg-white rounded-lg border border-emerald-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Paula S.</span>
                                    <span class="text-[10px] text-emerald-600 font-bold">&check; 100%</span>
                                </div>
                                <div class="p-2.5 bg-white rounded-lg border border-emerald-200 text-xs flex items-center justify-between">
                                    <span class="font-medium text-slate-800">Matthew T.</span>
                                    <span class="text-[10px] text-emerald-600 font-bold">&check; 100%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- WEEKLY SUMMARY VIEW -->
                <div id="panel-week" class="hidden space-y-4">
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        Asynchronous monitoring of weekly assignments (flipped classroom or home practice):
                    </p>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-700 font-mono text-[11px] uppercase border-b border-slate-200">
                                    <th class="p-3">Assigned Lesson</th>
                                    <th class="p-3 text-center">Completion Rate</th>
                                    <th class="p-3 text-center">Avg Time</th>
                                    <th class="p-3 text-center">Key Friction Point</th>
                                    <th class="p-3 text-center">Suggested Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200">
                                <tr>
                                    <td class="p-3 font-bold text-slate-900">Projectile Motion (Physics)</td>
                                    <td class="p-3 text-center font-mono font-bold text-emerald-700">92% (26/28)</td>
                                    <td class="p-3 text-center font-mono">18 min</td>
                                    <td class="p-3 text-center text-amber-700 font-medium">Checkpoint 30° vs 60°</td>
                                    <td class="p-3 text-center"><span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 text-[10px] font-bold">5-min board review</span></td>
                                </tr>
                                <tr>
                                    <td class="p-3 font-bold text-slate-900">Fundamental Theorem of Calculus (AP)</td>
                                    <td class="p-3 text-center font-mono font-bold text-blue-700">86% (24/28)</td>
                                    <td class="p-3 text-center font-mono">24 min</td>
                                    <td class="p-3 text-center text-amber-700 font-medium">Sign in lower bound</td>
                                    <td class="p-3 text-center"><span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-[10px] font-bold">Assign Safe Space capsule</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- SECTION 2: EXERCISE & EXAM GRADEBOOK -->
            <div id="demo-gradebook" class="precision-card p-6 sm:p-10 mb-16 shadow-lg border-purple-200 scroll-mt-24">
                
                <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-200 mb-6">
                    <div>
                        <span class="text-xs font-mono font-bold text-purple-600 uppercase tracking-widest block mb-1">
                            <i class="fas fa-table-list mr-1.5"></i> Authentic Exercise Gradebook
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-black text-slate-950">
                            Gradebook: Submission Scoring & Rubrics (C2/C3)
                        </h2>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-xs font-mono text-slate-500 font-semibold">Cohort: 28 students</span>
                        <button class="px-3 py-1.5 rounded-lg bg-purple-50 text-purple-700 font-bold text-xs border border-purple-200 hover:bg-purple-100 transition">
                            <i class="fas fa-download mr-1"></i> Export to CSV / Canvas
                        </button>
                    </div>
                </div>

                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
                    The <strong>ColabEdu Gradebook</strong> aggregates authentic student submissions (handwritten OCR scans, speaking tests, reasoned items), linking every score to state and national standards:
                </p>

                <!-- Gradebook Table -->
                <div class="overflow-x-auto mb-6">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-100/90 text-slate-700 font-mono border-b border-slate-200 text-[11px] uppercase tracking-wider">
                                <th class="p-3">Student</th>
                                <th class="p-3 text-center">Ex. 1: Matrices</th>
                                <th class="p-3 text-center">Ex. 2: Derivatives</th>
                                <th class="p-3 text-center">Exam: Integrals</th>
                                <th class="p-3 text-center">Standard HS-MATH.2</th>
                                <th class="p-3 text-center">Overall</th>
                                <th class="p-3 text-center">Student Feedback</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200">
                            <!-- Student 1 -->
                            <tr class="hover:bg-slate-50 transition student-row">
                                <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-[10px] font-bold flex items-center justify-center">MR</div>
                                    <span>Marcus Ruiz</span>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">9.5</td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">8.8</td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">9.0</td>
                                <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold text-[10px]">Advanced</span></td>
                                <td class="p-3 text-center font-mono font-black text-slate-900">9.1</td>
                                <td class="p-3 text-center">
                                    <button class="view-report-btn text-purple-700 font-bold hover:underline" data-student="Marcus Ruiz" data-grade="9.1" data-status="high">View Feedback &rarr;</button>
                                </td>
                            </tr>

                            <!-- Student 2 -->
                            <tr class="hover:bg-slate-50 transition student-row">
                                <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-teal-100 text-teal-700 text-[10px] font-bold flex items-center justify-center">LN</div>
                                    <span>Lucy Navarro</span>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-blue-700">7.5</td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">8.0</td>
                                <td class="p-3 text-center font-mono font-bold text-blue-700">7.0</td>
                                <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-blue-100 text-blue-800 font-bold text-[10px]">Proficient</span></td>
                                <td class="p-3 text-center font-mono font-black text-slate-900">7.5</td>
                                <td class="p-3 text-center">
                                    <button class="view-report-btn text-purple-700 font-bold hover:underline" data-student="Lucy Navarro" data-grade="7.5" data-status="mid">View Feedback &rarr;</button>
                                </td>
                            </tr>

                            <!-- Student 3 -->
                            <tr class="hover:bg-amber-50/50 transition student-row">
                                <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold flex items-center justify-center">CM</div>
                                    <span>Charles Morales</span>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-amber-700">5.5</td>
                                <td class="p-3 text-center font-mono font-bold text-red-600">4.5</td>
                                <td class="p-3 text-center font-mono font-bold text-amber-700">6.0</td>
                                <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-amber-100 text-amber-800 font-bold text-[10px]">Reinforcement</span></td>
                                <td class="p-3 text-center font-mono font-black text-slate-900">5.3</td>
                                <td class="p-3 text-center">
                                    <button class="view-report-btn text-purple-700 font-bold hover:underline" data-student="Charles Morales" data-grade="5.3" data-status="low">View Feedback &rarr;</button>
                                </td>
                            </tr>

                            <!-- Student 4 -->
                            <tr class="hover:bg-slate-50 transition student-row">
                                <td class="p-3 font-bold text-slate-900 flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-bold flex items-center justify-center">EG</div>
                                    <span>Elena Garcia</span>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">8.5</td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">8.0</td>
                                <td class="p-3 text-center font-mono font-bold text-emerald-700">8.5</td>
                                <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-bold text-[10px]">High Proficient</span></td>
                                <td class="p-3 text-center font-mono font-black text-slate-900">8.3</td>
                                <td class="p-3 text-center">
                                    <button class="view-report-btn text-purple-700 font-bold hover:underline" data-student="Elena Garcia" data-grade="8.3" data-status="mid-high">View Feedback &rarr;</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-purple-50 rounded-xl border border-purple-200 text-xs text-purple-900 flex items-center justify-between">
                    <span><i class="fas fa-lightbulb text-purple-600 mr-2"></i><strong>Shortcut:</strong> Click <em>"View Feedback &rarr;"</em> to inspect narrative diagnostics and recommendations for the selected student.</span>
                </div>
            </div>

            <!-- SECTION 3: FORMATIVE FEEDBACK REPORTS PER STUDENT -->
            <div id="feedback-reports" class="precision-card section-tint-emerald p-6 sm:p-10 mb-16 shadow-lg border-emerald-200 scroll-mt-24">
                
                <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-6">
                    <div>
                        <span class="text-xs font-mono font-bold text-emerald-600 uppercase tracking-widest block mb-1">
                            Module 3 · Individual Formative Feedback
                        </span>
                        <h3 class="text-xl sm:text-2xl font-black text-slate-900" id="report-title">
                            Feedback Report: Marcus Ruiz
                        </h3>
                    </div>
                    <button class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition flex items-center gap-2">
                        <i class="fas fa-file-pdf"></i>
                        <span>Download Family PDF</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                        <span class="text-xs text-slate-500 font-mono block">Exercise Average Score:</span>
                        <div class="text-3xl font-black text-slate-950 font-mono mt-1" id="report-grade">9.1 / 10</div>
                        <span class="text-[11px] text-emerald-700 font-bold mt-1 block">Mastery Level: Advanced</span>
                    </div>

                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                        <span class="text-xs text-slate-500 font-mono block">Safe Space Practice:</span>
                        <div class="text-3xl font-black text-slate-950 font-mono mt-1">14 sessions</div>
                        <span class="text-[11px] text-slate-600 font-bold mt-1 block">Autonomous Resolution: 92%</span>
                    </div>

                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                        <span class="text-xs text-slate-500 font-mono block">Standards Mastery:</span>
                        <div class="text-3xl font-black text-emerald-600 font-mono mt-1">100%</div>
                        <span class="text-[11px] text-emerald-700 font-bold mt-1 block">Criteria Met: 6/6</span>
                    </div>
                </div>

                <!-- Narrative Report Blocks -->
                <div class="space-y-4 text-xs sm:text-sm text-slate-700 leading-relaxed mb-6" id="report-body">
                    <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200">
                        <h4 class="font-bold text-emerald-950 flex items-center gap-2 mb-1">
                            <i class="fas fa-circle-check text-emerald-600"></i> Strengths Demonstrated in Exercises
                        </h4>
                        <p class="text-emerald-900 text-xs">
                            Excellent formal rigor in setting up integral calculus problems. Solves boundary equations cleanly and specifies geometric area units (units²). Flawless application of the Fundamental Theorem of Calculus.
                        </p>
                    </div>

                    <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-200">
                        <h4 class="font-bold text-blue-950 flex items-center gap-2 mb-1">
                            <i class="fas fa-arrows-to-dot text-blue-600"></i> Growth Diagnostics
                        </h4>
                        <p class="text-blue-900 text-xs">
                            In rational function optimization, tends to verify extrema solely through the first derivative test. Recommend reinforcing justifications using the second derivative test or full sign charts.
                        </p>
                    </div>

                    <div class="p-4 rounded-xl bg-purple-50/70 border border-purple-200">
                        <h4 class="font-bold text-purple-950 flex items-center gap-2 mb-1">
                            <i class="fas fa-route text-purple-600"></i> Assigned Safe Space Remediation
                        </h4>
                        <p class="text-purple-900 text-xs">
                            Assigned the interactive practice capsule <em>"Calculus Optimization: FRQ Justification Workshop"</em> (15 minutes).
                        </p>
                    </div>
                </div>

                <div class="text-[11px] font-mono text-slate-400 border-t border-slate-200 pt-3 flex justify-between">
                    <span>Generated by sovereign Grading V2 engine</span>
                    <span>Reviewed and editable by group instructor</span>
                </div>
            </div>

            <!-- CALLOUT TO PRODUCTION APP -->
            <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
                <div class="max-w-xl">
                    <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-widest block mb-2">
                        Production Platform
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">
                        Experience It in the ColabEdu Educator Suite
                    </h3>
                    <p class="text-sm text-slate-300 leading-relaxed">
                        Access our web dashboard or download native apps for tablet carts to manage your classes with seamless LTI 1.3 gradebook sync.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
                    <a href={appUrl} target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-xl bg-purple-600 text-white font-bold text-sm text-center shadow-md hover:bg-purple-500 transition">
                        Open Educator Dashboard &rarr;
                    </a>
                    <a href="/en/apps" class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-bold text-sm text-center hover:bg-white/20 transition border border-white/20">
                        View Tablet Apps
                    </a>
                </div>
            </div>

        </div>
    </main>

    <Footer lang="en" />

    <!-- REACTIVITY SCRIPT -->
    <script is:inline>
        // Toggle Live vs Weekly View
        const btnLive = document.getElementById('btn-view-live');
        const btnWeek = document.getElementById('btn-view-week');
        const panelLive = document.getElementById('panel-live');
        const panelWeek = document.getElementById('panel-week');

        btnLive?.addEventListener('click', () => {
            btnLive.className = 'px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs';
            btnWeek.className = 'px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-900';
            panelLive?.classList.remove('hidden');
            panelWeek?.classList.add('hidden');
        });

        btnWeek?.addEventListener('click', () => {
            btnWeek.className = 'px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs';
            btnLive.className = 'px-3 py-1.5 rounded-lg text-slate-500 hover:text-slate-900';
            panelWeek?.classList.remove('hidden');
            panelLive?.classList.add('hidden');
        });

        // Dynamic individual feedback report viewer
        const reportTitle = document.getElementById('report-title');
        const reportGrade = document.getElementById('report-grade');
        const reportBody = document.getElementById('report-body');

        document.querySelectorAll('.view-report-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const name = btn.getAttribute('data-student') || 'Student';
                const grade = btn.getAttribute('data-grade') || '8.0';
                const status = btn.getAttribute('data-status') || 'mid';

                if (reportTitle) reportTitle.textContent = `Feedback Report: ${name}`;
                if (reportGrade) reportGrade.textContent = `${grade} / 10`;

                if (reportBody) {
                    if (status === 'low') {
                        reportBody.innerHTML = `
                            <div class="p-4 rounded-xl bg-amber-50/70 border border-amber-200">
                                <h4 class="font-bold text-amber-950 flex items-center gap-2 mb-1">
                                    <i class="fas fa-triangle-exclamation text-amber-600"></i> Identified Concept Gap
                                </h4>
                                <p class="text-amber-900 text-xs">
                                    Observed confusion when applying the chain rule to composite trigonometric expressions. However, immediate antiderivative evaluation has shown marked improvement after 4 practice sessions in the Safe Space.
                                </p>
                            </div>
                            <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-200">
                                <h4 class="font-bold text-blue-950 flex items-center gap-2 mb-1">
                                    <i class="fas fa-compass text-blue-600"></i> Targeted Remediation Pathway
                                </h4>
                                <p class="text-blue-900 text-xs">
                                    Assigned lesson: <em>"Visual Chain Rule: Nested Doll Decomposition"</em> with Socratic Copilot active in progressive guidance mode.
                                </p>
                            </div>
                        `;
                    } else {
                        reportBody.innerHTML = `
                            <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200">
                                <h4 class="font-bold text-emerald-950 flex items-center gap-2 mb-1">
                                    <i class="fas fa-circle-check text-emerald-600"></i> Strengths Demonstrated in Exercises
                                </h4>
                                <p class="text-emerald-900 text-xs">
                                    Consistent and rigorous progress. Confidently fulfills all analytical modeling and graphical bounds criteria. Systematically states mean value theorem hypotheses before computing.
                                </p>
                            </div>
                            <div class="p-4 rounded-xl bg-purple-50/70 border border-purple-200">
                                <h4 class="font-bold text-purple-950 flex items-center gap-2 mb-1">
                                    <i class="fas fa-star text-purple-600"></i> Curricular Enrichment
                                </h4>
                                <p class="text-purple-900 text-xs">
                                    Recommended for advanced AP Calculus Free-Response item sets and school mathematics competition challenges.
                                </p>
                            </div>
                        `;
                    }
                }

                document.getElementById('feedback-reports')?.scrollIntoView({ behavior: 'smooth' });
            });
        });
    </script>

</body>
</html>
