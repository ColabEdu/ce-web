---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en">


    
    <div class="pt-24 pb-4 bg-slate-50 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center">
            <div class="flex space-x-2 bg-white p-1 rounded-2xl shadow-sm border border-slate-200">
                    <button onclick="switchView('teacher')" id="btn-teacher" class="px-4 py-2 text-sm font-semibold transition-all tab-active">For Teachers</button>
                    <button onclick="switchView('schools')" id="btn-schools" class="px-4 py-2 text-sm font-semibold transition-all text-slate-500 hover:text-primary">For Institutions</button>
                </div>
        </div>
    </div>
<main class="pt-8 pb-12">
        <div id="view-teacher" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <header class="mb-12">
                <h1 class="text-4xl font-extrabold text-dark tracking-tight sm:text-6xl">Grading that gives back <span class="text-primary">time.</span></h1>
                <p class="mt-6 text-xl text-slate-600 max-w-3xl">Administrative tasks consume 80% of teachers' time. Our AI automates multimodal processing so you can get back to what matters: inspiring.</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
                <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm bento-item">
                    <div class="text-primary text-3xl mb-4">&#128394;</div>
                    <h3 class="text-xl font-bold mb-2">Handwriting to Data</h3>
                    <p class="text-slate-500 text-sm">Advanced OCR with 99% accuracy that interprets even the most complex handwriting.</p>
                </div>
                <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm bento-item">
                    <div class="text-primary text-3xl mb-4">&#127897;</div>
                    <h3 class="text-xl font-bold mb-2">Voice and Interaction</h3>
                    <p class="text-slate-500 text-sm">Real-time assessment of fluency and content in language oral presentations.</p>
                </div>
                <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm bento-item">
                    <div class="text-primary text-3xl mb-4">&#128203;</div>
                    <h3 class="text-xl font-bold mb-2">Dynamic Rubrics</h3>
                    <p class="text-slate-500 text-sm">Automatic generation of descriptors aligned to international standards.</p>
                </div>
            </div>

            <section class="bg-dark rounded-[2.5rem] p-8 md:p-16 text-white overflow-hidden relative">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
                    <div>
                        <h2 class="text-3xl font-bold mb-6">Weekly Time Savings</h2>
                        <p class="text-slate-400 mb-8">Visualize operational transformation. Time saved translates to a direct reduction in teacher burnout.</p>
                        <div class="space-y-4">
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center text-primary">&#10003;</div>
                                <span>17 minutes saved per evaluated essay.</span>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="w-12 h-12 rounded-full bg-accent/20 flex items-center justify-center text-accent">&#10003;</div>
                                <span>Automatic sync with LMS Gradebook.</span>
                            </div>
                        </div>
                    </div>
                    <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700">
                        <div class="chart-container">
                            <canvas id="teacherTimeChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div id="view-schools" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <header class="mb-12">
                <h1 class="text-4xl font-extrabold text-dark tracking-tight sm:text-6xl">Standardization and <span class="text-primary">Academic Equity.</span></h1>
                <p class="mt-6 text-xl text-slate-600 max-w-3xl">This section details how ColabEdu scales pedagogical excellence from a single classroom to a whole regional education system, solving the challenge of grading consistency.</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
                <div class="md:col-span-2 bg-indigo-600 p-8 rounded-3xl text-white flex flex-col justify-between">
                    <div>
                        <h3 class="text-2xl font-bold mb-4">Eliminate Pedagogical Drift</h3>
                        <p class="text-indigo-100 opacity-90">Ensure every teacher, in every school, grades under the same success criteria. Master Recipes guarantee equity for every student.</p>
                    </div>
                    <div class="mt-8 pt-8 border-t border-indigo-500">
                        <p class="text-sm font-medium">Benefit: 45% reduction in grading discrepancies between teachers.</p>
                    </div>
                </div>
                <div class="md:col-span-2 bg-white p-8 rounded-3xl border border-slate-200">
                    <h3 class="text-xl font-bold mb-4">Real-Time Consistency</h3>
                    <div class="chart-container h-64">
                        <canvas id="consistencyChart"></canvas>
                    </div>
                </div>
                <div class="bg-slate-100 p-6 rounded-3xl border border-slate-200 flex flex-col items-center text-center">
                    <div class="text-3xl mb-2">&#128202;</div>
                    <h4 class="font-bold">Massive Analytics</h4>
                    <p class="text-xs text-slate-500 mt-2">District-wide competency gap detection.</p>
                </div>
                <div class="bg-slate-100 p-6 rounded-3xl border border-slate-200 flex flex-col items-center text-center">
                    <div class="text-3xl mb-2">&#128274;</div>
                    <h4 class="font-bold">LTI 1.3 Advantage</h4>
                    <p class="text-xs text-slate-500 mt-2">Institutional-grade security and deep synchronization.</p>
                </div>
                <div class="bg-slate-100 p-6 rounded-3xl border border-slate-200 flex flex-col items-center text-center">
                    <div class="text-3xl mb-2">&#128101;</div>
                    <h4 class="font-bold">Teacher Retention</h4>
                    <p class="text-xs text-slate-500 mt-2">Anti-Burnout technology to retain the best teachers.</p>
                </div>
                <div class="bg-slate-100 p-6 rounded-3xl border border-slate-200 flex flex-col items-center text-center">
                    <div class="text-3xl mb-2">&#128214;</div>
                    <h4 class="font-bold">Data Sovereignty</h4>
                    <p class="text-xs text-slate-500 mt-2">Total control over the institution's pedagogical IP.</p>
                </div>
            </div>

            <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
                <div class="bg-white p-10 rounded-[2.5rem] border border-slate-200">
                    <h2 class="text-2xl font-bold mb-6">Competency Gap Map</h2>
                    <p class="text-slate-600 mb-8 text-sm">This visual report allows principals to identify which departments need reinforcement. Data flows directly from daily assessments, eliminating the need for manual reports.</p>
                    <div class="chart-container">
                        <canvas id="competencyMapChart"></canvas>
                    </div>
                </div>
                <div class="space-y-6">
                    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
                        <h4 class="font-bold text-primary mb-2">For Schools and Departments</h4>
                        <p class="text-slate-600 text-sm">Implement a shared bank of rubrics. The Curator Agent ingests your current syllabi and turns them into intelligent evaluators in minutes.</p>
                    </div>
                    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
                        <h4 class="font-bold text-accent mb-2">For Governments and Ministries</h4>
                        <p class="text-slate-600 text-sm">Monitor compliance with national standards (LOMLOE, SEP, Common Core) without bureaucracy. Generate national-level reports with one click.</p>
                    </div>
                    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
                        <h4 class="font-bold text-orange-500 mb-2">For Publishers</h4>
                        <p class="text-slate-600 text-sm">Revitalize your static catalog. Turn your textbooks into interactive Socratic Tutors that evaluate and guide the student.</p>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <section id="cta" class="py-20 bg-dark relative overflow-hidden text-center">
        <div class="max-w-4xl mx-auto px-4 relative z-10">
            <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-8">The future of assessment is <span class="text-primary">collaborative.</span></h2>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <button class="px-8 py-4 bg-primary text-white font-bold rounded-full hover:bg-indigo-700 transition-all shadow-xl">Request Institutional Demo</button>
                <button class="px-8 py-4 bg-white text-dark font-bold rounded-full hover:bg-slate-100 transition-all shadow-md">Check Pricing</button>
            </div>
        </div>
    </section>

    

    <!-- Interactive Scripts -->
    <script is:inline>
        let charts = {};

        function switchView(view) {
            document.getElementById('view-teacher').classList.add('hidden');
            document.getElementById('view-schools').classList.add('hidden');
            document.getElementById('btn-teacher').classList.remove('tab-active');
            document.getElementById('btn-schools').classList.remove('tab-active');
            document.getElementById('btn-teacher').classList.add('text-slate-500');
            document.getElementById('btn-schools').classList.add('text-slate-500');

            if (view === 'teacher') {
                document.getElementById('view-teacher').classList.remove('hidden');
                document.getElementById('btn-teacher').classList.add('tab-active');
                document.getElementById('btn-teacher').classList.remove('text-slate-500');
            } else {
                document.getElementById('view-schools').classList.remove('hidden');
                document.getElementById('btn-schools').classList.add('tab-active');
                document.getElementById('btn-schools').classList.remove('text-slate-500');
            }
            renderCharts();
        }

        function renderCharts() {
            Object.values(charts).forEach(chart => chart.destroy());

            // Teacher Savings Chart
            const ctx1 = document.getElementById('teacherTimeChart').getContext('2d');
            charts.teacher = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: ['Manual Grading', 'ColabEdu Grading'],
                    datasets: [{
                        label: 'Weekly Hours',
                        data: [30, 5],
                        backgroundColor: ['#6366F1', '#10B981'],
                        borderRadius: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94a3b8' } },
                        x: { ticks: { color: '#94a3b8' } }
                    }
                }
            });

            // Consistency Chart (Radar)
            const ctx2 = document.getElementById('consistencyChart').getContext('2d');
            charts.consistency = new Chart(ctx2, {
                type: 'radar',
                data: {
                    labels: ['Grammar', 'Content', 'Vocabulary', 'Tone', 'Structure'],
                    datasets: [{
                        label: 'Human Variance',
                        data: [80, 75, 90, 60, 85],
                        borderColor: '#F43F5E',
                        backgroundColor: 'rgba(244, 63, 94, 0.2)'
                    }, {
                        label: 'ColabEdu Standardization',
                        data: [98, 97, 99, 95, 98],
                        borderColor: '#10B981',
                        backgroundColor: 'rgba(16, 185, 129, 0.2)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { r: { grid: { color: '#e2e8f0' }, pointLabels: { font: { size: 10 } } } }
                }
            });

            // Competency Map (Horizontal Bar)
            const ctx3 = document.getElementById('competencyMapChart').getContext('2d');
            charts.competency = new Chart(ctx3, {
                type: 'bar',
                indexAxis: 'y',
                data: {
                    labels: ['Critical Thinking', 'Use of Evidence', 'Agreement', 'Oral Fluency', 'Literary Analysis'],
                    datasets: [{
                        label: 'District Mastery Level (%)',
                        data: [65, 42, 88, 55, 70],
                        backgroundColor: '#4F46E5',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { max: 100, ticks: { callback: v => v + '%' } }
                    }
                }
            });
        }

        window.onload = renderCharts;
    </script>
</BaseLayout>
