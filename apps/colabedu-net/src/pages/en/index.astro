---
// src/pages/en/index.astro
// Canonical homepage for ColabEdu.net: "Nordic Precision & Warm Community" Hybrid Architecture
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const lang = 'en';
const catalogUrl = appLink('app', '/navigator/spec_root/0');
const seoCatalogUrl = appLink('catalog', '/');
const appUrl = appLink('app', '/');
const supportUrl = appLink('support', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ColabEdu | Technology that gives teachers their time and passion back</title>
    <meta name="description" content="Open, Socratic infrastructure for the classroom: handwritten homework pre-grading, 24/7 tutoring, and cohort remediation.">
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />

    <!-- Google Fonts: Plus Jakarta Sans, Caveat (Real Handwriting OCR), and JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    <!-- KaTeX for pristine math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-handwriting: 'Caveat', cursive, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --color-canvas: #FAF9F6;
            --color-card: #FFFFFF;
            --color-border: #E2E8F0;
            --color-primary: #1D4ED8;
            --color-teal: #0F766E;
            --color-amber: #D97706;
            --color-dark: #0F172A;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--color-canvas);
            color: var(--color-dark);
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        .font-handwriting {
            font-family: var(--font-handwriting);
        }

        .font-mono-code {
            font-family: var(--font-mono);
        }

        /* Warm organic hero container */
        .hero-shell {
            background: linear-gradient(135deg, rgba(254, 243, 199, 0.5) 0%, rgba(240, 253, 250, 0.6) 50%, rgba(238, 242, 255, 0.4) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero-blob-amber {
            position: absolute;
            top: -15%;
            left: -10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, transparent 70%);
            filter: blur(40px);
            pointer-events: none;
        }

        .hero-blob-teal {
            position: absolute;
            bottom: -20%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(15, 118, 110, 0.16) 0%, transparent 70%);
            filter: blur(50px);
            pointer-events: none;
        }

        /* 1px Swiss Precision Card */
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03), 0 1px 2px -1px rgba(15, 23, 42, 0.02);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.06), 0 8px 12px -4px rgba(15, 23, 42, 0.03);
            transform: translateY(-2px);
        }

        /* Ruled graph paper for handwriting OCR widget */
        .ruled-paper {
            background-color: #FFFDF9;
            background-image: 
                linear-gradient(to right, rgba(203, 213, 225, 0.25) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(203, 213, 225, 0.25) 1px, transparent 1px);
            background-size: 20px 20px;
            border: 1px solid #E2E8F0;
        }

        /* OCR Annotation Bounding Box */
        .ocr-highlight-box {
            position: relative;
            background: rgba(254, 240, 138, 0.45);
            border: 1.5px dashed #D97706;
            border-radius: 4px;
            padding: 1px 6px;
            display: inline-block;
        }

        .ocr-chip {
            position: absolute;
            top: -11px;
            right: -6px;
            background: #0F172A;
            color: #FEF08A;
            font-size: 9px;
            font-family: var(--font-mono);
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 4px;
            letter-spacing: 0.02em;
        }

        /* Pill tags */
        .tag-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.3rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        /* Distinct section backgrounds */
        .section-dark-slate {
            background-color: #0F172A; /* Slate 900 */
            color: #F8FAFC;
        }

        .section-dark-slate .precision-card {
            background-color: #1E293B;
            border-color: #334155;
            color: #F8FAFC;
        }

        .section-dark-slate .precision-card:hover {
            border-color: #475569;
        }

        /* Subtle ambient grid pattern */
        .ambient-grid {
            background-image: radial-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="selection:bg-blue-600 selection:text-white">

    <!-- Top Announcement Bar (Community & Season) -->
    <aside aria-label="Seasonal announcement" class="bg-slate-900 text-slate-300 text-xs py-2.5 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-2 text-center sm:text-left">
                <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span><strong>Spring 2027 Season:</strong> Official AP Exams, IB Spanish & Selectividad EBAU/PAU simulations ready for one-click assignment.</span>
            </div>
            <div class="flex items-center gap-4 text-slate-400 text-xs">
                <a href={catalogUrl} class="hover:text-amber-400 transition-colors flex items-center gap-1 font-semibold text-white">
                    <span>Explore OER Catalog</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
                <span class="text-slate-700">|</span>
                <span class="text-slate-400">Currency: <strong class="text-amber-300">USD ($) / EUR (€)</strong></span>
            </div>
        </div>
    </aside>

    <!-- Header Navigation -->
    <Header lang={lang} />

    <!-- SECTION 1A: MACRO INSTITUTIONAL HERO & THE WORLD'S LARGEST INTERACTIVE OER CATALOG -->
    <main class="pt-10 sm:pt-14 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="hero-shell p-8 sm:p-14 lg:p-16 text-center">
                <div class="hero-blob-amber"></div>
                <div class="hero-blob-teal"></div>

                <div class="relative z-10 max-w-4xl mx-auto">
                    <!-- Warm Organic Pill Badge -->
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/95 border border-amber-300/80 text-amber-950 text-xs font-bold shadow-xs mb-6">
                        <span class="flex h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>The world's largest interactive Open Educational Resources (OER) catalog</span>
                    </div>

                    <!-- Main Punchy Title -->
                    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-slate-950 tracking-tight leading-[1.08] mb-6">
                        Technology that gives time and passion back to your <span class="text-blue-600">teachers</span>.<br/>
                        Intelligence that empowers your <span class="text-teal-600">students</span>.
                    </h1>

                    <!-- Subtitle with the full technological factory scope -->
                    <p class="text-base sm:text-xl text-slate-700 font-normal leading-relaxed mb-8 max-w-3xl mx-auto">
                        We are building the <strong>world's largest AI-assisted interactive catalog of Open Educational Resources (OER)</strong>, syndicating over <strong>65 official open repositories</strong> (such as OpenStax, INTEF, SEP, and official exam boards) and enriching them with active simulations and 9-step Socratic scaffolding. A global community sustaining sovereign compute, zero ads, zero data sales, and 100% auditability.
                    </p>

                    <!-- Hero Strategic Action Buttons (Vision, Catalog Philosophy, L0 Standards & Catalog) -->
                    <div class="flex flex-wrap items-center justify-center gap-3.5 mb-8">
                        <button
                            type="button"
                            data-open-catalog-modal
                            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-sm shadow-md hover:shadow-lg transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5"
                        >
                            <i class="fas fa-layer-group text-base"></i>
                            <span>Explore OER Catalog</span>
                            <span class="text-xs bg-amber-950/20 text-slate-950 font-mono px-2 py-0.5 rounded-md font-bold">65+ Repositories</span>
                        </button>

                        <a
                            href="/en/vision"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-compass text-blue-600 text-xs"></i>
                            <span>Our Vision</span>
                        </a>

                        <a
                            href="/en/catalog-philosophy"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-book-open text-amber-600 text-xs"></i>
                            <span>Catalog Philosophy</span>
                        </a>

                        <a
                            href="/en/grounding"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-scale-balanced text-teal-600 text-xs"></i>
                            <span>L0 Standards & Grounding</span>
                        </a>

                        <a
                            href="/en/cross-competencies"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-teal-50/60 text-slate-900 font-black text-sm border border-teal-300 hover:border-teal-500 shadow-xs transition-all flex items-center gap-2 group"
                        >
                            <i class="fas fa-network-wired text-teal-600 text-xs group-hover:scale-110 transition-transform"></i>
                            <span>Cross-Competencies & PISA</span>
                            <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-teal-100 text-teal-900">Zero Paperwork</span>
                        </a>
                    </div>

                    <!-- Discrete Secondary Navigation: Memberships and OPS Specification -->
                    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-600 font-semibold pt-4 border-t border-slate-200/80">
                        <a href="/en/ops-specification" class="hover:text-blue-700 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-cube text-blue-600"></i>
                            <span>Open Pedagogy Specification OPS v0.9.6</span>
                        </a>
                        <span class="text-slate-300 hidden sm:inline">·</span>
                        <a href="/en/cross-competencies#shadow-audits" class="hover:text-indigo-700 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-ghost text-indigo-600"></i>
                            <span>Shadow Audits for Districts</span>
                        </a>
                        <span class="text-slate-300 hidden sm:inline">·</span>
                        <a href="/en/memberships" class="hover:text-teal-800 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-hand-holding-heart text-teal-600"></i>
                            <span>Sustaining Memberships & Equity Grants</span>
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- SECTION 1B: AUDIENCE GATEWAYS MINI-SECTION (Teachers vs. Students & Tutoring) -->
    <section class="pb-16 pt-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-xs">
                
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
                        Direct Learning & Teaching Pathways
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">
                        How would you like to use ColabEdu today?
                    </h2>
                </div>

                <!-- Audience-First Direct Gateways (Teachers vs. Tutoring & Academy) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-8 text-left">
                    <!-- Card 1: Teachers & SpeedGrader + OER Sunday to Monday -->
                    <a href="#teacher-quality-of-life" class="precision-card p-6 bg-gradient-to-br from-blue-50/40 to-white border-blue-200 hover:border-blue-500 hover:shadow-xl transition-all flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </div>
                                <span class="tag-badge bg-blue-100 text-blue-900 border border-blue-200">
                                    Teachers & Schools
                                </span>
                            </div>
                            <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                                Take back your Sundays: Ready OER materials + SpeedGrader AI
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Access thousands of standards-aligned interactive OER lessons and exercises ready to assign on Sunday evening in 5 minutes for Monday morning. Plus, pre-grade handwritten papers in Canvas, Moodle, or Google Classroom, saving 15 hours weekly.
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
                            <span>View teacher workflow &rarr;</span>
                            <span class="text-[11px] text-slate-400 font-normal">Preparation and grading savings</span>
                        </div>
                    </a>

                    <!-- Card 2: Students, Families & Tutoring -->
                    <a href="#tutoring-academy" class="precision-card p-6 bg-gradient-to-br from-teal-50/40 to-white border-teal-200 hover:border-teal-500 hover:shadow-xl transition-all flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
                                    <i class="fas fa-graduation-cap"></i>
                                </div>
                                <span class="tag-badge bg-teal-100 text-teal-900 border border-teal-200">
                                    Students & Families
                                </span>
                            </div>
                            <h3 class="text-lg font-black text-slate-900 group-hover:text-teal-700 transition-colors mb-2">
                                24/7 Academy & Socratic Tutoring at Home
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                A Socratic tutor that scaffolds thinking step-by-step across Math, Physics, and Language without giving answers away. Enjoy a judgment-free "Safe Space" and tailored linguistic accommodations for newcomer students.
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-teal-700">
                            <span>Explore tutoring & practice &rarr;</span>
                            <span class="text-[11px] text-slate-400 font-normal">Zero judgment, zero frustration</span>
                        </div>
                    </a>
                </div>

                <!-- Live metric pills -->
                <div class="pt-6 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-bold text-slate-700 max-w-4xl mx-auto">
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-clock text-amber-600 text-base"></i>
                        <span><strong>15 hours weekly</strong> recovered per teacher</span>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-bolt text-teal-600 text-base"></i>
                        <span><strong>SpeedGrader Canvas & Moodle</strong> in 1 click</span>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-scale-balanced text-blue-600 text-base"></i>
                        <span>Official rubrics: <strong>Common Core · Texas TEKS · AP · IB · LOMLOE · SEP</strong></span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 2: OPEN PEDAGOGY TECHNOLOGY FACTORY (4 Core Pillars) -->
    <section class="py-20 sm:py-28 bg-white border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="tag-badge bg-blue-50 text-blue-700 border border-blue-200 uppercase tracking-wider text-xs mb-3">
                    <i class="fas fa-microchip mr-1.5 text-blue-600"></i> Leading-Edge EdTech Architecture
                </span>
                <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
                    Deep technology built to resolve real classroom friction
                </h2>
                <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
                    Transforming static textbooks into living interactive experiences and reading authentic student handwriting requires a unique synthesis of curriculum engineering, computer vision, and sovereign compute.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

                <!-- PILAR 1: Living Interactive Lessons with Socratic Copilot -->
                <div class="precision-card p-8 border-slate-200 bg-gradient-to-br from-white to-amber-50/20 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <span class="tag-badge bg-amber-100 text-amber-900 border border-amber-300">
                                <i class="fas fa-cubes mr-1.5 text-amber-600"></i> Interactive Lessons
                            </span>
                            <span class="text-xs font-mono font-bold text-slate-400">OPS v0.9.6 RUNTIME</span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
                            Living Interactive Lessons with Socratic Copilot
                        </h3>
                        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                            Far beyond flat PDFs. Each unit compiles into a live interactive web environment with embedded PhET simulations, draggable KaTeX equations, and AI-assisted exercises guided by a Socratic tutor that scaffolds thinking across 9 pedagogical steps without giving away answers.
                        </p>

                        <!-- Math & Science Simulation Preview Box -->
                        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs mb-6">
                            <div class="flex justify-between items-center text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                                <span>Live Geometric Proof Demonstration</span>
                                <span class="text-amber-600 font-mono">MATH.SEC.PYTHAGORAS</span>
                            </div>
                            <div class="text-lg font-bold text-blue-900 py-1 font-mono-code text-center" id="pythagoras-display">
                                a² + b² = c² &nbsp;⟺&nbsp; c = √(a² + b²)
                            </div>
                            <div class="text-xs text-slate-500 mt-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100 italic text-center">
                                "Why does the sum of the areas of the squares on both legs equal exactly the square on the hypotenuse?"
                            </div>
                        </div>
                    </div>

                    <div class="pt-5 border-t border-slate-100 flex items-center justify-between">
                        <a href={appUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-extrabold text-amber-800 hover:text-amber-950">
                            <span>Launch interactive lesson</span>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                        <span class="text-xs text-slate-400 font-medium">Interactive Web Experience</span>
                    </div>
                </div>

                <!-- PILAR 2: Grading V2 and Teacher Evaluative Copilot -->
                <div class="precision-card p-8 border-slate-200 bg-gradient-to-br from-white to-blue-50/20 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <span class="tag-badge bg-blue-100 text-blue-900 border border-blue-300">
                                <i class="fas fa-signature mr-1.5 text-blue-600"></i> Teacher Evaluative Copilot
                            </span>
                            <span class="tag-badge bg-emerald-100 text-emerald-800 border border-emerald-300">
                                99.2% Authentic Handwriting
                            </span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
                            AI-Assisted Pre-Grading for Handwritten and Oral Assessments
                        </h3>
                        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                            Students keep writing by hand on paper or practicing spoken dialogue. Our copilot processes multi-page phone camera scans and voice recordings in real time, benchmarks against official rubrics (Common Core, Texas TEKS, AP, IB, LOMLOE, and SEP/NEM Mexico), and generates a proposed grade with drafted feedback for teacher review and sign-off.
                        </p>

                        <!-- Realistic Exam Ruled Paper Preview -->
                        <div class="ruled-paper rounded-xl p-4 text-xs leading-relaxed mb-4 shadow-xs relative">
                            <span class="text-[10px] font-mono text-slate-400 block mb-1 uppercase font-bold">Physical Student Submission (AP US History / European History · 3 Pages):</span>
                            <p class="font-handwriting text-slate-800 text-xl font-semibold leading-normal">
                                "...the <span class="ocr-highlight-box">Declaration of Independence<span class="ocr-chip">L0.ART.4</span></span> established popular sovereignty and unalienable rights, though colonial wartime mobilization limited immediate execution..."
                            </p>
                        </div>

                        <!-- Instant AI Pregrading Feedback -->
                        <div class="bg-slate-900 text-slate-200 rounded-xl p-3.5 text-xs font-mono-code space-y-1">
                            <div class="flex justify-between items-center text-emerald-400 font-bold">
                                <span>✔ Copilot: Rubric Criterion CCSS.ELA-HIST.4 Verified</span>
                                <span class="bg-emerald-950 px-2 py-0.5 rounded border border-emerald-800">Draft: 2.25 / 2.50</span>
                            </div>
                            <p class="text-[11px] text-slate-300">
                                Teacher suggestion: "Sovereignty thesis is clearly articulated. Prompt the student to elaborate on the social contract theory."
                            </p>
                        </div>
                    </div>

                    <div class="pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                        <span class="text-xs font-bold text-emerald-700 flex items-center gap-1.5">
