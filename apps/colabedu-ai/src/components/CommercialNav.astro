---
const locales = [
    { code: "es_ES", label: "🇪🇸 ES", name: "Español (España)" },
    { code: "en_US", label: "🇺🇸 US", name: "English (US)" },
    { code: "fr_FR", label: "🇫🇷 FR", name: "Français" },
    { code: "pt_BR", label: "🇧🇷 BR", name: "Português (Brasil)" },
    { code: "pt_PT", label: "🇵🇹 PT", name: "Português (Portugal)" },
    { code: "ca_ES", label: "🏴 CA", name: "Català" },
    { code: "eu_ES", label: "🏴 EU", name: "Euskara" },
    { code: "gl_ES", label: "🏴 GL", name: "Galego" },
    { code: "es_MX", label: "🇲🇽 MX", name: "Español (México)" },
    { code: "es_US", label: "🇺🇸 ES", name: "Español (EE.UU.)" },
];

const currentPath = Astro.url.pathname;
const segments = currentPath.split("/").filter(Boolean);
const existingLocale = locales.find((l) => segments[0] === l.code);
const currentLocale = existingLocale ? existingLocale.code : "es_ES";

const navItems = [
    { name: "Profesores", href: `/${currentLocale}/` },
    { name: "Instituciones", href: `/${currentLocale}/schools` },
    { name: "Editoriales", href: `/${currentLocale}/editorial` },
    { name: "Gobierno", href: `/${currentLocale}/government` },
];

function getLocalizedPath(path: string, locale: string) {
    const pathSegments = path.split("/").filter(Boolean);
    const hasLocale = locales.find((l) => pathSegments[0] === l.code);

    if (hasLocale) {
        pathSegments[0] = locale;
    } else {
        pathSegments.unshift(locale);
    }
    return "/" + pathSegments.join("/");
}
---

<nav
    class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-200"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-20 items-center">
            <!-- Logo -->
            <div class="flex items-center space-x-2">
                <a
                    href={`/${currentLocale}/`}
                    class="text-2xl font-black tracking-tighter text-slate-900"
                >
                    Colab<span class="text-indigo-600">Edu</span>
                </a>
                <span
                    class="bg-indigo-50 text-indigo-600 text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-widest border border-indigo-100 hidden sm:inline-block"
                >
                    Commercial
                </span>
            </div>

            <!-- Desktop Nav -->
            <div
                class="hidden md:flex space-x-1 bg-slate-100 p-1.5 rounded-2xl border border-slate-200"
            >
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="px-5 py-2 text-xs font-bold rounded-xl transition-all uppercase tracking-wider text-slate-500 hover:text-indigo-600 hover:bg-white hover:shadow-sm"
                        >
                            {item.name}
                        </a>
                    ))
                }
            </div>

            <!-- Actions -->
            <div class="hidden md:flex items-center gap-4">
                <!-- Locale Selector -->
                <div class="relative group">
                    <button
                        class="flex items-center space-x-1 text-xs font-bold text-slate-500 hover:text-slate-900 uppercase tracking-widest"
                    >
                        <span
                            >{
                                locales.find((l) => l.code === currentLocale)
                                    ?.label || currentLocale
                            }</span
                        >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 9l-7 7-7-7"></path></svg
                        >
                    </button>
                    <div
                        class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-100 hidden group-hover:block p-2 max-h-64 overflow-y-auto"
                    >
                        {
                            locales.map((locale) => (
                                <a
                                    href={getLocalizedPath(
                                        currentPath,
                                        locale.code,
                                    )}
                                    class="block px-4 py-2 text-xs text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg"
                                >
                                    <span class="mr-2">
                                        {locale.label.split(" ")[0]}
                                    </span>{" "}
                                    {locale.name}
                                </a>
                            ))
                        }
                    </div>
                </div>

                <a
                    href="/docs"
                    class="text-xs font-bold text-slate-500 hover:text-slate-900 uppercase tracking-widest hidden lg:block"
                >
                    Docs
                </a>
                <button
                    class="px-6 py-2.5 bg-slate-900 text-white rounded-full text-xs font-bold hover:bg-slate-800 transition-all shadow-lg"
                >
                    Consola Admin
                </button>
            </div>

            <!-- Mobile Menu Button -->
            <div class="md:hidden flex items-center">
                <button
                    id="mobile-menu-btn"
                    class="text-slate-600 hover:text-slate-900 focus:outline-none p-2"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div
        id="mobile-menu"
        class="hidden md:hidden bg-white border-t border-slate-100 absolute w-full shadow-xl"
    >
        <div class="px-4 pt-2 pb-6 space-y-1">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="block px-3 py-3 rounded-md text-base font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-50 border-b border-slate-50"
                    >
                        {item.name}
                    </a>
                ))
            }
            <!-- Mobile Locale Selector -->
            <div class="px-3 py-3 border-b border-slate-50">
                <p
                    class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2"
                >
                    Región / Idioma
                </p>
                <div class="grid grid-cols-2 gap-2">
                    {
                        locales.map((locale) => (
                            <a
                                href={getLocalizedPath(
                                    currentPath,
                                    locale.code,
                                )}
                                class="text-xs text-slate-600 py-1 hover:text-indigo-600"
                            >
                                {locale.label}
                            </a>
                        ))
                    }
                </div>
            </div>

            <a
                href="/docs"
                class="block px-3 py-3 rounded-md text-base font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-50 border-b border-slate-50"
                >Docs</a
            >
            <div class="pt-4">
                <button
                    class="w-full px-5 py-3 text-center font-bold text-white bg-indigo-600 rounded-full hover:bg-indigo-700 shadow-md"
                >
                    Consola Admin
                </button>
            </div>
        </div>
    </div>
</nav>

<script>
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
        btn.addEventListener("click", () => {
            menu.classList.toggle("hidden");
        });
    }
</script>
