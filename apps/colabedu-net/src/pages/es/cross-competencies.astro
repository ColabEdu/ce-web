---
// src/pages/es/cross-competencies.astro
// Motor de Competencias Cruzadas (Europeas, Nacionales y Globales) y Auditorías Shadow
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/navigator/spec_root/0');
const catalogUrl = appLink('catalog', '/');
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Competencias Cruzadas y Auditorías Shadow | ColabEdu.net</title>
    <meta name="description" content="El fin de la pesadilla burocrática docente: asignación automática de competencias europeas, nacionales (LOMLOE, Common Core, TEKS) y globales (PISA, IB). Auditorías diagnósticas invisibles en LMS sin estrés de examen.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card-dark {
            background-color: #0F172A !important;
            color: #FFFFFF !important;
            border: 1px solid #334155 !important;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-cross {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.8) 0%, rgba(240, 253, 250, 0.7) 50%, rgba(254, 243, 199, 0.5) 100%);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 2rem;
        }
        .flow-step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-family: var(--font-mono);
            font-size: 14px;
        }
    </style>
</head>
<body class="selection:bg-teal-600 selection:text-white">

    <Header lang="es" />

    <main class="pt-28 pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- HERO SECTION -->
            <div class="hero-cross p-8 sm:p-14 mb-16 text-center relative overflow-hidden shadow-xs">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-slate-200 text-xs font-mono font-bold text-slate-700 mb-6 shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>MOTOR DE COMPETENCIAS CRUZADAS · OPS v0.9.6</span>
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
                    El fin de la pesadilla burocrática docente: <br class="hidden sm:inline" />
                    <span class="text-teal-700">Competencias Cruzadas</span> y <span class="text-blue-700">Auditorías Shadow</span>.
                </h1>

                <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed mb-8">
                    La legislación educativa internacional exige evaluar por competencias específicas y transversales, transformando la labor docente en horas de burocracia manual. ColabEdu asigna de forma autónoma rúbricas y descriptores de competencias a cualquier ejercicio o examen mediante contexto cerrado normativo, permitiendo diagnósticos masivos en segundo plano sin interrumpir la vida del aula.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="#como-funciona" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-sm transition-all shadow-md flex items-center gap-2">
                        <i class="fas fa-microchip text-teal-400"></i>
                        <span>Cómo Funciona la Asignación</span>
                    </a>
                    <a href="#shadow-audits" class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-extrabold text-sm transition-all shadow-2xs flex items-center gap-2">
                        <i class="fas fa-ghost text-indigo-600"></i>
                        <span>Auditorías Shadow para Distritos</span>
                    </a>
                </div>

                <!-- Live Indicator Stats Bar -->
                <div class="mt-10 pt-8 border-t border-slate-200/80 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-slate-900 font-mono">-85%</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Tiempo en Actas y Tablas</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-teal-700 font-mono">3 Niveles</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Europeo · Nacional · Global</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-blue-700 font-mono">0 Alucinaciones</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Specs L0 en BD Vectorial</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-indigo-700 font-mono">&lt; $0.0004</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Coste Inferencia por Alumno</div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 1: EL PROBLEMA REAL DEL DOCENTE -->
            <div class="precision-card p-8 sm:p-12 mb-16 bg-white border-slate-300">
                <div class="max-w-3xl mb-8">
                    <span class="text-xs font-mono font-bold text-red-600 uppercase tracking-widest block mb-2">
                        La Fricción Estructural
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
                        La pesadilla de las tablas de competencias: 4 a 6 horas perdidas cada semana.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
                        Con la implantación de la <strong>LOMLOE</strong> en España, los estándares <strong>Common Core</strong> y <strong>Texas TEKS</strong> en EE.UU., y el marco competencial de la <strong>Unión Europea</strong>, los profesores ya no solo corrigen si una respuesta es correcta: deben justificar cada décima cruzando múltiples códigos alfanuméricos.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-table"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Burocracia Manual Asfixiante</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Mapear a mano cada pregunta de un examen con criterios oficiales (ej. <em>CCL1, STEM2, CPSAA4</em>) y rellenar hojas de cálculo interminables que restan tiempo a la preparación pedagógica y la atención al alumno.
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-clone"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Doble Registro Obligatorio</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            El docente debe mantener dos sistemas en paralelo: el boletín de calificaciones de su materia y el volcado en las plataformas administrativas autonómicas o distritales (<em>Séneca, Raíces, Aules, Canvas, Moodle</em>).
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-eye-slash"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Evaluaciones Subjetivas "A Bulto"</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Al no disponer de herramientas que midan la competencia viva en cada tarea cotidiana, la evaluación competencial termina convirtiéndose en una estimación apresurada y subjetiva al final del trimestre.
                        </p>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: LA MATRIZ DE ESTÁNDARES: EUROPEOS, NACIONALES Y GLOBALES -->
            <div class="mb-16">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="text-xs font-mono font-bold text-teal-700 uppercase tracking-widest block mb-2">
                        Armonización Multidimensional
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                        Una sola tarea, tres marcos normativos sincronizados en tiempo real.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
                        ColabEdu desacopla el contenido de la tarea de los marcos regulatorios. Un alumno realiza un comentario crítico o resuelve un reto en el aula, y el motor proyecta su maestría simultáneamente sobre tres ejes autorizados:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Marco 1: Europeo & Transversal -->
                    <div class="precision-card p-6 sm:p-8 border-teal-200 bg-gradient-to-b from-white to-teal-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-teal-100 text-teal-800 text-[10px] font-mono font-bold uppercase">
                                    Nivel 1 · Unión Europea
                                </span>
                                <span class="text-xl">🇪🇺</span>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">Estándares Europeos & Transversales</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Marcos armonizados del Consejo de Europa para el aprendizaje a lo largo de la vida y la ciudadanía digital activa:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>EU Key Competences 2018:</strong> Las 8 competencias clave europeas para el aprendizaje permanente.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>MCER / CEFR (A1 a C2):</strong> Marco Común Europeo de Referencia para las Lenguas (producción oral y escrita).</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>DigComp 2.2:</strong> Marco europeo de competencia digital y alfabetización crítica informacional.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>EntreComp:</strong> Capacidad de iniciativa, creatividad y resolución de problemas abiertos.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-teal-100 text-[11px] font-mono text-teal-700">
                            Reconocimiento transfronterizo europeo
                        </div>
                    </div>

                    <!-- Marco 2: Nacional & Autonómico -->
                    <div class="precision-card p-6 sm:p-8 border-blue-200 bg-gradient-to-b from-white to-blue-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-blue-100 text-blue-800 text-[10px] font-mono font-bold uppercase">
                                    Nivel 2 · Nacional & Estado
                                </span>
                                <div class="flex items-center gap-1 text-base">
                                    <span>🇪🇸</span>
                                    <span>🇺🇸</span>
                                    <span>🇲🇽</span>
                                </div>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">Estándares Nacionales & Regionales</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Alineación legal estricta (Grounding L0) con los decretos oficiales vigentes y pruebas de acceso universitario:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>España · LOMLOE:</strong> RD 217/2022 (ESO) y RD 243/2022 (Bachillerato). Descriptores operativos (CCL, CP, STEM, CD, CPSAA, CC, CE, CCEC).</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>España · EBAU / PAU:</strong> Criterios de corrección armonizados de selectividad para las 17 Comunidades Autónomas.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>EE.UU. · Common Core & TEKS:</strong> CCSS ELA/Math, Texas TEKS/STAAR y California CDE (State Seal of Biliteracy).</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>México · SEP NEM:</strong> Fases 5 y 6 de la Nueva Escuela Mexicana y campos formativos integrados.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-blue-100 text-[11px] font-mono text-blue-700">
                            100% trazabilidad legal en actas oficiales
                        </div>
                    </div>

                    <!-- Marco 3: Global & Evaluaciones Internacionales -->
                    <div class="precision-card p-6 sm:p-8 border-indigo-200 bg-gradient-to-b from-white to-indigo-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-indigo-100 text-indigo-800 text-[10px] font-mono font-bold uppercase">
                                    Nivel 3 · Global & OCDE
                                </span>
                                <span class="text-xl">🌐</span>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">Estándares Globales & PISA</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Homologación con las métricas psicométricas y certificaciones de mayor reconocimiento internacional:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>PISA de la OCDE (Niveles 1 al 6):</strong> Acceso y recuperación de información, integración e interpretación, y reflexión crítica.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>Bachillerato Internacional (IB DP):</strong> Criterios A, B, C y D en programas bilingües y de ciencias.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>AP College Board:</strong> Rúbricas analíticas oficiales de Advanced Placement.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>OECD Learning Compass 2030:</strong> Agencialidad del estudiante, pensamiento anticipatorio y metacognición.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-indigo-100 text-[11px] font-mono text-indigo-700">
                            Comparabilidad internacional inmediata
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: CÓMO FUNCIONA EL ALGORITMO (ZERO ALUCINACIONES) -->
            <div id="como-funciona" class="precision-card-dark p-8 sm:p-12 mb-16 rounded-3xl shadow-xl scroll-mt-24">
                <div class="max-w-3xl mb-10">
                    <span class="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest block mb-2">
                        Arquitectura de Contexto Cerrado
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
                        Cómo asignamos rúbricas y competencias a cualquier ejercicio en 3 segundos.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
                        El motor de ColabEdu <strong class="text-white">jamás alucina</strong> criterios pedagógicos. Funciona exactamente igual que un <strong class="text-white">tribunal de oposiciones o un inspector educativo</strong> que aplica el Boletín Oficial del Estado sobre la producción real del aula.
                    </p>
                </div>

                <!-- 4 Pasos del Algoritmo -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-teal-500/20 text-teal-300 border border-teal-500/40 mb-4">1</div>
                            <h4 class="font-bold text-white text-sm mb-2">Enunciado en Bruto</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                El profesor escribe una pregunta, dicta un ejercicio, sube un PDF o importa una tarea desde Moodle. Sin metadatos ni etiquetas previas.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-teal-400 font-bold">
                            Input libre del docente
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-blue-500/20 text-blue-300 border border-blue-500/40 mb-4">2</div>
                            <h4 class="font-bold text-white text-sm mb-2">Filtrado RAG Cerrado</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                El backend consulta en la BD vectorial (<code class="text-blue-300 font-bold">spec_definitions</code>) el catálogo oficial de rúbricas (C0) para la materia y nivel. Cero inventiva.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-blue-400 font-bold">
                            Espacio normativo cerrado
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 mb-4">3</div>
                            <h4 class="font-bold text-white text-sm mb-2">Inferencia Psicométrica</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                El motor LLM analiza el nivel cognitivo (Taxonomía de Bloom) y calcula el <code class="text-indigo-300 font-bold">relevanceScore</code> para cada criterio oficial de la base de datos.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-indigo-400 font-bold">
                            Activación nuclear ≥ 0.85
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 mb-4">4</div>
                            <h4 class="font-bold text-white text-sm mb-2">Rúbrica & Códigos Listos</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                El ejercicio queda pre-configurado con sus descriptores oficiales (CCL, STEM, PISA L4), baremo analítico y justificación pedagógica en 2 a 3 segundos.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-emerald-400 font-bold">
                            Listo para preevaluar
                        </div>
                    </div>
                </div>

                <!-- Bloque de código / Visual de asignación -->
                <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 font-mono text-xs">
                    <div class="flex items-center justify-between text-slate-400 text-[11px] mb-3 pb-2 border-b border-slate-800">
                        <span>EJEMPLO EN TIEMPO REAL: RUBRIC_MATCHER_RESPONSE</span>
                        <span class="text-emerald-400 font-bold">overallConfidence: 0.94 (94%)</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-300 text-[11px]">
                        <div>
                            <span class="text-amber-400 block mb-1 font-bold">Enunciado Analizado:</span>
                            <p class="italic text-slate-400 bg-slate-900/80 p-2.5 rounded border border-slate-800">
                                "Analiza el fragmento de La casa de Bernarda Alba y razona qué simbolizan el bastón de Bernarda y el calor sofocante en el drama."
                            </p>
                        </div>
                        <div class="space-y-1">
                            <div><span class="text-teal-400 font-bold">Criterio Nuclear (0.95):</span> Criterio 9 · Teatro Español del Siglo XX</div>
                            <div><span class="text-teal-400 font-bold">Criterio Soporte (0.80):</span> Criterio 10 · Análisis de Simbología Literaria</div>
                            <div><span class="text-blue-400 font-bold">Competencias LOMLOE:</span> CCL1 (Comunicación), CCEC2 (Expresión Cultural)</div>
                            <div><span class="text-indigo-400 font-bold">Nivel PISA:</span> Nivel 5 (Reflexión crítica e interpretación profunda)</div>
                            <div><span class="text-slate-500 font-bold">Criterios Descartados:</span> Sintaxis de la oración (0.00), Comprensión oral (0.00)</div>
                        </div>
                    </div>
