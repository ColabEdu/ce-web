---
// src/components/GoogleSlides.astro
export interface Props {
  src: string;
  height?: string;
}

const {
  src,
  height = '400px'
} = Astro.props;
---

<div class="slides-container" style={`height: ${height};`}>
  <iframe 
    src={src}
    frameborder="0" 
    width="100%" 
    height="100%" 
    allowfullscreen="true">
  </iframe>
</div>

<style>
  .slides-container {
    margin: 2rem 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
</style>
