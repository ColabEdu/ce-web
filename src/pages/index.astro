---
import Layout from '../layouts/Layout.astro';
import { CheckCircle2, Brain, ShieldCheck, Clock, Sparkles, ArrowRight, School, Globe2, MessageSquare } from 'lucide-react';
---

<Layout title="ColabEdu | The AI Partner for Mastery Learning">
	<!-- NAVIGATION -->
	<nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between h-16 items-center">
				<div class="flex-shrink-0 flex items-center gap-2">
					<div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold">C</div>
					<span class="font-bold text-xl tracking-tight text-slate-900">ColabEdu</span>
				</div>
				<div class="hidden md:flex space-x-8">
					<a href="#features" class="text-slate-600 hover:text-indigo-600 transition-colors text-sm font-medium">Capabilities</a>
					<a href="#pedagogy" class="text-slate-600 hover:text-indigo-600 transition-colors text-sm font-medium">Pedagogy</a>
					<a href="#pricing" class="text-slate-600 hover:text-indigo-600 transition-colors text-sm font-medium">Pricing</a>
					<a href="#enterprise" class="text-slate-600 hover:text-indigo-600 transition-colors text-sm font-medium">Districts</a>
				</div>
				<div class="flex items-center gap-4">
					<a href="#" class="hidden md:block text-slate-600 hover:text-indigo-600 text-sm font-medium">Log in</a>
					<a href="#pricing" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all shadow-lg shadow-indigo-600/20">
						Get Started
					</a>
				</div>
			</div>
		</div>
	</nav>

	<main>
		<!-- HERO SECTION -->
		<section class="pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold tracking-wide uppercase mb-6 border border-indigo-100">
					<Sparkles size={14} />
					<span>The Conversational-First EdTech Platform</span>
				</div>
				<h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-900 mb-8">
					Your AI <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">General Contractor</span> for Education.
				</h1>
				<p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
					Stop fighting AI. Start partnering with it. ColabEdu transforms grading from hours to minutes, restores academic integrity through mastery pathways, and acts as a Socratic tutor for every student.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-4">
					<a href="#pricing" class="inline-flex justify-center items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1">
						Try for Free
						<ArrowRight size={20} />
					</a>
					<a href="#enterprise" class="inline-flex justify-center items-center gap-2 bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 px-8 py-4 rounded-xl text-lg font-semibold transition-all">
						Book District Demo
					</a>
				</div>
				
				<!-- Trust Badges -->
				<div class="mt-16 pt-8 border-t border-slate-100">
					<p class="text-sm text-slate-500 font-medium mb-6">SEAMLESSLY INTEGRATED WITH</p>
					<div class="flex justify-center gap-8 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
						<!-- Replace with actual SVGs -->
						<div class="flex items-center gap-2 font-bold text-xl"><Globe2 className="w-6 h-6" /> Canvas LMS</div>
						<div class="flex items-center gap-2 font-bold text-xl"><School className="w-6 h-6" /> Google Classroom</div>
						<div class="flex items-center gap-2 font-bold text-xl"><Brain className="w-6 h-6" /> Microsoft Teams</div>
					</div>
				</div>
			</div>
		</section>

		<!-- VALUE PROP / ARCHITECTURE -->
		<section id="features" class="py-20 bg-slate-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center max-w-3xl mx-auto mb-16">
					<h2 class="text-3xl font-bold text-slate-900 mb-4">The "Feature Factory" Engine</h2>
					<p class="text-lg text-slate-600">
						Built on a sophisticated "General Contractor" architecture. You state the goal, the AI orchestrates the specialized tools to get it done.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Feature 1 -->
					<div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
						<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 mb-6">
							<Clock size={24} />
						</div>
						<h3 class="text-xl font-bold text-slate-900 mb-3">Assessment & Grading</h3>
						<p class="text-slate-600">
							Upload 100 essays or audio recordings. The AI pre-evaluates them against your specific rubric, catching grammar errors and plot inconsistencies instantly. You review, personalize, and approve.
						</p>
					</div>

					<!-- Feature 2 -->
					<div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
						<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600 mb-6">
							<MessageSquare size={24} />
						</div>
						<h3 class="text-xl font-bold text-slate-900 mb-3">Conversational CMS</h3>
						<p class="text-slate-600">
							No more clunky forms. Just say, "Turn this PDF syllabus into a 10-question quiz and a study guide," and watch the content generate automatically.
						</p>
					</div>

					<!-- Feature 3 -->
					<div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
						<div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center text-teal-600 mb-6">
							<Brain size={24} />
						</div>
						<h3 class="text-xl font-bold text-slate-900 mb-3">Targeted Remediation</h3>
						<p class="text-slate-600">
							The system tracks student misconceptions in real-time. Identify a gap, and the AI instantly generates personalized reinforcement exercises for just those students.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- PEDAGOGY / DIFFERENTIATOR -->
		<section id="pedagogy" class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
					<div>
						<div class="inline-block px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold mb-6">
							ACADEMIC INTEGRITY SOLVED
						</div>
						<h2 class="text-4xl font-bold text-slate-900 mb-6">The Three-Phase Mastery Pathway</h2>
						<p class="text-lg text-slate-600 mb-8">
							Don't ban AI. Make it a mandatory partner. Our pedagogical model ensures students can't just generate a final answer—they have to prove they learned it.
						</p>

						<div class="space-y-6">
							<div class="flex gap-4">
								<div class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold">1</div>
								<div>
									<h4 class="text-lg font-bold text-slate-900">The Gym (Guided Practice)</h4>
									<p class="text-slate-600">Low-stakes, AI-guided Socratic tutoring. The AI asks probing questions and provides hints, not answers.</p>
								</div>
							</div>
							<div class="flex gap-4">
								<div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 font-bold">2</div>
								<div>
									<h4 class="text-lg font-bold text-slate-900">Game Day (Proctored Self-Assessment)</h4>
									<p class="text-slate-600">Unassisted, timed mode. Students can request an AI "pre-evaluation" to check their work against the rubric before submitting.</p>
								</div>
							</div>
							<div class="flex gap-4">
								<div class="flex-shrink-0 w-8 h-8 rounded-full bg-red-100 flex items-center justify-center text-red-600 font-bold">3</div>
								<div>
									<h4 class="text-lg font-bold text-slate-900">The Audition (Performance)</h4>
									<p class="text-slate-600">Authentic tasks (oral reports, handwritten essays) that demonstrate true mastery, evaluated by the AI for the teacher's final review.</p>
								</div>
							</div>
						</div>
					</div>
					<div class="mt-12 lg:mt-0 relative">
						<!-- Abstract representation of the UI -->
						<div class="bg-slate-900 rounded-2xl shadow-2xl p-6 transform rotate-2 hover:rotate-0 transition-transform duration-500">
							<div class="flex items-center gap-2 mb-4 border-b border-slate-700 pb-4">
								<div class="w-3 h-3 rounded-full bg-red-500"></div>
								<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
								<div class="w-3 h-3 rounded-full bg-green-500"></div>
								<div class="ml-4 text-slate-400 text-sm font-mono">Teacher Companion AI</div>
							</div>
							<div class="space-y-4 font-mono text-sm">
								<div class="flex gap-4">
									<div class="text-indigo-400">Teacher:</div>
									<div class="text-slate-300">Create a rubric for a 5-paragraph essay on the Industrial Revolution based on this syllabus.</div>
								</div>
								<div class="flex gap-4">
									<div class="text-green-400">AI:</div>
									<div class="text-slate-300">I've analyzed the syllabus. Here is a draft rubric focusing on 'Cause and Effect' and 'Use of Evidence'. [Renders Interactive Rubric Editor]</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- PRICING SECTION -->
		<section id="pricing" class="py-20 bg-slate-900 text-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center max-w-3xl mx-auto mb-16">
					<h2 class="text-3xl font-bold mb-4">Pricing for Every Stage of Adoption</h2>
					<p class="text-slate-400 text-lg">
						From individual grading relief to full institutional transformation.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<!-- Tier 1 -->
					<div class="bg-slate-800 rounded-2xl p-8 border border-slate-700 flex flex-col">
						<div class="mb-4">
							<span class="text-slate-400 font-medium text-sm uppercase tracking-wider">Teacher Pro</span>
							<div class="mt-2 flex items-baseline gap-1">
								<span class="text-4xl font-bold text-white">$249</span>
								<span class="text-slate-400">/year</span>
							</div>
						</div>
						<p class="text-slate-400 text-sm mb-6">The essential grading assistant for the busy classroom.</p>
						<ul class="space-y-4 mb-8 flex-1">
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>Pre-evaluation: 5 assessments/mo</span>
							</li>
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>Advanced Reporting & Trends</span>
							</li>
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>5 Content Generations/mo</span>
							</li>
						</ul>
						<a href="#" class="w-full py-3 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-center font-medium transition-colors">Start Free Trial</a>
					</div>

					<!-- Tier 2 -->
					<div class="bg-indigo-600 rounded-2xl p-8 border border-indigo-500 flex flex-col relative transform md:-translate-y-4 shadow-2xl">
						<div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white text-indigo-700 px-4 py-1 rounded-full text-xs font-bold tracking-wide border border-indigo-200">
							MOST POPULAR
						</div>
						<div class="mb-4">
							<span class="text-indigo-100 font-medium text-sm uppercase tracking-wider">AI Co-Pilot</span>
							<div class="mt-2 flex items-baseline gap-1">
								<span class="text-4xl font-bold text-white">$499</span>
								<span class="text-indigo-200">/year</span>
							</div>
						</div>
						<p class="text-indigo-100 text-sm mb-6">Full automation for the power user. Plan and grade without limits.</p>
						<ul class="space-y-4 mb-8 flex-1">
							<li class="flex items-start gap-3 text-white text-sm">
								<CheckCircle2 className="text-white shrink-0" size={18} />
								<span><strong>Unlimited</strong> AI Assessment</span>
							</li>
							<li class="flex items-start gap-3 text-white text-sm">
								<CheckCircle2 className="text-white shrink-0" size={18} />
								<span><strong>Unlimited</strong> Content Gen</span>
							</li>
							<li class="flex items-start gap-3 text-white text-sm">
								<CheckCircle2 className="text-white shrink-0" size={18} />
								<span>Priority LMS Integration</span>
							</li>
							<li class="flex items-start gap-3 text-white text-sm">
								<CheckCircle2 className="text-white shrink-0" size={18} />
								<span>Syllabus-to-Course Workflows</span>
							</li>
						</ul>
						<a href="#" class="w-full py-3 rounded-lg bg-white text-indigo-600 hover:bg-indigo-50 text-center font-bold transition-colors">Get Started</a>
					</div>

					<!-- Tier 3 -->
					<div class="bg-slate-800 rounded-2xl p-8 border border-slate-700 flex flex-col">
						<div class="mb-4">
							<span class="text-slate-400 font-medium text-sm uppercase tracking-wider">Mastery Suite</span>
							<div class="mt-2 flex items-baseline gap-1">
								<span class="text-4xl font-bold text-white">$799</span>
								<span class="text-slate-400">/year</span>
							</div>
						</div>
						<p class="text-slate-400 text-sm mb-6">The complete instructional system for pioneering educators.</p>
						<ul class="space-y-4 mb-8 flex-1">
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>All Co-Pilot Features</span>
							</li>
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span><strong>200 Guided Learning Credits</strong></span>
							</li>
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>Interactive Socratic Tutor</span>
							</li>
							<li class="flex items-start gap-3 text-slate-300 text-sm">
								<CheckCircle2 className="text-indigo-400 shrink-0" size={18} />
								<span>Proctored "Game Day" Mode</span>
							</li>
						</ul>
						<a href="#" class="w-full py-3 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-center font-medium transition-colors">Contact Sales</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ENTERPRISE / DISTRICTS -->
		<section id="enterprise" class="py-20 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="bg-indigo-50 rounded-3xl p-12 lg:flex items-center justify-between border border-indigo-100">
					<div class="max-w-2xl">
						<h2 class="text-3xl font-bold text-slate-900 mb-4">Standardization & Equity for Districts</h2>
						<p class="text-slate-600 text-lg mb-6">
							Empower your teachers with a consistent evaluation engine. Aggregate data on learning gaps across schools in real-time. Compliant with SOPIPA, FERPA, and data privacy standards.
						</p>
						<div class="flex flex-wrap gap-4 text-sm font-semibold text-indigo-800">
							<span class="flex items-center gap-1"><ShieldCheck size={16} /> Enterprise Security</span>
							<span class="flex items-center gap-1"><Globe2 size={16} /> Multilingual Support</span>
							<span class="flex items-center gap-1"><CheckCircle2 size={16} /> Single Sign-On</span>
						</div>
					</div>
					<div class="mt-8 lg:mt-0">
						<a href="#" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all shadow-lg">
							Request Institutional Quote
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<footer class="bg-slate-900 border-t border-slate-800 py-12 text-slate-400 text-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-8">
				<div>
					<h4 class="text-white font-bold mb-4">Product</h4>
					<ul class="space-y-2">
						<li><a href="#" class="hover:text-white transition-colors">Assessment Engine</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Content Gen</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Guided Learning</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-bold mb-4">Company</h4>
					<ul class="space-y-2">
						<li><a href="#" class="hover:text-white transition-colors">About Us</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Pedagogy</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Careers</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-bold mb-4">Resources</h4>
					<ul class="space-y-2">
						<li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Teacher Community</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Help Center</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-bold mb-4">Legal</h4>
					<ul class="space-y-2">
						<li><a href="#" class="hover:text-white transition-colors">Privacy Policy (SOPIPA)</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
						<li><a href="#" class="hover:text-white transition-colors">DPA</a></li>
					</ul>
				</div>
			</div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-slate-800 text-center">
				<p>&copy; 2025 ColabEdu Inc. All rights reserved.</p>
			</div>
		</footer>
	</main>
</Layout>