{
  "name": "colabedu-web-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev:all": "pnpm -r --parallel dev",
    "dev:org": "pnpm --filter colabedu-org dev",
    "dev:ai": "pnpm --filter colabedu-ai dev",
    "dev:support": "pnpm --filter colabedu-support dev",
    "dev:net": "pnpm --filter colabedu-net dev"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}