                                return (
                                    <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 transition-colors group/item">
                                        <div class="flex items-center gap-2">
                                            <span class="text-base leading-none">{j.flag}</span>
                                            <div>
                                                <div class="text-xs font-bold text-slate-800 leading-tight">
                                                    {j.nativeName}
                                                </div>
                                                <div class="text-[10px] text-slate-500 font-mono truncate max-w-[150px]">
                                                    {j.primaryFramework.split('(')[0]}
