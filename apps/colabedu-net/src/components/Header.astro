                                            </div>
                                        </div>
                                        <a
                                            href={catalogCountryUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-[10px] font-bold px-2 py-1 rounded-md bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition-colors flex items-center gap-1"
                                            title={`${isEn ? 'Open Catalog for' : 'Abrir Catálogo'} ${j.name}`}
                                        >
                                            <span>OER</span>
                                            <i class="fas fa-arrow-up-right-from-square text-[8px] opacity-70"></i>
                                        </a>
                                    </div>
                                );
                            })}
                        </div>

                        <div class="border-t border-slate-100 pt-2">
                            <div class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-2 py-1 mb-1">
                                {isEn ? "Interface Language" : "Idioma de la Web"}
                            </div>
                            <div class="grid grid-cols-2 gap-1.5 px-1">
                                <a
                                    href="/es/"
                                    class={lang === 'es' ? 'flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg bg-blue-50 text-blue-700 font-bold text-xs border border-blue-200' : 'flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors'}
                                >
                                    <span>🇪🇸</span>
                                    <span>Español</span>
                                </a>
                                <a
                                    href="/en/"
                                    class={lang === 'en' ? 'flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg bg-blue-50 text-blue-700 font-bold text-xs border border-blue-200' : 'flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors'}
                                >
                                    <span>🇺🇸</span>
                                    <span>English</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Support / Help ? Button (In-Situ AI Companion & Tickets) -->
                <button
                    type="button"
                    data-open-support-modal
                    data-support-lang={lang}
                    class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-teal-50 text-slate-700 hover:text-teal-700 border border-slate-200 hover:border-teal-300 flex items-center justify-center transition-all shadow-xs cursor-pointer"
                    title={isEn ? "Open AI Support Companion & Tickets" : "Abrir Asistente de Soporte & Consultas"}
                    aria-label="Soporte y Ayuda"
                >
                    <i class="fas fa-question text-sm font-bold"></i>
                </button>

                <a href={appUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold text-white bg-slate-900 hover:bg-blue-600 rounded-xl transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5">
                    <span>{t.enterApp}</span>
                    <i class="fas fa-arrow-up-right-from-square text-xs opacity-75"></i>
                </a>
            </div>
