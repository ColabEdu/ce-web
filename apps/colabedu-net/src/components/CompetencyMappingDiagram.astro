---
// src/components/CompetencyMappingDiagram.astro
// Diagrama interactivo de Proyección Competencial Determinista (España LOMLOE 3 Saltos vs. California WLS 2019 Longitudinal)
interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const isEs = lang === "es";

const copy = isEs
  ? {
      badge: "MOTOR DETERMINISTA DE PROYECCIÓN · OPS v0.9.11",
      title: "De la evidencia en rúbrica al descriptor oficial: cero alucinación aritmética.",
      subtitle:
        "El motor LLM nunca calcula notas ni inventa porcentajes competenciales: solo puntúa cada fila de la rúbrica C0 y extrae citas literales verificables. El motor matemático determinista proyecta las competencias en menos de 5 ms.",
      tabSpain: "🇪🇸 España · LOMLOE & PAU (3 Saltos + Anti-Arrastre)",
      tabCalifornia: "🇺🇸 California · CA WLS 2019 & ACTFL (Rigor Longitudinal)",
      phaseALabel: "FASE 1 · MOTOR LLM (SOLO EVIDENCIA)",
      phaseBLabel: "FASE 2 · MOTOR DETERMINISTA (< 5 ms · CERO ALUCINACIÓN)",
      // Spain
      spainInputTitle: "Redacción Manuscrita / Exposición Oral",
      spainInputBody: "Puntúa fila de rúbrica C0 (ej. 8.0/10) + extrae cita literal verificada.",
      spainHop1Title: "1. Rúbrica C0 (L0)",
      spainHop1Body: "Criterio 4.1 · Comprensión e interpretación textual.",
      spainHop2Title: "2. Criterio BOE",
      spainHop2Body: "RD 217/2022 · RD 243/2022 · RD 534/2024 (PAU).",
      spainHop3Title: "3. Competencia & Descriptores",
      spainHop3Body: "CE4 → CCL2, CCL3, CCL5, CPSAA4, CC3 (escala 0–4.0).",
      spainGuardTitle: "Prevención del «Efecto Arrastre» (Competency Bleed)",
      spainGuardBody:
        "Acotación por criterio de evaluación: una prueba oral o redacción en papel jamás arrastra falsos descriptores STEM ni digitales (CD1..CD4), que quedan reservados a tareas de investigación digital.",
      // California
      caInputTitle: "Entrega Spanish Heritage (Audio / Escrito)",
      caInputBody: "Puntúa fila de rúbrica C0 (ej. 8.0/10) + evidencia literal del alumno.",
      caHop1Title: "1. Rúbrica C0 (CDE)",
      caHop1Body: "Criterio «Comprensión de la Leyenda» (peso 50%).",
      caHop2Title: "2. Taxonomía CA WLS 2019",
      caHop2Body: "WL.CM1.I · Interpretive Communication (Intermediate).",
      caHop3Title: "3. Proyección + Overrides",
      caHop3Body: "3.20 / 4.0 · Modulación docente por aula sin duplicar YAML.",
      caGuardTitle: "Protección de Escala Longitudinal (TASK_EVIDENCE_ONLY)",
      caGuardBody:
        "Cumple la doctrina psicométrica de CDE y ACTFL: impide reclamar un nivel longitudinal oficial (p. ej. Intermediate Mid) por un ejercicio aislado, etiquetándolo como «Evidencia de Tarea (Escala longitudinal multi-tarea)».",
      // Authority bar
      authTitle: "Etiquetado Obligatorio de Autoridad Normativa",
      authNormative: "Vínculo directo verificado en decreto oficial L0 (BOE, CDE, College Board, IB).",
      authTerminological: "Equivalencia terminológica oficial entre marcos curriculares.",
      authInterpretive: "Crosswalk transversal de 2 saltos; suprime citas literales para no atribuirlas a marcos indirectos.",
    }
  : {
      badge: "DETERMINISTIC PROJECTION ENGINE · OPS v0.9.11",
      title: "From rubric evidence to official descriptors: zero arithmetic hallucination.",
      subtitle:
        "The LLM engine never invents grades or competency percentages: it only scores each C0 rubric row and extracts verifiable literal quotes. Our deterministic math engine projects competencies in under 5 ms.",
      tabSpain: "🇪🇸 Spain · LOMLOE & PAU (3-Hop + Anti-Bleed)",
      tabCalifornia: "🇺🇸 California · CA WLS 2019 & ACTFL (Longitudinal Guardrail)",
      phaseALabel: "PHASE 1 · LLM ENGINE (EVIDENCE ONLY)",
      phaseBLabel: "PHASE 2 · DETERMINISTIC MATH ENGINE (< 5 ms · ZERO HALLUCINATION)",
      // Spain
      spainInputTitle: "Handwritten Essay / Oral Presentation",
      spainInputBody: "Scores C0 rubric row (e.g., 8.0/10) + extracts verified literal quote.",
      spainHop1Title: "1. C0 Rubric (L0)",
      spainHop1Body: "Criterion 4.1 · Textual comprehension & interpretation.",
      spainHop2Title: "2. Official Decree",
      spainHop2Body: "BOE RD 217/2022 · RD 243/2022 · RD 534/2024 (PAU).",
      spainHop3Title: "3. Competency & Descriptors",
      spainHop3Body: "CE4 → CCL2, CCL3, CCL5, CPSAA4, CC3 (0–4.0 scale).",
      spainGuardTitle: "«Competency Bleed» Prevention",
      spainGuardBody:
        "Criterion-level scoping: a paper essay or oral exam never bleeds spurious STEM or Digital (CD1..CD4) descriptors, which remain strictly scoped to digital research tasks.",
      // California
      caInputTitle: "Spanish Heritage Submission (Audio / Written)",
      caInputBody: "Scores C0 rubric row (e.g., 8.0/10) + verified student evidence.",
      caHop1Title: "1. C0 Rubric (CDE)",
      caHop1Body: "Criterion «Story Comprehension» (50% weight).",
      caHop2Title: "2. CA WLS 2019 Taxonomy",
      caHop2Body: "WL.CM1.I · Interpretive Communication (Intermediate).",
      caHop3Title: "3. Projection + Overrides",
      caHop3Body: "3.20 / 4.0 · Classroom-level weight tuning with zero YAML sprawl.",
      caGuardTitle: "Longitudinal Scale Guardrail (TASK_EVIDENCE_ONLY)",
      caGuardBody:
        "Enforces CDE & ACTFL psychometric doctrine: blocks claiming an official longitudinal proficiency level (e.g., Intermediate Mid) from a single task, labeling it «Task Evidence (Multi-task longitudinal scale)».",
      // Authority bar
      authTitle: "Mandatory Normative Authority Labeling",
      authNormative: "Direct link verified against official L0 decree (BOE, CDE, College Board, IB).",
      authTerminological: "Official terminological equivalence across curriculum frameworks.",
      authInterpretive: "2-hop transversal crosswalk; suppresses literal quotes to avoid misattribution.",
    };
---

<div class="precision-card p-6 sm:p-10 mb-16 bg-white border-slate-300" data-competency-diagram>
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-[11px] font-mono font-bold text-teal-800 uppercase tracking-wider mb-3">
        <i class="fas fa-diagram-project"></i>
        <span>{copy.badge}</span>
      </span>
      <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        {copy.title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
        {copy.subtitle}
      </p>
    </div>

    <!-- Interactive Region Switcher -->
    <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200 shrink-0 self-start lg:self-end" role="tablist">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-tab-target="spain"
        class="comp-tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all bg-white text-slate-900 shadow-xs border border-slate-200 cursor-pointer"
      >
        {copy.tabSpain}
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-tab-target="california"
        class="comp-tab-btn px-3.5 py-2 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 border border-transparent cursor-pointer"
      >
        {copy.tabCalifornia}
      </button>
    </div>
  </div>

  <!-- PANEL 1: SPAIN LOMLOE -->
  <div data-tab-panel="spain" class="space-y-5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
      <!-- Phase 1: LLM Evidence -->
      <div class="lg:col-span-3 p-4 rounded-2xl bg-slate-900 text-white border border-slate-800 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-wider block mb-2">
            {copy.phaseALabel}
          </span>
          <div class="font-bold text-sm mb-1.5 flex items-center gap-2">
            <i class="fas fa-quote-left text-teal-400 text-xs"></i>
            <span>{copy.spainInputTitle}</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{copy.spainInputBody}</p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-800 font-mono text-[10px] text-emerald-400">
          score: 8.0/10 · evidenceQuote ✓
        </div>
      </div>

      <!-- Connector Arrow -->
      <div class="hidden lg:flex lg:col-span-1 items-center justify-center text-slate-400">
        <i class="fas fa-arrow-right text-lg"></i>
      </div>

      <!-- Phase 2: Deterministic 3-Hop -->
      <div class="lg:col-span-8 p-4 rounded-2xl bg-gradient-to-br from-teal-50/70 via-white to-blue-50/70 border border-teal-200">
        <span class="text-[10px] font-mono font-bold text-teal-800 uppercase tracking-wider block mb-3">
          {copy.phaseBLabel}
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-blue-700 mb-1">{copy.spainHop1Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.spainHop1Body}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-indigo-700 mb-1">{copy.spainHop2Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.spainHop2Body}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-teal-300 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-teal-700 mb-1">{copy.spainHop3Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.spainHop3Body}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Anti-Bleed Guardrail Callout -->
    <div class="p-4 rounded-xl bg-emerald-50/80 border border-emerald-200 flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5">
        <i class="fas fa-filter text-xs"></i>
      </div>
      <div>
        <div class="text-xs font-black text-emerald-950">{copy.spainGuardTitle}</div>
        <p class="text-xs text-emerald-900 mt-0.5 leading-relaxed">{copy.spainGuardBody}</p>
      </div>
    </div>
  </div>

  <!-- PANEL 2: CALIFORNIA WLS 2019 -->
  <div data-tab-panel="california" class="space-y-5 hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
      <!-- Phase 1: LLM Evidence -->
      <div class="lg:col-span-3 p-4 rounded-2xl bg-slate-900 text-white border border-slate-800 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-wider block mb-2">
            {copy.phaseALabel}
          </span>
          <div class="font-bold text-sm mb-1.5 flex items-center gap-2">
            <i class="fas fa-microphone-lines text-teal-400 text-xs"></i>
            <span>{copy.caInputTitle}</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">{copy.caInputBody}</p>
        </div>
        <div class="mt-3 pt-2.5 border-t border-slate-800 font-mono text-[10px] text-emerald-400">
          score: 8.0/10 · evidenceQuote ✓
        </div>
      </div>

      <!-- Connector Arrow -->
      <div class="hidden lg:flex lg:col-span-1 items-center justify-center text-slate-400">
        <i class="fas fa-arrow-right text-lg"></i>
      </div>

      <!-- Phase 2: Deterministic CA WLS -->
      <div class="lg:col-span-8 p-4 rounded-2xl bg-gradient-to-br from-blue-50/70 via-white to-indigo-50/70 border border-blue-200">
        <span class="text-[10px] font-mono font-bold text-blue-800 uppercase tracking-wider block mb-3">
          {copy.phaseBLabel}
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-blue-700 mb-1">{copy.caHop1Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.caHop1Body}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-indigo-700 mb-1">{copy.caHop2Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.caHop2Body}</p>
          </div>
          <div class="p-3.5 rounded-xl bg-white border border-blue-300 shadow-2xs">
            <div class="text-[11px] font-mono font-bold text-teal-700 mb-1">{copy.caHop3Title}</div>
            <p class="text-xs text-slate-700 leading-relaxed">{copy.caHop3Body}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Longitudinal Guardrail Callout -->
    <div class="p-4 rounded-xl bg-amber-50/80 border border-amber-200 flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-amber-600 text-white flex items-center justify-center shrink-0 mt-0.5">
        <i class="fas fa-shield-halved text-xs"></i>
      </div>
      <div>
        <div class="text-xs font-black text-amber-950">{copy.caGuardTitle}</div>
        <p class="text-xs text-amber-900 mt-0.5 leading-relaxed">{copy.caGuardBody}</p>
      </div>
    </div>
  </div>

  <!-- Authority Legend -->
  <div class="mt-6 pt-5 border-t border-slate-200">
    <div class="text-[11px] font-mono font-bold text-slate-500 uppercase tracking-wider mb-3">
      {copy.authTitle}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
        <span class="inline-block px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono font-bold text-[10px] mb-1">
          NORMATIVE (L0)
        </span>
        <p class="text-slate-600 text-[11px] leading-relaxed">{copy.authNormative}</p>
      </div>
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
        <span class="inline-block px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-mono font-bold text-[10px] mb-1">
          TERMINOLOGICAL (L0)
        </span>
        <p class="text-slate-600 text-[11px] leading-relaxed">{copy.authTerminological}</p>
      </div>
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
        <span class="inline-block px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-mono font-bold text-[10px] mb-1">
          INTERPRETIVE (Crosswalk)
        </span>
        <p class="text-slate-600 text-[11px] leading-relaxed">{copy.authInterpretive}</p>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-competency-diagram]').forEach((container) => {
    const buttons = container.querySelectorAll('.comp-tab-btn');
    const panels = container.querySelectorAll('[data-tab-panel]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');
        buttons.forEach((b) => {
          const active = b.getAttribute('data-tab-target') === target;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.classList.toggle('bg-white', active);
          b.classList.toggle('text-slate-900', active);
          b.classList.toggle('shadow-xs', active);
          b.classList.toggle('border-slate-200', active);
          b.classList.toggle('text-slate-600', !active);
          b.classList.toggle('border-transparent', !active);
        });
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-tab-panel') !== target);
        });
      });
    });
  });
</script>
