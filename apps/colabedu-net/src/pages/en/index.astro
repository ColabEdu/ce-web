    <!-- Interactive Client Scripts (KaTeX & Time Calculator) -->
    <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
            // 1. KaTeX Math Render
            const mathEl = document.getElementById('pythagoras-display');
            if (mathEl && window.katex) {
                try {
                    window.katex.render("a^2 + b^2 = c^2 \\iff c = \\sqrt{a^2 + b^2}", mathEl, {
                        throwOnError: false,
                        displayMode: true
                    });
                } catch(e) {
                    console.warn("KaTeX render fallback", e);
                }
            }

            // 2. Interactive Time Savings Calculator
            const slider = document.getElementById('student-slider');
            const studentDisplay = document.getElementById('student-count-display');
            const tradHours = document.getElementById('traditional-hours');
            const colabHours = document.getElementById('colabedu-hours');
            const savedHours = document.getElementById('saved-hours');

            if (slider && studentDisplay && tradHours && colabHours && savedHours) {
                slider.addEventListener('input', (e) => {
                    const count = parseInt(e.target.value, 10);
                    studentDisplay.textContent = count + ' students';
                    
                    // Calculation: ~12 mins (0.2h) per student per week traditionally
                    const traditional = (count * 0.2).toFixed(1);
                    // ColabEdu reduces to ~0.04h (2.4 min review)
                    const colab = (count * 0.04).toFixed(1);
                    const saved = (traditional - colab).toFixed(1);

                    tradHours.textContent = traditional + ' hrs/wk';
                    colabHours.textContent = colab + ' hrs/wk';
                    savedHours.textContent = saved + ' hours every week';
                });
            }
        });
    </script>
