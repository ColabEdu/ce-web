                            <span>{isEn ? "Educational Frameworks" : "Marcos Normativos L0"}</span>
                            <span>{isEn ? "Catalogs" : "Catálogos"}</span>
                        </div>

                        <!-- Jurisdictions List with Flag & Direct Catalog Link -->
                        <div class="space-y-1 mb-2">
                            {jurisdictions.map((j) => {
