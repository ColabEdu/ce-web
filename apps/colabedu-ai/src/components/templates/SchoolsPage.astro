---
import CommercialLayout from "../../layouts/CommercialLayout.astro";
import { ui, defaultLang } from "../../i18n/ui";
import { schools } from "../../i18n/schools";

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
const c = schools[lang] || schools[defaultLang];
---

<CommercialLayout title={"ColabEdu - " + t["nav.schools"]}>
    <!-- 1. Hero Section -->
    <section class="max-w-7xl mx-auto py-20 px-4 lg:px-8 mt-20">
        <h2
            class="text-5xl lg:text-7xl font-extrabold text-slate-900 tracking-tighter mb-8 leading-none"
        >
            {c["hero.title"]}
            <br />
            <span class="text-indigo-600 italic text-6xl"
                >{c["hero.subtitle"]}</span
            >
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl leading-relaxed">
            {c["hero.desc"]}
        </p>
    </section>

    <!-- 2. Consistency Radar Chart -->
    <section class="py-20 bg-slate-50 border-y border-slate-200">
        <div
            class="max-w-7xl mx-auto px-4 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
        >
            <div
                class="bg-white p-10 rounded-[3rem] shadow-xl border border-slate-100"
            >
                <h3
                    class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-10"
                >
                    {c["radar.title"]}
                </h3>
                <div class="relative w-full h-[350px]">
                    <canvas id="schoolRadarChart"></canvas>
                </div>
            </div>
            <div>
                <h2 class="text-3xl font-bold mb-6 text-slate-900">
                    {c["radar.impact.title"]}
                </h2>
                <p class="text-slate-600 mb-8 leading-relaxed">
                    {c["radar.impact.desc1"]}
                </p>
                <p class="text-slate-600 leading-relaxed">
                    {c["radar.impact.desc2"]}
                </p>
            </div>
        </div>
    </section>

    <!-- 3. LTI 1.3 Integration -->
    <section class="py-24 max-w-7xl mx-auto px-4 lg:px-8">
        <div
            class="bg-indigo-600 p-12 rounded-[3.5rem] text-white flex flex-col lg:flex-row justify-between items-center gap-12"
        >
            <div class="max-w-xl">
                <h3 class="text-3xl font-bold mb-4">
                    {c["lti.title"]}
                </h3>
                <p class="opacity-90 leading-relaxed">
                    {c["lti.desc"]}
                </p>
            </div>
            <div
                class="bg-white/10 p-8 rounded-3xl border border-white/20 text-center backdrop-blur-sm"
            >
                <div class="text-4xl mb-4">🛡️</div>
                <p class="text-xs font-bold uppercase tracking-widest">
                    {c["lti.security"]}
                </p>
                <p class="text-[10px] mt-2 opacity-70">{c["lti.audit"]}</p>
            </div>
        </div>
    </section>

    <!-- 4. Dashboard Admin -->
    <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 lg:px-8 text-center">
            <h3 class="text-2xl font-bold mb-12 text-slate-900">
                {c["dashboard.title"]}
            </h3>
            <p class="text-slate-500 mb-16 text-sm max-w-2xl mx-auto">
                {c["dashboard.desc"]}
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div
                    class="p-8 bg-slate-50 rounded-3xl border border-slate-100 hover:shadow-lg transition-shadow"
                >
                    <div class="text-3xl mb-4">📊</div>
                    <h4 class="font-bold text-slate-900 mb-2">
                        {c["dashboard.card1.title"]}
                    </h4>
                    <p class="text-xs text-slate-500">
                        {c["dashboard.card1.desc"]}
                    </p>
                </div>
                <div
                    class="p-8 bg-slate-50 rounded-3xl border border-slate-100 hover:shadow-lg transition-shadow"
                >
                    <div class="text-3xl mb-4">⚠️</div>
                    <h4 class="font-bold text-slate-900 mb-2">
                        {c["dashboard.card2.title"]}
                    </h4>
                    <p class="text-xs text-slate-500">
                        {c["dashboard.card2.desc"]}
                    </p>
                </div>
                <div
                    class="p-8 bg-slate-50 rounded-3xl border border-slate-100 hover:shadow-lg transition-shadow"
                >
                    <div class="text-3xl mb-4">⚖️</div>
                    <h4 class="font-bold text-slate-900 mb-2">
                        {c["dashboard.card3.title"]}
                    </h4>
                    <p class="text-xs text-slate-500">
                        {c["dashboard.card3.desc"]}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Testimonial -->
    <section
        class="py-20 bg-slate-50 italic text-slate-500 text-center text-lg border-y border-slate-200"
    >
        <div class="max-w-4xl mx-auto px-4">
            {c["testimonial.text"]}
        </div>
    </section>

    <!-- 6. CTA -->
    <section class="py-32 text-center bg-slate-900 text-white">
        <h2 class="text-4xl font-bold mb-8 text-white">
            {c["cta.title"]}
        </h2>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
            <button
                class="px-12 py-5 bg-indigo-600 text-white rounded-full font-bold shadow-2xl hover:bg-indigo-700 transition-all"
            >
                {c["cta.button"]}
            </button>
        </div>
    </section>

    <script
        define:vars={{
            labels: c["chart.labels"],
            dataset1: c["chart.dataset1"],
            dataset2: c["chart.dataset2"],
        }}
    >
        import Chart from "chart.js/auto";

        document.addEventListener("DOMContentLoaded", () => {
            const ctx = document.getElementById("schoolRadarChart");
            if (ctx) {
                new Chart(ctx, {
                    type: "radar",
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: dataset1,
                                data: [65, 50, 75, 40, 60],
                                borderColor: "#F43F5E", // Red for inconsistency
                                backgroundColor: "rgba(244, 63, 94, 0.1)",
                                borderWidth: 2,
                            },
                            {
                                label: dataset2,
                                data: [98, 97, 99, 95, 98],
                                borderColor: "#10B981", // Green for consistency
                                backgroundColor: "rgba(16, 185, 129, 0.1)",
                                borderWidth: 2,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                angleLines: {
                                    display: true,
                                    color: "rgba(0,0,0,0.1)",
                                },
                                suggestedMin: 0,
                                suggestedMax: 100,
                                grid: {
                                    color: "rgba(0,0,0,0.05)",
                                },
                                pointLabels: {
                                    font: {
                                        size: 12,
                                        family: "'Inter', sans-serif",
                                    },
                                },
                            },
                        },
                        plugins: {
                            legend: {
                                position: "bottom",
                            },
                        },
                    },
                });
            }
        });
    </script>
</CommercialLayout>
