---
import { appLink } from '@colabedu/ui-core/navigation';

interface Props {
  lessonId: string;
  slideIndex?: number;
  slideId?: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  dataI18n?: string;
}

const {
  lessonId,
  slideIndex,
  slideId,
  text = "Resolver reto interactivo en ColabEdu (90s sin registro) →",
  size = 'md',
  fullWidth = false,
  dataI18n,
} = Astro.props;

const params: Record<string, string> = { ref: 'catalog_seo' };
if (slideIndex !== undefined) {
  params.slide = String(slideIndex);
} else if (slideId) {
  params.slide = slideId;
}

const flutterTargetUrl = appLink('app', `/lesson/${encodeURIComponent(lessonId)}`, params);

const sizeClasses = {
  sm: "px-4 py-2 text-xs font-semibold rounded-xl",
  md: "px-6 py-3.5 text-sm sm:text-base font-bold rounded-2xl",
  lg: "px-8 py-4 text-base sm:text-lg font-extrabold rounded-2xl",
};
---

<div class:list={["inline-flex flex-col items-center", fullWidth ? "w-full" : ""]}>
  <a
    href={flutterTargetUrl}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "relative inline-flex items-center justify-center text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 shadow-[0_0_25px_-5px_rgba(6,182,212,0.4)] hover:shadow-[0_0_35px_rgba(6,182,212,0.6)] hover:brightness-110 active:scale-[0.98] transition-all transform tracking-tight",
      sizeClasses[size],
      fullWidth ? "w-full" : "",
    ]}
  >
    <span data-i18n={dataI18n}>{text}</span>
  </a>

  {size === 'lg' && (
    <p class="mt-3 text-xs text-slate-400 flex items-center gap-2">
      <span class="text-emerald-400 font-bold">✓</span> Sin registro
      <span class="text-slate-600">·</span>
      <span class="text-emerald-400 font-bold">✓</span> 100% Gratuito
      <span class="text-slate-600">·</span>
      <span class="text-emerald-400 font-bold">✓</span> Corrección oficial socrática
    </p>
  )}
</div>
