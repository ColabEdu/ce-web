---
// src/pages/en/ops-specification.astro
// OPS (Open Pedagogy Specification): Declarative, Sovereign & Open Pedagogy
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const orgUrl = appLink('org', '/');
const catalogUrl = appLink('catalog', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Open Pedagogy Specification (OPS) | ColabEdu.net</title>
    <meta name="description" content="Discover the open standard OPS (Open Pedagogy Specification v0.9.6): the declarative YAML/JSON Schema specification created by the open-source colabedu.org project that liberates pedagogy from proprietary software.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-ops {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.8) 0%, rgba(240, 253, 250, 0.6) 50%, rgba(254, 243, 199, 0.4) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
        }
        .code-box {
            font-family: 'JetBrains Mono', monospace;
            background-color: #0F172A;
            color: #38BDF8;
            border-radius: 1rem;
            padding: 1.25rem;
            font-size: 0.75rem;
            line-height: 1.6;
            overflow-x: auto;
        }
        /* Alternating chromatic rhythm */
        .section-tint-blue {
            background: linear-gradient(180deg, #FFFFFF 0%, rgba(239, 246, 255, 0.45) 100%);
            border: 1px solid #BFDBFE;
        }
        .section-tint-amber {
            background: linear-gradient(180deg, #FFFFFF 0%, rgba(254, 243, 199, 0.4) 100%);
            border: 1px solid #FDE68A;
        }
    </style>
</head>
<body class="selection:bg-blue-600 selection:text-white">

    <Header lang="en" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-ops p-8 sm:p-14 text-center mb-16">
                <div class="inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest uppercase text-blue-900 bg-white/90 px-4 py-1.5 rounded-full border border-blue-300 mb-6">
                    <i class="fas fa-cube text-blue-600"></i>
                    <span>Open Standard · OPS v0.9.6</span>
                </div>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Open Pedagogy Specification.<br/>
                    Pedagogy as declarative code.
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto mb-8">
                    <strong>OPS (Open Pedagogy Specification)</strong> is an open, auditable technical standard that decouples the authoring of lessons, exercises, and rubrics from proprietary software. A declarative format developed by the <strong>colabedu.org</strong> open source project to ensure educators maintain absolute ownership over their academic assets.
                </p>
                
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href={orgUrl} target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl bg-blue-600 text-white font-bold text-sm shadow-md hover:bg-blue-700 transition flex items-center gap-2">
                        <i class="fas fa-external-link-alt text-xs"></i>
                        <span>Explore ColabEdu.org Project</span>
                    </a>
                    <a href="/en/grounding" class="px-6 py-3 rounded-xl bg-white text-slate-800 font-bold text-sm border border-slate-300 hover:bg-slate-50 transition flex items-center gap-2">
                        <i class="fas fa-shield-halved text-blue-600"></i>
                        <span>View L0 Grounding Architecture</span>
                    </a>
                </div>
            </div>

            <!-- Why an Open Standard? (Vendor Lock-in vs Sovereignty) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                <div class="precision-card p-8 bg-red-50/50 border-red-200">
                    <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-lock"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-red-700 uppercase tracking-wider block mb-1">Traditional Proprietary Model</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Vendor Lock-in & Captive Content</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        When schools author digital courses in closed commercial platforms, their questions, rubrics, and exercises remain trapped in proprietary binary formats. If the district switches vendors, years of pedagogical work are lost.
                    </p>
                    <div class="p-3 bg-red-100/60 rounded-xl border border-red-200 text-xs text-red-900 font-medium">
                        Result: Educational institutions pay perpetual licensing fees without owning their own academic intellectual property.
                    </div>
                </div>

                <div class="precision-card p-8 bg-emerald-50/50 border-emerald-200">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-unlock-keyhole"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wider block mb-1">The OPS & ColabEdu Paradigm</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Git-First Pedagogical Sovereignty</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        OPS defines every lesson, exercise, and official rubric in human-readable plain text (YAML and JSON Schema). It is version-controlled in institutional Git repositories, validated against formal schemas, and runnable on any compatible engine.
                    </p>
                    <div class="p-3 bg-emerald-100/60 rounded-xl border border-emerald-200 text-xs text-emerald-900 font-medium">
                        Benefit: Districts and educators maintain permanent, immutable ownership of their curricular specifications.
                    </div>
                </div>
            </div>

            <!-- ANATOMICAL STRUCTURE: 4 CURRICULAR LAYERS -->
            <div class="precision-card p-8 sm:p-12 mb-16 section-tint-blue">
                <span class="text-xs font-mono font-bold text-blue-700 uppercase tracking-widest block mb-2">
                    Specification Architecture
                </span>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-955 mb-4">
                    The OPS Specification Pyramid (L0 to C2)
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed mb-8">
                    An OPS specification is not a simple quiz file; it is a structured DAG graph where each element anchors unambiguously in the superior layer:
                </p>

                <div class="space-y-4">
                    <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-slate-900 text-white font-mono font-bold flex items-center justify-center text-xs shrink-0">L0</span>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">L0 Normative Grounding (Official Legal Gazettes)</h4>
                                <p class="text-xs text-slate-500">BOE RD 534/2024, LOMLOE, US Common Core, California CDE Frameworks, College Board AP with SHA-256 cryptographic verification.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-md bg-slate-200 text-slate-800 text-[10px] font-mono font-bold shrink-0">Law of Origin</span>
                    </div>

                    <div class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-amber-600 text-white font-mono font-bold flex items-center justify-center text-xs shrink-0">C0</span>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">C0 Taxonomy & Evaluation Criteria</h4>
                                <p class="text-xs text-slate-500">Formal mapping of competencies, observable criteria, performance tiers, and analytical rubrics.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-md bg-amber-200 text-amber-900 text-[10px] font-mono font-bold shrink-0">Official Rubric</span>
                    </div>

                    <div class="p-5 rounded-2xl bg-indigo-50/70 border border-indigo-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-indigo-600 text-white font-mono font-bold flex items-center justify-center text-xs shrink-0">C1</span>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">C1 Didactic Recipe & Assessment Weighting</h4>
                                <p class="text-xs text-slate-500">Structure of the exam or lesson: thematic section weights, time allowances, and classroom directives.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-md bg-indigo-200 text-indigo-900 text-[10px] font-mono font-bold shrink-0">Curricular Blueprint</span>
                    </div>

                    <div class="p-5 rounded-2xl bg-blue-50/70 border border-blue-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-blue-600 text-white font-mono font-bold flex items-center justify-center text-xs shrink-0">C2</span>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">C2 Canonical Exercise or Interactive Lesson</h4>
                                <p class="text-xs text-slate-500">Prompts, A2UI widgets, step-by-step canonical solutions, and diagnostic misconception trees.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-md bg-blue-200 text-blue-900 text-[10px] font-mono font-bold shrink-0">Classroom Spec</span>
                    </div>
                </div>
            </div>

            <!-- LIVE YAML SPECIFICATION EXAMPLE -->
            <div class="mb-16">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-xs font-mono font-bold text-indigo-700 uppercase tracking-widest block mb-2">
                        Full Transparency
                    </span>
                    <h2 class="text-3xl font-black text-slate-900 tracking-tight">
                        How a Lesson is Defined in OPS
                    </h2>
                    <p class="text-sm text-slate-600 mt-2">
                        Zero proprietary binaries. A human-readable YAML document that any educator or developer can audit, edit, and version in Git.
                    </p>
                </div>

                <div class="code-box">
<pre><code>apiVersion: colabedu.ai/v1beta1
kind: InteractiveLesson
metadata:
  id: "lesson.physics.parabolic_motion.v1"
  title: "Kinematics: Projectile Motion Simulation"
  standard: "standard.ap.physics1.us"
  competencies: ["HS-PS2-1", "AP.PHYS.KIN2D"]
  version: "1.0.0"
spec:
  durationMinutes: 45
  slides:
    - slideNumber: 1
      title: "The Maximum Range Problem"
      layout: "split"
      theory: "v_x = v_0 * cos(alpha); v_y = v_0 * sin(alpha) - g*t"
    - slideNumber: 2
      title: "Interactive Laboratory"
      layout: "widget"
      widget:
        type: "physics_parameter_slider"
        parameters: ["angle", "initial_velocity"]
    - slideNumber: 3
      title: "Socratic Checkpoint"
      layout: "widget"
      widget:
        type: "quiz_widget"
        question: "Why do launch angles of 30° and 60° produce the same range?"
        socratic_hint: "Analyze the sin(2*alpha) factor in the range equation."</code></pre>
                </div>
            </div>

            <!-- CONNECTION WITH COLABEDU.ORG: THE OPEN SOURCE PROJECT -->
            <div class="precision-card p-8 sm:p-12 mb-16 section-tint-amber">
                <div class="flex items-center gap-3 text-blue-700 font-bold text-xs font-mono uppercase tracking-widest mb-3">
                    <i class="fas fa-code-branch"></i>
                    <span>Open Source Community</span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-black text-slate-950 mb-4">
                    ColabEdu.org: The Open Source Foundation of OPS
                </h3>
                <p class="text-sm text-slate-700 leading-relaxed mb-6">
                    <strong>ColabEdu.org</strong> is the open-source portal where the <strong>OPS</strong> standard is authored and maintained. It houses JSON Schema meta-schemas, developer implementation guides, and open source gazette manifests. <strong>ColabEdu.net</strong> delivers the managed cloud infrastructure, classroom deployments, native tablet apps, and LMS extensions for institutions.
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                    <div class="p-4 rounded-xl bg-white border border-slate-200">
                        <span class="text-xs font-bold text-slate-900 block mb-1">
                            <i class="fas fa-scale-balanced text-blue-600 mr-1.5"></i> Open & Auditable Specification
                        </span>
                        <p class="text-xs text-slate-600">
                            Any school or developer can build their own compatible execution engine or validator with zero licensing fees.
                        </p>
                    </div>

                    <div class="p-4 rounded-xl bg-white border border-slate-200">
                        <span class="text-xs font-bold text-slate-900 block mb-1">
                            <i class="fas fa-globe text-teal-600 mr-1.5"></i> 65+ Federated OER Repositories
                        </span>
                        <p class="text-xs text-slate-600">
                            OPS connects with open educational repositories including OpenStax, CK-12, PhET Colorado, and regional educational ministries.
                        </p>
                    </div>
                </div>

                <div class="pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
                    <div class="text-xs text-slate-500 font-mono">
                        Open Standard: <span class="font-bold text-blue-700">OPS v0.9.6</span>
                    </div>
                    <a href={orgUrl} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition flex items-center gap-2">
                        <span>Read Technical Specs on ColabEdu.org</span>
                        <i class="fas fa-external-link-alt text-[10px]"></i>
                    </a>
                </div>
            </div>

            <!-- FINAL CALLOUT -->
            <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
                <div class="max-w-xl">
                    <span class="text-xs font-mono font-bold text-blue-400 uppercase tracking-widest block mb-2">
                        Experience OPS Applications
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">
                        See the specification live in the classroom
                    </h3>
                    <p class="text-sm text-slate-300 leading-relaxed">
                        Explore interactive simulation lessons and authentic exams with OCR handwriting grading powered by pure OPS specifications.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
                    <a href="/en/interactive-lessons" class="px-6 py-3.5 rounded-xl bg-blue-600 text-white font-bold text-sm text-center shadow-md hover:bg-blue-500 transition">
                        Interactive Lessons
                    </a>
                    <a href="/en/interactive-exams" class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-bold text-sm text-center hover:bg-white/20 transition border border-white/20">
                        Exams & OCR
                    </a>
                </div>
            </div>

        </div>
    </main>

    <Footer lang="en" />

</body>
</html>
