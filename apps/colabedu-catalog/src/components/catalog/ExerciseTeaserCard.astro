---
import type { SlideQuestion } from '@/lib/types';
import InteractiveCtaButton from './InteractiveCtaButton.astro';

interface Props {
  question: SlideQuestion;
  index: number;
  lessonId: string;
  slideIndex?: number;
  slideId?: string;
}

const { question, index, lessonId, slideIndex, slideId } = Astro.props;
---

<div class="my-8 relative group">
  <!-- Outer border gradient highlight -->
  <div class="relative p-[1.5px] rounded-3xl bg-gradient-to-b from-cyan-500/30 via-white/10 to-transparent shadow-[0_8px_32px_rgba(0,0,0,0.5)] group-hover:from-cyan-500/50 transition-all">
    <div class="rounded-[23px] bg-[#070b16] p-7 sm:p-9 relative overflow-hidden">
      <!-- Top Meta Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-white/[0.08]">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-cyan-500/10 text-cyan-300 border border-cyan-500/25">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            Reactivo Oficial #{index}
          </span>
          <span class="text-xs text-slate-400 font-mono hidden sm:inline" data-i18n="lesson.canonical_diagnostic">
            Prueba Diagnóstica Canónica
          </span>
        </div>

        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" data-i18n="lesson.official_grading">
          ✓ Corrección Oficial
        </span>
      </div>

      <!-- Question Prompt -->
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-6 leading-snug tracking-tight">
        {question.text}
      </h3>

      <!-- Options List -->
      {question.options && question.options.length > 0 && (
        <div class="space-y-3 mb-8">
          {question.options.map((opt, optIdx) => {
            const letter = String.fromCharCode(65 + optIdx);
            return (
              <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.07] hover:border-cyan-500/40 hover:bg-white/[0.05] transition-all cursor-pointer group/opt shadow-sm">
                <span class="w-7 h-7 rounded-xl bg-slate-800/90 text-slate-300 flex items-center justify-center text-xs font-bold font-mono group-hover/opt:bg-cyan-500 group-hover/opt:text-black transition-colors flex-shrink-0 shadow-inner">
                  {letter}
                </span>
                <span class="text-sm sm:text-base text-slate-200 group-hover/opt:text-white transition-colors flex-1 leading-normal font-medium">
                  {opt}
                </span>
                <span class="text-xs text-slate-500 opacity-0 group-hover/opt:opacity-100 transition-opacity text-cyan-400 font-semibold hidden sm:inline">
                  Comprobar ↗
                </span>
              </div>
            );
          })}
        </div>
      )}

      <!-- Bottom Interactive Footer -->
      <div class="pt-5 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span class="text-cyan-400 font-bold">⚡</span>
          <span data-i18n="lesson.socratic_step_by_step">Resolución paso a paso con retroalimentación socrática inmediata.</span>
        </div>

        <InteractiveCtaButton
          lessonId={lessonId}
          slideIndex={slideIndex}
          slideId={slideId}
          text="Resolver este ejercicio en el simulador (90s) →"
          dataI18n="lesson.solve_simulator"
          size="sm"
        />
      </div>
    </div>
  </div>
</div>
