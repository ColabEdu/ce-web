---
// SupportCompanionDemoFrame.astro: Widget Demo Frame in-situ con iframe del SupportCompanion de Flutter
import { appLink } from "../navigation/routes";

export interface Props {
  initialTopic?: string;
  userRole?: 'TEACHER' | 'STUDENT' | 'ADMIN';
  height?: string;
  title?: string;
  lang?: string;
}

const {
  initialTopic = 'general',
  userRole = 'TEACHER',
  height = '560px',
  title,
  lang = 'es',
} = Astro.props;

const isEn = lang === 'en';
const supportQuery: Record<string, string> = {
  embed: 'true',
  role: userRole,
  topic: initialTopic,
};

const supportUrl = appLink('app', '/support', supportQuery);
const fullSupportUrl = appLink('app', '/support', { role: userRole, topic: initialTopic });

const defaultTitle = isEn
  ? 'AI Support & Pedagogical Knowledge Companion (Zero Auth Demo)'
  : 'Copilot de Soporte Pedagógico & Ayuda OPS (Demo en Vivo Sin Registro)';
---

<div class="support-companion-demo-container rounded-2xl border border-slate-300/80 bg-white shadow-xl overflow-hidden my-8">
  <!-- Topbar -->
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 bg-slate-900 text-white border-b border-slate-800">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      </div>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-teal-400 text-slate-950">
        Flutter UX Support
      </span>
      <span class="text-xs font-semibold text-slate-200 hidden sm:inline">
        {title || defaultTitle}
      </span>
    </div>

    <!-- Quick Role Pill & Fullscreen -->
    <div class="flex items-center gap-2">
      <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-slate-800 text-teal-300 border border-slate-700">
        Role: {userRole} (Unauthenticated / Dev-Bypass)
      </span>
      <a
        href={fullSupportUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition flex items-center gap-1.5 border border-white/10"
        title={isEn ? "Open full support app" : "Abrir asistente en pantalla completa"}
      >
        <span>{isEn ? "Full Page" : "Pantalla Completa"}</span>
        <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
      </a>
    </div>
  </div>

  <!-- Iframe -->
  <div class="relative w-full bg-slate-950">
    <iframe
      src={supportUrl}
      class="w-full border-none block"
      style={`height: ${height};`}
      loading="lazy"
      title={title || defaultTitle}
      allow="clipboard-read; clipboard-write; microphone"
    ></iframe>
  </div>

  <!-- Bottom Explanatory Strip -->
  <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between text-[11px] text-slate-600 gap-2">
    <div class="flex items-center gap-2">
      <i class="fas fa-circle-info text-teal-600"></i>
      <span>
        {isEn 
          ? "Interacting with the live RAG knowledge base. Submits zero telemetry outside ephemeral memory."
          : "Consulta interactiva directa contra la base de conocimiento OPS. Cero retención de datos personales."}
      </span>
    </div>
    <a href="/es/data-sovereignty-privacy" class="text-teal-700 font-bold hover:underline">
      {isEn ? "Data Sovereignty & Privacy →" : "Ver Garantías de Privacidad →"}
    </a>
  </div>
</div>
