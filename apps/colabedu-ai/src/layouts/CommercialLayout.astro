---
import "../styles/global.css";
import CommercialNav from "../components/CommercialNav.astro";
import Footer from "@ui/components/footer/Footer.astro"; // Using generic footer for now, or could create custom one.
// Actually, mockups have a specific footer. Let's use a simple custom footer for now or assume generic one is okay.
// Mockup footer: Simple copyright text.
// Let's create a custom footer inline or separate component if needed. Use generic for now to save time, or minimal custom one.

interface Props {
    title: string;
    description?: string;
}

const { title, description = "ColabEdu - Inteligencia Pedagógica" } =
    Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="text-slate-900 font-sans antialiased selection:bg-indigo-600 selection:text-white"
    >
        <CommercialNav />
        <main class="pt-20 min-h-screen">
            <slot />
        </main>

        <footer class="bg-slate-50 py-12 border-t border-slate-200 mt-auto">
            <div class="max-w-7xl mx-auto px-4 text-center">
                <p
                    class="text-slate-400 text-xs font-bold uppercase tracking-widest"
                >
                    &copy; {new Date().getFullYear()} ColabEdu Enterprise. Inteligencia
                    Pedagógica.
                </p>
            </div>
        </footer>
    </body>
</html>
