---
// GlobalModalHost.astro: Modales universales embebidos para Catálogo OER y Soporte/Tickets
import { appLink } from "../navigation/routes";

export interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const defaultCatalogUrl = appLink('app', '/navigator/spec_root/0', { embed: 'true', lang });
const defaultSupportUrl = appLink('app', '/support', { embed: 'true', lang });
---

<!-- 1. MODAL EMBEBIDO DE CATÁLOGO OER -->
<div id="colabedu-catalog-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-md items-center justify-center p-4 sm:p-6 transition-all opacity-0">
  <div class="bg-white rounded-3xl border border-slate-300 shadow-2xl w-full max-w-6xl max-h-[92vh] flex flex-col overflow-hidden animate-scale-in">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 bg-slate-900 text-white border-b border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-amber-400 text-slate-950 flex items-center justify-center font-bold text-base">
          <i class="fas fa-layer-group"></i>
        </div>
        <div>
          <h3 class="text-base font-black tracking-tight leading-tight">
            {isEn ? 'Curricular OER Catalog Explorer' : 'Explorador del Catálogo Curricular OER'}
          </h3>
          <p class="text-[11px] text-slate-400 font-mono">
            {isEn ? 'OPS Federated Curriculums · Live Sandbox' : 'Currículos Federados OPS · Exploración en Vivo'}
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <a
          id="colabedu-catalog-modal-expand-btn"
          href={defaultCatalogUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition flex items-center gap-1.5 border border-white/10"
        >
          <span>{isEn ? 'Full Screen' : 'Pantalla Completa'}</span>
          <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
        <button
          type="button"
          data-close-modal="colabedu-catalog-modal"
          class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition"
          aria-label={isEn ? 'Close modal' : 'Cerrar modal'}
        >
          <i class="fas fa-xmark text-sm"></i>
        </button>
      </div>
    </div>

    <!-- Iframe Container -->
    <div class="relative flex-1 w-full bg-slate-950 min-h-[560px]">
      <iframe
        id="colabedu-catalog-modal-iframe"
        src="about:blank"
        data-src={defaultCatalogUrl}
        class="w-full h-full border-none block"
        style="min-height: 560px; height: 75vh;"
        loading="lazy"
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </div>
</div>

<!-- 2. MODAL EMBEBIDO DE SOPORTE & CREACIÓN DE TICKETS -->
<div id="colabedu-support-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-md items-center justify-center p-3 sm:p-5 lg:p-6 transition-all opacity-0">
  <div class="bg-white rounded-3xl border border-slate-300 shadow-2xl w-full max-w-5xl max-h-[94vh] flex flex-col overflow-hidden animate-scale-in">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 bg-slate-900 text-white border-b border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-teal-400 text-slate-950 flex items-center justify-center font-bold text-base">
          <i class="fas fa-headset"></i>
        </div>
        <div>
          <h3 class="text-base font-black tracking-tight leading-tight">
            {isEn ? 'Support & Institutional Inquiries' : 'Centro de Ayuda, Soporte & Consultas'}
          </h3>
          <p class="text-[11px] text-slate-400 font-mono">
            {isEn ? 'AI Pedagogical Companion · Ticket Dispatch' : 'Asistente de Aula RAG · Registro de Incidencias'}
          </p>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        <a
          id="colabedu-support-modal-expand-btn"
          href={defaultSupportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition flex items-center gap-1.5 border border-white/10"
        >
          <span>{isEn ? 'Full Screen' : 'Pantalla Completa'}</span>
          <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
        <button
          type="button"
          data-close-modal="colabedu-support-modal"
          class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition"
          aria-label={isEn ? 'Close modal' : 'Cerrar modal'}
        >
          <i class="fas fa-xmark text-sm"></i>
        </button>
      </div>
    </div>

    <!-- Iframe Container -->
    <div class="relative flex-1 w-full bg-slate-50 min-h-[600px]">
      <iframe
        id="colabedu-support-modal-iframe"
        src="about:blank"
        data-src={defaultSupportUrl}
        class="w-full h-full border-none block"
        style="min-height: 600px; height: 80vh;"
        loading="lazy"
        allow="clipboard-read; clipboard-write; microphone"
      ></iframe>
    </div>
  </div>
</div>

<!-- 3. MODAL GENÉRICO DE DEMOSTRACIÓN EN VIVO (Lecciones A2UI, Gradebook, Visor de Aula, Tutor) -->
<div id="colabedu-demo-modal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-md items-center justify-center p-3 sm:p-5 lg:p-6 transition-all opacity-0">
  <div class="bg-white rounded-3xl border border-slate-300 shadow-2xl w-full max-w-6xl max-h-[94vh] flex flex-col overflow-hidden animate-scale-in">
    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-4 bg-slate-900 text-white border-b border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-base">
          <i class="fas fa-play"></i>
        </div>
        <div>
          <h3 id="colabedu-demo-modal-title" class="text-base font-black tracking-tight leading-tight">
            {isEn ? 'Interactive Classroom Demo' : 'Demostrador Interactivo de Aula'}
          </h3>
          <p id="colabedu-demo-modal-subtitle" class="text-[11px] text-slate-400 font-mono">
            {isEn ? 'Live A2UI Runtime · Sandbox Mode' : 'Entorno A2UI en Vivo · Modo Demostración'}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a
          id="colabedu-demo-modal-expand-btn"
          href={defaultCatalogUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition flex items-center gap-1.5 border border-white/10"
        >
          <span>{isEn ? 'Full Screen' : 'Pantalla Completa'}</span>
          <i class="fas fa-arrow-up-right-from-square text-[10px]"></i>
        </a>
        <button
          type="button"
          data-close-modal="colabedu-demo-modal"
          class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition"
          aria-label={isEn ? 'Close modal' : 'Cerrar modal'}
        >
          <i class="fas fa-xmark text-sm"></i>
        </button>
      </div>
    </div>

    <!-- Iframe Container -->
    <div class="relative flex-1 w-full bg-slate-950 min-h-[560px]">
      <iframe
        id="colabedu-demo-modal-iframe"
        src="about:blank"
        data-src={defaultCatalogUrl}
        class="w-full h-full border-none block"
        style="min-height: 560px; height: 78vh;"
        loading="lazy"
        allow="clipboard-read; clipboard-write; microphone"
      ></iframe>
    </div>
  </div>
</div>

<script>
  import { appLink, type AppTarget } from "../navigation/routes";

  function detectRuntimeTenant(): string | undefined {
    try {
      const params = new URLSearchParams(window.location.search);
      const qTenant = params.get('tenant');
      if (qTenant) return qTenant;

      const host = window.location.hostname.toLowerCase();
      // Ej: colabedu-net.intef.demo.colabedu.net o app.intef.demo.colabedu.net
      const match = host.match(/\.([a-z0-9-]+)\.demo\.colabedu\.net$/);
      if (match && match[1]) return match[1];
    } catch (_) {}
    return undefined;
  }

  function resolveRuntimeUrl(target: AppTarget, path: string, extraParams: Record<string, string> = {}) {
    const docLang = document.documentElement.lang || (window.location.pathname.startsWith('/en') ? 'en' : 'es');
    const tenant = detectRuntimeTenant();
    return appLink(
      target,
      path,
      { embed: 'true', lang: docLang, ...extraParams },
      tenant ? { tenant } : undefined
    );
  }

  function setupGlobalModals() {
    function openModal(modalId: string, customUrl?: string) {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      const iframe = modal.querySelector('iframe');
      if (iframe) {
        const targetUrl = customUrl || iframe.getAttribute('data-src') || '';
        if (iframe.src !== targetUrl && targetUrl) {
          iframe.src = targetUrl;
        }
        const expandBtn = modal.querySelector<HTMLAnchorElement>('a[id$="-expand-btn"]');
        if (expandBtn) {
          expandBtn.href = targetUrl
            .replace('&embed=true', '')
            .replace('?embed=true&', '?')
            .replace('?embed=true', '');
        }
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeModal(modalId: string) {
      const modal = document.getElementById(modalId);
      if (!modal) return;

      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        if (modalId === 'colabedu-demo-modal') {
          const iframe = modal.querySelector('iframe');
          if (iframe) iframe.src = 'about:blank';
        }
      }, 200);
    }

    // Cierre al pulsar botones o backdrop
    document.querySelectorAll('[data-close-modal]').forEach(btn => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-close-modal');
        if (modalId) closeModal(modalId);
      });
    });

    ['colabedu-catalog-modal', 'colabedu-support-modal', 'colabedu-demo-modal'].forEach(id => {
      const modal = document.getElementById(id);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal(id);
        });
      }
    });

    // Delegación global para disparadores de catálogo A2UI (resuelve entorno en runtime)
    document.querySelectorAll('[data-open-catalog-modal]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const customTarget = trigger.getAttribute('data-catalog-url');
        const customPath = trigger.getAttribute('data-catalog-path') || '/navigator/spec_root/0';
        const finalUrl = customTarget || resolveRuntimeUrl('app', customPath);
        openModal('colabedu-catalog-modal', finalUrl);
      });
    });

    // Delegación global para disparadores genéricos de demos en vivo (lecciones, gradebook, visor, tutor)
    document.querySelectorAll('[data-open-demo-modal]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const targetAttr = (trigger.getAttribute('data-demo-target') as AppTarget) || 'app';
        const demoPath = trigger.getAttribute('data-demo-path') || '/navigator/spec_root/0';
        const explicitUrl = trigger.getAttribute('data-demo-url');
        const demoTitle = trigger.getAttribute('data-demo-title');
        const demoSubtitle = trigger.getAttribute('data-demo-subtitle');

        const titleEl = document.getElementById('colabedu-demo-modal-title');
        const subtitleEl = document.getElementById('colabedu-demo-modal-subtitle');
        if (titleEl && demoTitle) titleEl.textContent = demoTitle;
        if (subtitleEl && demoSubtitle) subtitleEl.textContent = demoSubtitle;

        const finalUrl = explicitUrl || resolveRuntimeUrl(targetAttr, demoPath);
        openModal('colabedu-demo-modal', finalUrl);
      });
    });

    // Delegación global para disparadores de soporte / tickets con pre-población
    document.querySelectorAll('[data-open-support-modal], a[href*="mailto:"]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const href = trigger.getAttribute('href') || '';
        const customSubject = trigger.getAttribute('data-support-subject');
        const customDesc = trigger.getAttribute('data-support-desc');
        const customCategory = trigger.getAttribute('data-support-category');
        const customLang = trigger.getAttribute('data-support-lang');
        const customTab = trigger.getAttribute('data-support-tab') || 'ticket';

        // Detectar idioma de la página actual (/en/ o /es/) o atributo html lang
        const docLang = document.documentElement.lang || (window.location.pathname.startsWith('/en') ? 'en' : 'es');
        const activeLang = customLang || docLang || 'es';

        let subject = customSubject || '';
        let description = customDesc || '';
        let category = customCategory || '';

        // Si es un mailto institucional, interceptar elegantemente para abrir el ticket pre-poblado
        if (href.startsWith('mailto:')) {
          e.preventDefault();
          try {
            const urlObj = new URL(href);
            const toEmail = urlObj.pathname;
            const searchParams = new URLSearchParams(urlObj.search);
            const isEnglish = activeLang === 'en';
            subject = subject || searchParams.get('subject') || (isEnglish ? `Inquiry regarding ${toEmail}` : `Consulta sobre ${toEmail}`);
            description = description || searchParams.get('body') || (isEnglish ? `Inquiry directed to ${toEmail}. Please describe your educational institution or question.` : `Solicitud dirigida a ${toEmail}. Por favor, detallad vuestra consulta o centro educativo.`);
            if (!category && toEmail.includes('privacy')) category = 'dpa';
            if (!category && toEmail.includes('billing')) category = 'billing';
            if (!category && toEmail.includes('edu')) category = 'institution';
          } catch(err) {
            subject = subject || (activeLang === 'en' ? 'Institutional Inquiry' : 'Consulta institucional');
          }
        } else if (trigger.hasAttribute('data-open-support-modal')) {
          e.preventDefault();
        } else {
          return;
        }

        const extra: Record<string, string> = {
          tab: customTab,
          lang: activeLang,
          _v: Date.now().toString(),
        };
        if (category) extra.category = category;
        if (subject) extra.subject = subject;
        if (description) extra.description = description;

        openModal('colabedu-support-modal', resolveRuntimeUrl('app', '/support', extra));
      });
    });
  }

  setupGlobalModals();
  document.addEventListener('astro:page-load', setupGlobalModals);
</script>
