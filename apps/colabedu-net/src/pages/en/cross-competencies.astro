---
// src/pages/en/cross-competencies.astro
// Cross-Competency Framework (European, National & Global) & Non-Invasive Shadow Audits
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/navigator/spec_root/0');
const catalogUrl = appLink('catalog', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cross-Competencies & Shadow Audits | ColabEdu.net</title>
    <meta name="description" content="End the teacher paperwork nightmare: autonomous mapping of European, national (Common Core, TEKS, LOMLOE), and global (PISA, IB) competencies. Non-invasive shadow audits in LMS with zero exam anxiety.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card-dark {
            background-color: #0F172A !important;
            color: #FFFFFF !important;
            border: 1px solid #334155 !important;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-cross {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.8) 0%, rgba(240, 253, 250, 0.7) 50%, rgba(254, 243, 199, 0.5) 100%);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 2rem;
        }
        .flow-step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-family: var(--font-mono);
            font-size: 14px;
        }
    </style>
</head>
<body class="selection:bg-teal-600 selection:text-white">

    <Header lang="en" />

    <main class="pt-28 pb-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- HERO SECTION -->
            <div class="hero-cross p-8 sm:p-14 mb-16 text-center relative overflow-hidden shadow-xs">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 border border-slate-200 text-xs font-mono font-bold text-slate-700 mb-6 shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>CROSS-COMPETENCY ENGINE · OPS v0.9.6</span>
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
                    Ending the teacher paperwork nightmare: <br class="hidden sm:inline" />
                    <span class="text-teal-700">Cross-Competencies</span> & <span class="text-blue-700">Shadow Audits</span>.
                </h1>

                <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed mb-8">
                    Modern educational mandates require grading by specific and transversal competencies, transforming teaching into hours of manual bookkeeping. ColabEdu autonomously matches official rubrics and competency descriptors to any exercise or exam through closed-context normative RAG, enabling background district-wide diagnostics with zero classroom disruption.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="#how-it-works" class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-sm transition-all shadow-md flex items-center gap-2">
                        <i class="fas fa-microchip text-teal-400"></i>
                        <span>How Autonomous Matching Works</span>
                    </a>
                    <a href="#shadow-audits" class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-extrabold text-sm transition-all shadow-2xs flex items-center gap-2">
                        <i class="fas fa-ghost text-indigo-600"></i>
                        <span>Shadow Audits for Districts</span>
                    </a>
                </div>

                <!-- Live Indicator Stats Bar -->
                <div class="mt-10 pt-8 border-t border-slate-200/80 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-slate-900 font-mono">-85%</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Time on Grading Sheets</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-teal-700 font-mono">3 Tiers</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">European · National · Global</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-blue-700 font-mono">0 Hallucinations</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Official L0 Specs in Vector DB</div>
                    </div>
                    <div>
                        <div class="text-2xl sm:text-3xl font-black text-indigo-700 font-mono">&lt; $0.0004</div>
                        <div class="text-xs text-slate-500 font-medium mt-0.5">Inference Cost per Student</div>
                    </div>
                </div>
            </div>

            <!-- SECTION 1: THE REAL TEACHER PROBLEM -->
            <div class="precision-card p-8 sm:p-12 mb-16 bg-white border-slate-300">
                <div class="max-w-3xl mb-8">
                    <span class="text-xs font-mono font-bold text-red-600 uppercase tracking-widest block mb-2">
                        The Structural Friction
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
                        The competency spreadsheet nightmare: 4 to 6 hours lost every week.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
                        With the roll-out of <strong>Common Core</strong> and <strong>Texas TEKS</strong> in the US, the <strong>European Union Key Competences</strong>, and <strong>LOMLOE</strong> in Spain, educators are no longer just grading whether an answer is right or wrong: they must justify every decimal point across multiple alphanumeric competency standards.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-table"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Suffocating Manual Bureaucracy</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Hand-mapping each exam question to official standards (e.g. <em>CCSS.ELA-LITERACY.RL.11-12.1</em> or <em>CCL1</em>) and filling out endless spreadsheets that steal time away from pedagogical prep and one-on-one student attention.
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-clone"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Mandatory Double Bookkeeping</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Teachers must maintain two parallel gradebooks: their course-specific grades and secondary competency uploads to district/regional LMS platforms (<em>Canvas, Moodle, Google Classroom, PowerSchool</em>).
                        </p>
                    </div>

                    <div class="p-5 rounded-xl bg-slate-50 border border-slate-200">
                        <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-base mb-3">
                            <i class="fas fa-eye-slash"></i>
                        </div>
                        <h3 class="font-black text-slate-900 text-base mb-2">Subjective End-of-Term Guesses</h3>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Without tools that measure live competency growth in everyday classroom assignments, competency evaluation ends up becoming a hurried, subjective estimate at the end of the term.
                        </p>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: THE 3-TIER MATRIX: EUROPEAN, NATIONAL & GLOBAL -->
            <div class="mb-16">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="text-xs font-mono font-bold text-teal-700 uppercase tracking-widest block mb-2">
                        Multidimensional Harmonization
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
                        One single student task, three regulatory frameworks synchronized in real time.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
                        ColabEdu decouples task content from regulatory frameworks. A student writes an argumentative essay or solves an authentic classroom problem, and the engine projects mastery simultaneously across three authoritative axes:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Tier 1: European & Transversal -->
                    <div class="precision-card p-6 sm:p-8 border-teal-200 bg-gradient-to-b from-white to-teal-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-teal-100 text-teal-800 text-[10px] font-mono font-bold uppercase">
                                    Tier 1 · European Union
                                </span>
                                <span class="text-xl">🇪🇺</span>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">European & Transversal Standards</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Harmonized Council of the European Union frameworks for lifelong learning and digital citizenship:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>EU Key Competences 2018:</strong> The 8 core competences for lifelong learning and personal fulfilment.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>CEFR / MCER (A1 to C2):</strong> Common European Framework of Reference for Languages (spoken and written production).</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>DigComp 2.2:</strong> European digital competence framework and critical information literacy.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-teal-600 mt-0.5"></i>
                                    <span><strong>EntreComp:</strong> Initiative, creative thinking, and open-ended challenge resolution.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-teal-100 text-[11px] font-mono text-teal-700">
                            Cross-border European recognition
                        </div>
                    </div>

                    <!-- Tier 2: National & State -->
                    <div class="precision-card p-6 sm:p-8 border-blue-200 bg-gradient-to-b from-white to-blue-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-blue-100 text-blue-800 text-[10px] font-mono font-bold uppercase">
                                    Tier 2 · National & State
                                </span>
                                <div class="flex items-center gap-1 text-base">
                                    <span>🇺🇸</span>
                                    <span>🇪🇸</span>
                                    <span>🇲🇽</span>
                                </div>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">National & State Standards</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Strict legal alignment (Grounding L0) with regional regulations and university entrance requirements:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>US · Common Core (CCSS):</strong> English Language Arts and Mathematics college and career readiness.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>US · Texas TEKS & STAAR:</strong> Texas Essential Knowledge and Skills benchmarks.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>US · California CDE:</strong> World Languages Framework & State Seal of Biliteracy requirements.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-blue-600 mt-0.5"></i>
                                    <span><strong>Spain · LOMLOE & EBAU/PAU:</strong> RD 217/2022, RD 243/2022, and university entrance criteria across all 17 regions.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-blue-100 text-[11px] font-mono text-blue-700">
                            100% legal auditability on official gradebooks
                        </div>
                    </div>

                    <!-- Tier 3: Global & International Assessment -->
                    <div class="precision-card p-6 sm:p-8 border-indigo-200 bg-gradient-to-b from-white to-indigo-50/30 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-2.5 py-1 rounded-md bg-indigo-100 text-indigo-800 text-[10px] font-mono font-bold uppercase">
                                    Tier 3 · Global & OECD
                                </span>
                                <span class="text-xl">🌐</span>
                            </div>
                            <h3 class="text-xl font-black text-slate-900 mb-3">Global Standards & PISA</h3>
                            <p class="text-xs text-slate-600 leading-relaxed mb-6">
                                Benchmarking with the world's most recognized psychometric metrics and international diplomas:
                            </p>
                            <ul class="space-y-2.5 text-xs text-slate-700 font-medium">
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>OECD PISA (Levels 1 to 6):</strong> Information retrieval, text integration/inference, and critical evaluation.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>IB Diploma Programme:</strong> Criteria A, B, C, and D across bilingual, humanities, and science diplomas.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>College Board AP:</strong> Official scoring rubrics for Advanced Placement examinations.</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <i class="fas fa-check text-indigo-600 mt-0.5"></i>
                                    <span><strong>OECD Learning Compass 2030:</strong> Student agency, transformative competences, and metacognition.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="mt-6 pt-4 border-t border-indigo-100 text-[11px] font-mono text-indigo-700">
                            Immediate transnational comparability
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: HOW THE ALGORITHM WORKS (ZERO HALLUCINATIONS) -->
            <div id="how-it-works" class="precision-card-dark p-8 sm:p-12 mb-16 rounded-3xl shadow-xl scroll-mt-24">
                <div class="max-w-3xl mb-10">
                    <span class="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest block mb-2">
                        Closed-Context Architecture
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
                        How we assign rubrics and competencies to any task in 3 seconds.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
                        ColabEdu's engine <strong class="text-white">never invents</strong> pedagogical criteria. It operates exactly like an <strong class="text-white">expert board of examiners or a school district inspector</strong>, applying official standards to authentic student work.
                    </p>
                </div>

                <!-- 4 Steps of the Algorithm -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-teal-500/20 text-teal-300 border border-teal-500/40 mb-4">1</div>
                            <h4 class="font-bold text-white text-sm mb-2">Raw Teacher Prompt</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                The teacher writes a question, speaks a prompt, uploads a PDF, or imports an assignment from Moodle/Canvas. No prior metadata required.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-teal-400 font-bold">
                            Frictionless teacher input
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-blue-500/20 text-blue-300 border border-blue-500/40 mb-4">2</div>
                            <h4 class="font-bold text-white text-sm mb-2">Closed RAG Query</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                The backend queries the vector DB (<code class="text-blue-300 font-bold">spec_definitions</code>) for official rubric specifications (C0) for the subject and level. Zero inventiveness.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-blue-400 font-bold">
                            Bounded normative catalog
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 mb-4">3</div>
                            <h4 class="font-bold text-white text-sm mb-2">Psychometric Ingestion</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                The LLM engine evaluates cognitive depth (Bloom's Taxonomy) and computes a <code class="text-indigo-300 font-bold">relevanceScore</code> for each official criterion in the database.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-indigo-400 font-bold">
                            Nuclear criteria ≥ 0.85
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-slate-800/90 border border-slate-700/80 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="flow-step-circle bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 mb-4">4</div>
                            <h4 class="font-bold text-white text-sm mb-2">Rubrics & Codes Ready</h4>
                            <p class="text-xs text-slate-300 leading-relaxed">
                                The assignment is configured with official descriptors (Common Core, PISA L4), analytical scoring scales, and pedagogical justifications in 2 to 3 seconds.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-700/80 font-mono text-[10px] text-emerald-400 font-bold">
                            Ready for auto-pregrading
                        </div>
                    </div>
                </div>

                <!-- JSON snippet illustration -->
                <div class="bg-slate-950 p-5 rounded-xl border border-slate-800 font-mono text-xs">
                    <div class="flex items-center justify-between text-slate-400 text-[11px] mb-3 pb-2 border-b border-slate-800">
                        <span>LIVE EXECUTION: RUBRIC_MATCHER_RESPONSE</span>
                        <span class="text-emerald-400 font-bold">overallConfidence: 0.94 (94%)</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-slate-300 text-[11px]">
                        <div>
                            <span class="text-amber-400 block mb-1 font-bold">Evaluated Prompt:</span>
                            <p class="italic text-slate-400 bg-slate-900/80 p-2.5 rounded border border-slate-800">
                                "Analyze the passage from The Great Gatsby and explain how the green light and the valley of ashes function as symbolic social critiques."
                            </p>
                        </div>
                        <div class="space-y-1">
                            <div><span class="text-teal-400 font-bold">Nuclear Criterion (0.95):</span> CCSS.ELA-LITERACY.RL.11-12.2 · Theme & Symbolism</div>
                            <div><span class="text-teal-400 font-bold">Support Criterion (0.80):</span> CCSS.ELA-LITERACY.W.11-12.1 · Textual Evidence</div>
                            <div><span class="text-blue-400 font-bold">EU Competency:</span> EU_CCL (Communication) & EU_CCEC (Cultural Expression)</div>
                            <div><span class="text-indigo-400 font-bold">PISA Reading Level:</span> Level 5 (Critical reflection and abstract interpretation)</div>
                            <div><span class="text-slate-500 font-bold">Discarded Criteria:</span> Basic Grammar (0.00), Oral Presentation (0.00)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 4: SHADOW AUDITS (BACKGROUND DIAGNOSTICS FOR DISTRICTS) -->
            <div id="shadow-audits" class="precision-card p-8 sm:p-12 mb-16 bg-white border-slate-300 scroll-mt-24">
                <div class="max-w-3xl mb-10">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-xs font-mono font-bold text-indigo-800 mb-3">
                        <i class="fas fa-ghost"></i>
                        <span>BACKGROUND SHADOW AUDITS (SHADOW MODE)</span>
                    </div>
                    <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
                        Census-level diagnostic audits without exam anxiety or lost instructional time.
                    </h2>
                    <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
                        Historically, conducting a district-wide or regional diagnostic exam required halting classroom schedules, printing hundreds of thousands of test booklets, and subjecting students to high-stakes test stress. ColabEdu's <strong>Shadow Audits</strong> evaluate everyday work silently within your existing LMS.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
                    <div class="lg:col-span-6 space-y-4">
                        <div class="flex items-start gap-3.5 p-4 rounded-xl bg-slate-50 border border-slate-200">
                            <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-sm shrink-0">
                                <i class="fas fa-plug text-xs"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900">Seamless Connection to District LMS</h4>
                                <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
                                    Direct unattended ingestion via REST API or LTI 1.3 into platforms: <em>Canvas LMS, Google Classroom, Moodle, Schoology, or Blackboard</em>.
                                </p>
