---
// src/pages/en/safe-space.astro
// Safe Space: Confidential practice without social judgment or punitive grading
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Safe Space: Learning Without Fear of Failure | ColabEdu.net</title>
    <meta name="description" content="ColabEdu's private Safe Space: a confidential practice environment at home where making 50 mistakes in a row is part of true learning, free from peer judgment or punitive gradebooks.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-safespace {
            background: linear-gradient(135deg, rgba(254, 243, 199, 0.4) 0%, rgba(253, 230, 138, 0.25) 50%, rgba(240, 253, 250, 0.4) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
        }
    </style>
</head>
<body class="selection:bg-amber-600 selection:text-white">

    <Header lang="en" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-safespace p-8 sm:p-14 text-center mb-16">
                <span class="inline-block text-xs font-mono font-bold tracking-widest uppercase text-amber-900 bg-white/80 px-4 py-1.5 rounded-full border border-amber-300 mb-6">
                    <i class="fas fa-shield-heart mr-1.5 text-amber-600"></i> Confidential Learning Space
                </span>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Classrooms demand the right answer.<br/>
                    Safe Space gives permission to fail.
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto">
                    The biggest obstacle to deep learning isn't a lack of ability; it's the social fear of ridicule in front of peers or punitive marks in the gradebook. ColabEdu provides a protected sanctuary where trial and error is the proven path to mastery.
                </p>
            </div>

            <!-- Central Thesis: Classroom Anxiety -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                <div class="precision-card p-8 bg-white border-red-200">
                    <span class="text-xs font-mono font-bold text-red-600 uppercase tracking-wider block mb-2">Conventional Classroom Reality</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Paralysis from Peer Judgment</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        In a class of 30 students, raising your hand and being wrong carries an excruciating emotional toll: muffled giggles, judgmental glances, and the devastating stigma of feeling "slow."
                    </p>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        Consequently, insecure students or those carrying gaps from prior years stay quiet and nod along, accumulating silent frustration that eventually leads to academic disengagement.
                    </p>
                </div>

                <div class="precision-card p-8 bg-white border-emerald-200">
                    <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wider block mb-2">ColabEdu's Answer</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">The Confidential Home Lab</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        With ColabEdu, students practice on their tablet or phone at 11 PM in a 100% private environment. They can make 50 mistakes in a row without a single classmate watching.
                    </p>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                        The Socratic copilot never grows impatient, never judges, and never adopts a condescending tone: it unpacks the misconception with pedagogical empathy until the student experiences that breakthrough "aha!" moment.
                    </p>
                </div>
            </div>

            <!-- The 3 Pillars of Safe Space -->
            <div class="mb-16">
                <div class="text-center mb-10">
                    <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest block mb-1">Pedagogical Guarantees</span>
                    <h3 class="text-3xl font-black text-slate-900">How we protect student confidence & self-esteem</h3>
                </div>

                <div class="space-y-4">
                    <div class="precision-card p-6 bg-white flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-lg shrink-0">
                            <i class="fas fa-lock"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base mb-1">Formative Privacy: Rough drafts never pollute official transcripts</h4>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Failed attempts, naive questions, and spoken hesitations belong exclusively to the learner. Teachers don't receive surveillance of every misstep, but an aggregated mastery radar once the student chooses to submit their work.
                            </p>
                        </div>
                    </div>

                    <div class="precision-card p-6 bg-white flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-lg shrink-0">
                            <i class="fas fa-comments"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base mb-1">Non-Punitive Feedback (Zero "Wrong, Try Again")</h4>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Telling a student "Incorrect Answer" destroys motivation. ColabEdu prompts: *"I see you added the sides directly; look at the area of the squares on the triangle, what do you notice about the right corner?"*. Mistakes become an inquiry hint.
                            </p>
                        </div>
                    </div>

                    <div class="precision-card p-6 bg-white flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center font-bold text-lg shrink-0">
                            <i class="fas fa-stopwatch"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base mb-1">Self-Paced Learning & Infinite Time</h4>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                No aggressive countdown timers or forced peer comparisons. Students with ADHD, dyslexia, or processing challenges can spend 40 minutes exploring a concept or retry it tomorrow without pressure.
                            </p>
                        </div>
                    </div>

                    <div class="precision-card p-6 bg-white flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center font-bold text-lg shrink-0">
                            <i class="fas fa-dumbbell"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base mb-1">The Pre-Exam Gym: Prognosis Without Penalty</h4>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Practice authentic mock exams (Common Core, AP, IB, PAU/EBAU) as many times as needed. Discover what score you'd earn today based on official rubric standards, pinpoint recurrent missteps, and rectify them long before exam day.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Call to action -->
            <div class="p-8 sm:p-12 rounded-2xl bg-slate-900 text-white text-center">
                <h3 class="text-2xl sm:text-3xl font-black mb-3">Confidence is built by practicing without fear</h3>
                <p class="text-slate-300 text-sm max-w-xl mx-auto mb-6">
                    See how ColabEdu's interactive lessons restore students' enthusiasm for math, language, and sciences.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href={appUrl} target="_blank" class="px-6 py-3.5 text-sm font-extrabold text-slate-900 bg-amber-400 hover:bg-amber-300 rounded-xl transition-all">
                        Experience Safe Space in App &rarr;
                    </a>
                    <a href="/en/linguistic-inclusion" class="px-6 py-3.5 text-sm font-bold text-slate-300 hover:text-white border border-slate-700 rounded-xl transition-colors">
                        View Linguistic Inclusion
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Unified Footer -->
    <Footer lang="en" />

</body>
</html>
