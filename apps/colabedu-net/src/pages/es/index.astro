---
// src/pages/es/index.astro
// Portada canónica de ColabEdu.net: Diseño Híbrido "Nordic Precision & Warm Community"
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const lang = 'es';
const catalogUrl = appLink('app', '/navigator/spec_root/0');
const seoCatalogUrl = appLink('catalog', '/');
const appUrl = appLink('app', '/');
const supportUrl = appLink('support', '/');
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ColabEdu | Tecnología que devuelve el tiempo y la vocación a tus profesores</title>
    <meta name="description" content="Infraestructura abierta y socrática para el aula: pregrading de manuscritos, tutoría 24/7 y refuerzo de cohortes.">
    
    <!-- Google Fonts: Plus Jakarta Sans, Caveat (Real Handwriting OCR), and JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    
    <!-- KaTeX for pristine math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-handwriting: 'Caveat', cursive, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --color-canvas: #FAF9F6;
            --color-card: #FFFFFF;
            --color-border: #E2E8F0;
            --color-primary: #1D4ED8;
            --color-teal: #0F766E;
            --color-amber: #D97706;
            --color-dark: #0F172A;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--color-canvas);
            color: var(--color-dark);
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        .font-handwriting {
            font-family: var(--font-handwriting);
        }

        .font-mono-code {
            font-family: var(--font-mono);
        }

        /* Warm organic hero container */
        .hero-shell {
            background: linear-gradient(135deg, rgba(254, 243, 199, 0.5) 0%, rgba(240, 253, 250, 0.6) 50%, rgba(238, 242, 255, 0.4) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero-blob-amber {
            position: absolute;
            top: -15%;
            left: -10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, transparent 70%);
            filter: blur(40px);
            pointer-events: none;
        }

        .hero-blob-teal {
            position: absolute;
            bottom: -20%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(15, 118, 110, 0.16) 0%, transparent 70%);
            filter: blur(50px);
            pointer-events: none;
        }

        /* 1px Swiss Precision Card */
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03), 0 1px 2px -1px rgba(15, 23, 42, 0.02);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 12px 24px -6px rgba(15, 23, 42, 0.06), 0 8px 12px -4px rgba(15, 23, 42, 0.03);
            transform: translateY(-2px);
        }

        /* Ruled graph paper for handwriting OCR widget */
        .ruled-paper {
            background-color: #FFFDF9;
            background-image: 
                linear-gradient(to right, rgba(203, 213, 225, 0.25) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(203, 213, 225, 0.25) 1px, transparent 1px);
            background-size: 20px 20px;
            border: 1px solid #E2E8F0;
        }

        /* OCR Annotation Bounding Box */
        .ocr-highlight-box {
            position: relative;
            background: rgba(254, 240, 138, 0.45);
            border: 1.5px dashed #D97706;
            border-radius: 4px;
            padding: 1px 6px;
            display: inline-block;
        }

        .ocr-chip {
            position: absolute;
            top: -11px;
            right: -6px;
            background: #0F172A;
            color: #FEF08A;
            font-size: 9px;
            font-family: var(--font-mono);
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 4px;
            letter-spacing: 0.02em;
        }

        /* Pill tags */
        .tag-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.3rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.01em;
        }

        /* Distinct section backgrounds */
        .section-dark-slate {
            background-color: #0F172A; /* Slate 900 */
            color: #F8FAFC;
        }

        .section-dark-slate .precision-card {
            background-color: #1E293B;
            border-color: #334155;
            color: #F8FAFC;
        }

        .section-dark-slate .precision-card:hover {
            border-color: #475569;
        }

        /* Subtle ambient grid pattern */
        .ambient-grid {
            background-image: radial-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="selection:bg-blue-600 selection:text-white">

    <!-- Top Announcement Bar (Community & Season) -->
    <aside aria-label="Aviso de temporada" class="bg-slate-900 text-slate-300 text-xs py-2.5 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-2 text-center sm:text-left">
                <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span><strong>Campaña Primavera 2027:</strong> Simulacros oficiales de Selectividad EBAU/PAU, Exámenes AP e IB Spanish ya listos para asignar.</span>
            </div>
            <div class="flex items-center gap-4 text-slate-400 text-xs">
                <a href={catalogUrl} class="hover:text-amber-400 transition-colors flex items-center gap-1 font-semibold text-white">
                    <span>Explorar catálogo OER</span>
                    <i class="fas fa-arrow-right text-[10px]"></i>
                </a>
                <span class="text-slate-700">|</span>
                <span class="text-slate-400">Moneda: <strong class="text-amber-300">EUR (€)</strong></span>
            </div>
        </div>
    </aside>

    <!-- Header Navigation -->
    <Header lang={lang} />

    <!-- SECTION 1A: HERO MACRO INSTITUCIONAL & EL MAYOR CATÁLOGO OER INTERACTIVO -->
    <main class="pt-10 sm:pt-14 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="hero-shell p-8 sm:p-14 lg:p-16 text-center">
                <div class="hero-blob-amber"></div>
                <div class="hero-blob-teal"></div>

                <div class="relative z-10 max-w-4xl mx-auto">
                    <!-- Warm Organic Pill Badge -->
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/95 border border-amber-300/80 text-amber-950 text-xs font-bold shadow-xs mb-6">
                        <span class="flex h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>El mayor catálogo de Recursos Educativos Abiertos (OER) interactivos del mundo</span>
                    </div>

                    <!-- Main Punchy Title -->
                    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-slate-950 tracking-tight leading-[1.08] mb-6">
                        Tecnología que devuelve el tiempo y la vocación a tus <span class="text-blue-600">profesores</span>.<br/>
                        Inteligencia que impulsa a tus <span class="text-teal-600">alumnos</span>.
                    </h1>

                    <!-- Subtitle with the full technological factory scope -->
                    <p class="text-base sm:text-xl text-slate-700 font-normal leading-relaxed mb-8 max-w-3xl mx-auto">
                        Estamos construyendo el <strong>mayor catálogo interactivo de Recursos Educativos Abiertos (OER) asistido por IA</strong>, sindicando más de <strong>65 repositorios abiertos oficiales</strong> (como OpenStax, INTEF, SEP y bancos de pruebas oficiales) y enriqueciéndolos con andamiaje socrático y simulaciones activas. Una comunidad global que sostiene cómputo soberano, sin publicidad, sin venta de datos y 100% auditable.
                    </p>

                    <!-- Hero Strategic Action Buttons (Visión, Filosofía, Estándares L0 y Catálogo) -->
                    <div class="flex flex-wrap items-center justify-center gap-3.5 mb-8">
                        <button
                            type="button"
                            data-open-catalog-modal
                            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-sm shadow-md hover:shadow-lg transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5"
                        >
                            <i class="fas fa-layer-group text-base"></i>
                            <span>Explorar Catálogo OER</span>
                            <span class="text-xs bg-amber-950/20 text-slate-950 font-mono px-2 py-0.5 rounded-md font-bold">65+ Repositorios</span>
                        </button>

                        <a
                            href="/es/vision"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-compass text-blue-600 text-xs"></i>
                            <span>Nuestra Visión</span>
                        </a>

                        <a
                            href="/es/catalog-philosophy"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-book-open text-amber-600 text-xs"></i>
                            <span>Filosofía del Catálogo</span>
                        </a>

                        <a
                            href="/es/grounding"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-800 font-extrabold text-sm border border-slate-300 hover:border-slate-400 shadow-xs transition-all flex items-center gap-2"
                        >
                            <i class="fas fa-scale-balanced text-teal-600 text-xs"></i>
                            <span>Estándares & Grounding L0</span>
                        </a>

                        <a
                            href="/es/cross-competencies"
                            class="px-5 py-3.5 rounded-xl bg-white hover:bg-teal-50/60 text-slate-900 font-black text-sm border border-teal-300 hover:border-teal-500 shadow-xs transition-all flex items-center gap-2 group"
                        >
                            <i class="fas fa-network-wired text-teal-600 text-xs group-hover:scale-110 transition-transform"></i>
                            <span>Competencias Cruzadas & PISA</span>
                            <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-teal-100 text-teal-900">Zero Burocracia</span>
                        </a>
                    </div>

                    <!-- Discrete Secondary Navigation: Membresías y Especificación OPS -->
                    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-600 font-semibold pt-4 border-t border-slate-200/80">
                        <a href="/es/ops-specification" class="hover:text-blue-700 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-cube text-blue-600"></i>
                            <span>Especificación Pedagógica Abierta OPS v0.9.6</span>
                        </a>
                        <span class="text-slate-300 hidden sm:inline">·</span>
                        <a href="/es/cross-competencies#shadow-audits" class="hover:text-indigo-700 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-ghost text-indigo-600"></i>
                            <span>Auditorías Shadow para Distritos</span>
                        </a>
                        <span class="text-slate-300 hidden sm:inline">·</span>
                        <a href="/es/memberships" class="hover:text-teal-800 transition-colors flex items-center gap-1.5">
                            <i class="fas fa-hand-holding-heart text-teal-600"></i>
                            <span>Planes de Sostenimiento y Becas Solidarias</span>
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- SECTION 1B: MINI-SECCIÓN DE ACCESO RÁPIDO POR AUDIENCIA (Docentes vs. Refuerzo & Alumnos) -->
    <section class="pb-16 pt-2">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-xs">
                
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">
                        Rutas Directas de Aprendizaje & Gestión Docente
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">
                        ¿Cómo quieres utilizar ColabEdu hoy?
                    </h2>
                </div>

                <!-- Audience-First Direct Gateways (Docentes vs. Refuerzo & Academia) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-8 text-left">
                    <!-- Card 1: Docentes & SpeedGrader + OER de Domingo a Lunes -->
                    <a href="#calidad-vida-docente" class="precision-card p-6 bg-gradient-to-br from-blue-50/40 to-white border-blue-200 hover:border-blue-500 hover:shadow-xl transition-all flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </div>
                                <span class="tag-badge bg-blue-100 text-blue-900 border border-blue-200">
                                    Docentes & Centros
                                </span>
                            </div>
                            <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                                Recupera tus domingos: Materiales listos + SpeedGrader AI
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Accede a miles de lecciones y ejercicios interactivos OER alineados con estándares oficiales para asignar los domingos en 5 minutos para el lunes. Además, pre-califica exámenes manuscritos en Canvas, Moodle o Google Classroom ahorrando 15h semanales.
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600">
                            <span>Ver experiencia docente &rarr;</span>
                            <span class="text-[11px] text-slate-400 font-normal">Ahorro de preparación y corrección</span>
                        </div>
                    </a>

                    <!-- Card 2: Alumnos, Familias y Academia -->
                    <a href="#refuerzo-academia" class="precision-card p-6 bg-gradient-to-br from-teal-50/40 to-white border-teal-200 hover:border-teal-500 hover:shadow-xl transition-all flex flex-col justify-between group">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center font-bold text-xl shadow-md group-hover:scale-105 transition-transform">
                                    <i class="fas fa-graduation-cap"></i>
                                </div>
                                <span class="tag-badge bg-teal-100 text-teal-900 border border-teal-200">
                                    Alumnos & Familias
                                </span>
                            </div>
                            <h3 class="text-lg font-black text-slate-900 group-hover:text-teal-700 transition-colors mb-2">
                                Academia 24/7 y Refuerzo Socrático en Casa
                            </h3>
                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                                Un tutor socrático que guía paso a paso en Matemáticas, Física y Lengua sin dar la respuesta masticada. Práctica confidencial en un entorno seguro ("Safe Space") y apoyo lingüístico adaptado para estudiantes Newcomers.
                            </p>
                        </div>
                        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-teal-700">
                            <span>Explorar refuerzo y tutoría &rarr;</span>
                            <span class="text-[11px] text-slate-400 font-normal">Sin frustración ni juicio</span>
                        </div>
                    </a>
                </div>

                <!-- Live metric pills -->
                <div class="pt-6 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-bold text-slate-700 max-w-4xl mx-auto">
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-clock text-amber-600 text-base"></i>
                        <span><strong>15 horas semanales</strong> recuperadas por docente</span>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-bolt text-teal-600 text-base"></i>
                        <span><strong>SpeedGrader Canvas & Moodle</strong> en 1 clic</span>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200 flex items-center justify-center gap-2.5">
                        <i class="fas fa-scale-balanced text-blue-600 text-base"></i>
                        <span>Rúbricas oficiales <strong>LOMLOE · AP · IB · CCSS · TEKS · SEP</strong></span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 2: LA FACTORÍA DE TECNOLOGÍA EDUCATIVA ABIERTA (4 Pilares) -->
    <section class="py-20 sm:py-28 bg-white border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="max-w-3xl mx-auto text-center mb-16">
                <span class="tag-badge bg-blue-50 text-blue-700 border border-blue-200 uppercase tracking-wider text-xs mb-3">
                    <i class="fas fa-microchip mr-1.5 text-blue-600"></i> Arquitectura EdTech de Vanguardia
                </span>
                <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
                    Tecnología profunda para resolver los retos reales del aula
                </h2>
                <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
                    Convertir libros estáticos en software interactivo y corregir caligrafía humana requiere una combinación única de ingeniería curricular, visión artificial y supercómputo.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">

                <!-- PILAR 1: Lecciones Interactivas Vivas con Copiloto Socrático -->
                <div class="precision-card p-8 border-slate-200 bg-gradient-to-br from-white to-amber-50/20 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <span class="tag-badge bg-amber-100 text-amber-900 border border-amber-300">
                                <i class="fas fa-cubes mr-1.5 text-amber-600"></i> Lecciones Interactivas
                            </span>
                            <span class="text-xs font-mono font-bold text-slate-400">OPS v0.9.6 RUNTIME</span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
                            Lecciones Interactivas Vivas con Copiloto Socrático
                        </h3>
                        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                            No son PDFs estáticos. Cada unidad se compila en un entorno web interactivo con simulaciones PhET integradas, fórmulas KaTeX manipulables y ejercicios asistidos por un copiloto socrático que andamia el razonamiento en 9 pasos sin dar la solución hecha.
                        </p>

                        <!-- Math & Science Simulation Preview Box -->
                        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs mb-6">
                            <div class="flex justify-between items-center text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                                <span>Demostración Geométrica en Vivo</span>
                                <span class="text-amber-600 font-mono">MATH.SEC.PYTHAGORAS</span>
                            </div>
                            <div class="text-lg font-bold text-blue-900 py-1 font-mono-code text-center" id="pythagoras-display">
                                a² + b² = c² &nbsp;⟺&nbsp; c = √(a² + b²)
                            </div>
                            <div class="text-xs text-slate-500 mt-2 bg-slate-50 p-2.5 rounded-lg border border-slate-100 italic text-center">
                                "¿Por qué la suma de las áreas de los cuadrados de los catetos equivale exactamente al cuadrado de la hipotenusa?"
                            </div>
                        </div>
                    </div>

                    <div class="pt-5 border-t border-slate-100 flex items-center justify-between">
                        <a href={appUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-extrabold text-amber-800 hover:text-amber-950">
                            <span>Probar lección interactiva</span>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                        <span class="text-xs text-slate-400 font-medium">Experiencia Interactiva Web</span>
                    </div>
                </div>

                <!-- PILAR 2: Grading V2 y Copiloto Evaluativo Docente -->
                <div class="precision-card p-8 border-slate-200 bg-gradient-to-br from-white to-blue-50/20 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-6">
                            <span class="tag-badge bg-blue-100 text-blue-900 border border-blue-300">
                                <i class="fas fa-signature mr-1.5 text-blue-600"></i> Copiloto Evaluativo Docente
                            </span>
                            <span class="tag-badge bg-emerald-100 text-emerald-800 border border-emerald-300">
                                99.2% Caligrafía Real
                            </span>
                        </div>

                        <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
                            Corrección Asistida por IA en Exámenes Manuscritos y Orales
                        </h3>
                        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
                            Los alumnos siguen escribiendo a mano en papel o practicando expresión oral. Nuestro copiloto procesa escaneos multipágina desde el móvil y audios en tiempo real, coteja contra la rúbrica oficial (LOMLOE, AP, IB, Common Core, Texas TEKS y SEP/NEM México) y propone nota con borrador de feedback listo para que el docente valide y firme.
                        </p>

                        <!-- Realistic Exam Ruled Paper Preview -->
                        <div class="ruled-paper rounded-xl p-4 text-xs leading-relaxed mb-4 shadow-xs relative">
