---
// src/components/Header.astro
const { lang = 'es' } = Astro.props;
---
<nav class="fixed w-full z-50 border-b border-slate-200" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
            <div class="flex items-center">
                <a href={`/${lang}/`}><span class="text-2xl font-bold tracking-tighter text-slate-900">Colab<span style="color: #4F46E5;">Edu</span></span></a>
            </div>
            <div class="hidden md:flex space-x-4 lg:space-x-6 items-center">
                <a href={`/${lang}/`} class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Docentes</a>
                <a href={`/${lang}/student`} class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Estudiantes</a>
                <span class="text-slate-300">|</span>
                <a href={import.meta.env.PUBLIC_URL_SUPPORT} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-emerald-600 hover:text-emerald-800 transition-colors">Soporte/Ayuda</a>
            </div>
            
            <div class="hidden md:flex items-center space-x-4">
                <div class="flex items-center space-x-2 text-xs font-bold text-slate-400 bg-slate-100 rounded-full px-3 py-1">
                    <a href="#" onclick="setLang('en'); return false;" class={lang === 'en' ? 'text-primary' : 'hover:text-primary transition-colors'}>EN</a>
                    <span>|</span>
                    <a href="#" onclick="setLang('es'); return false;" class={lang === 'es' ? 'text-primary' : 'hover:text-primary transition-colors'}>ES</a>
                </div>

                <a href="#cta" class="text-sm font-semibold text-slate-600 hover:text-slate-900">Log in</a>
                <a href="https://colabedu-prod.web.app" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 text-sm font-semibold text-white bg-slate-900 rounded-full hover:bg-slate-800 transition-all shadow-lg transform hover:-translate-y-0.5">
                    Empezar Gratis
                </a>
            </div>
        </div>
    </div>
</nav>
