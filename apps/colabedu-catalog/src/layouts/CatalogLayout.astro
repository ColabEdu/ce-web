---
import '@/styles/global.css';
import LanguageSelector from '@/components/catalog/LanguageSelector.astro';
import GoogleAnalytics from '@/components/analytics/GoogleAnalytics.astro';
import { appLink } from '@colabedu/ui-core/navigation';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  minimal?: boolean;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = "https://colabedu.org/assets/cards/catalog-default.png",
  minimal = false,
} = Astro.props;

const isEmbed = minimal || Astro.url.searchParams.get('embed') === 'true' || Astro.url.searchParams.get('minimal') === 'true';

const orgHomeUrl = appLink('org', '/');
const appUrl = appLink('app', '/');
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#030712] text-slate-100 antialiased selection:bg-cyan-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="ColabEdu Catalog" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />



    <script is:inline>
      (function() {
        try {
          const params = new URLSearchParams(window.location.search);
          if (params.get('embed') === 'true' || params.get('minimal') === 'true') {
            document.documentElement.classList.add('embed-mode');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Analytics 4 (K-12 Privacy Compliant & Cross-Subdomain) -->
    <GoogleAnalytics />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#030712] text-slate-100 relative overflow-x-hidden">
    <!-- Ambient Background Glow Effects -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[550px] bg-gradient-to-b from-cyan-500/12 via-blue-600/8 to-transparent blur-3xl opacity-75 rounded-full"></div>
      <div class="absolute top-[40rem] -left-48 w-[650px] h-[500px] bg-indigo-600/6 blur-3xl opacity-60 rounded-full"></div>
      <div class="absolute top-[80rem] -right-48 w-[600px] h-[500px] bg-cyan-600/5 blur-3xl opacity-50 rounded-full"></div>
    </div>

    <!-- Navigation Header -->
    {!isEmbed && (
      <header id="catalog-nav-header" class="catalog-nav-header sticky top-0 z-50 bg-[#030712]/80 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_24px_rgba(0,0,0,0.4)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
          <!-- Logo -->
          <a href="/catalog" class="flex items-center gap-3 group">
            <div class="relative w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-600 p-[1.5px] shadow-[0_0_20px_-3px_rgba(6,182,212,0.4)] group-hover:shadow-[0_0_25px_rgba(6,182,212,0.6)] transition-all">
              <div class="w-full h-full bg-[#030712] rounded-[10px] flex items-center justify-center">
                <span class="font-extrabold text-sm tracking-tighter bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">CE</span>
              </div>
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-2">
                <span class="font-bold text-base text-white tracking-tight group-hover:text-cyan-400 transition-colors">ColabEdu</span>
                <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/25">
                  Catalog
                </span>
              </div>
              <span class="text-[11px] text-slate-400 hidden sm:inline" data-i18n="nav.pedagogy_standard">Open Pedagogy Specification</span>
            </div>
          </a>

          <!-- Middle Quick Navigation Pills -->
          <nav class="hidden lg:flex items-center p-1 rounded-full bg-slate-900/60 border border-white/[0.08] backdrop-blur-md text-xs font-semibold text-slate-300">
            <a href="/catalog/es" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/[0.06] transition-all flex items-center gap-1.5">
              <span>🇪🇸</span> <span data-i18n="nav.spain">España (LOMLOE)</span>
            </a>
            <a href="/catalog/us" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/[0.06] transition-all flex items-center gap-1.5">
              <span>🇺🇸</span> <span data-i18n="nav.usa">EE. UU. (AP)</span>
            </a>
            <a href="/catalog/intl" class="px-3.5 py-1.5 rounded-full hover:text-white hover:bg-white/[0.06] transition-all flex items-center gap-1.5">
              <span>🌐</span> <span data-i18n="nav.intl">Internacional (IB)</span>
            </a>
          </nav>

          <!-- Right CTA & Links -->
          <div class="flex items-center gap-2.5 sm:gap-3.5">
            <!-- Language Selector for Navigation -->
            <LanguageSelector />

            <a
              href={orgHomeUrl}
              class="hidden md:inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-slate-200 transition-colors px-3 py-1.5 rounded-lg hover:bg-white/[0.04]"
            >
              <span>←</span> <span data-i18n="nav.colabedu">ColabEdu.org</span>
            </a>

            <a
              href={appUrl}
              target="_blank"
              class="relative inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 shadow-[0_0_20px_-3px_rgba(6,182,212,0.4)] hover:shadow-[0_0_25px_rgba(6,182,212,0.6)] hover:brightness-110 active:scale-[0.98] transition-all"
            >
              <span data-i18n="nav.open_app">Abrir App</span>
              <span class="ml-1.5 text-xs">↗</span>
            </a>
          </div>
        </div>
      </header>
    )}

    <!-- Main Content -->
    <main class={`flex-1 relative z-10 ${isEmbed ? 'p-2 sm:p-4' : ''}`}>
      <slot />
    </main>

    <!-- Footer -->
    {!isEmbed && (
      <footer class="bg-[#02050e] border-t border-white/[0.07] py-14 text-sm text-slate-500 relative z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-10 border-b border-white/[0.06]">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="font-extrabold text-white text-base">ColabEdu Catalog</span>
                <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">OPS v0.9.6</span>
              </div>
              <p class="text-xs text-slate-400 max-w-xl leading-relaxed" data-i18n="footer.oer_disclaimer">
                Los recursos educativos abiertos (OER) indexados en este catálogo se publican bajo sus respectivas licencias abiertas originales (Creative Commons CC BY, CC BY-SA, CC BY-NC-SA y Dominio Público) acreditando a sus autores y fuentes canónicas (Marea Verde, CEDEC/INTEF, OpenStax, LibreTexts, College Board, BOE).
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-6 text-xs text-slate-400 font-medium">
              <a href="https://colabedu.org" class="hover:text-cyan-400 transition-colors">Institucional</a>
              <a href="https://colabedu.org/docs" class="hover:text-cyan-400 transition-colors" data-i18n="footer.ops_docs">Documentación OPS</a>
              <a href="/catalog/terms" class="hover:text-cyan-400 transition-colors" data-i18n="footer.terms">Términos de Uso</a>
              <a href="/catalog/sitemap-catalog.xml" class="hover:text-cyan-400 transition-colors">Sitemap XML</a>
              <a href="https://github.com/colabedu" target="_blank" class="hover:text-cyan-400 transition-colors">GitHub</a>
            </div>
          </div>

          <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <p data-i18n="footer.copyright">© 2026 ColabEdu Inc. Contenidos curriculares bajo licencia libre CC BY-SA 4.0.</p>
            <div class="text-center sm:text-right">
              <span class="text-slate-400 font-medium">🌍 Cupertino | Madrid | Ciudad de México</span>
            </div>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
