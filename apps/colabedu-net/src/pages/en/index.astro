---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en">

    <!-- 1. Hero Section -->
    <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden hero-bg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-sm font-medium mb-8 fade-in-up">
                <span class="flex h-2 w-2 rounded-full bg-indigo-600 mr-2 animate-pulse"></span>
                New: Official support for LOMLOE and AP Rubrics
            </div>
            
            <h1 class="text-5xl lg:text-7xl font-extrabold tracking-tight text-dark mb-8 leading-tight fade-in-up delay-100">
                Reclaim your weekends. <br/>
                <span class="gradient-text">Let AI grade for you.</span>
            </h1>
            
            <p class="mt-4 max-w-2xl mx-auto text-xl text-slate-600 mb-10 fade-in-up delay-200">
                Teachers lose an average of 15 hours a week on administrative tasks. ColabEdu reduces that time to minutes. Grade audio, handwritten assignments, and essays with 99% official precision without leaving your LMS.
            </p>
            
            <div class="flex flex-col sm:flex-row justify-center gap-4 fade-in-up delay-300">
                <a href="#cta" class="px-8 py-4 text-lg font-bold text-white bg-primary rounded-full hover:bg-indigo-700 transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
                    Start saving time today (Free)
                </a>
                <a href="#stakeholders" class="px-8 py-4 text-lg font-semibold text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition-all shadow-md hover:shadow-lg">
                    View solutions for Institutions
                </a>
            </div>

            <!-- Dashboard Preview Mockup -->
            <div class="mt-20 relative max-w-5xl mx-auto fade-in-up delay-300">
                <div class="absolute -inset-1 bg-gradient-to-r from-primary to-pink-600 rounded-2xl blur opacity-20"></div>
                <div class="relative bg-dark rounded-xl shadow-2xl border border-slate-700 overflow-hidden">
                    <div class="flex items-center px-4 py-3 bg-slate-800 border-b border-slate-700">
                        <div class="flex space-x-2">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        </div>
                        <div class="ml-4 px-3 py-1 bg-slate-900 rounded-md text-xs text-slate-400 font-mono">colabedu.app/dashboard</div>
                    </div>
                    <!-- Simplified Dashboard UI Mockup inside -->
                    <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
                        <!-- Left Panel -->
                        <div class="bg-slate-800/50 p-4 rounded-lg col-span-1 border border-slate-700">
                            <div class="text-slate-400 text-xs uppercase font-bold mb-4">Pending</div>
                            <div class="space-y-3">
                                <div class="flex items-center p-2 bg-indigo-900/20 border border-indigo-500/30 rounded text-indigo-200 text-sm">
                                    <i class="fas fa-pen-nib mr-3"></i> History Essays (28)
                                </div>
                                <div class="flex items-center p-2 bg-slate-700/30 rounded text-slate-400 text-sm">
                                    <i class="fas fa-microphone mr-3"></i> Spanish Orals (15)
                                </div>
                            </div>
                        </div>
                        <!-- Main Panel -->
                        <div class="bg-slate-800/50 p-4 rounded-lg col-span-2 border border-slate-700 relative">
                            <div class="absolute top-4 right-4 bg-green-500/20 text-green-400 text-xs px-2 py-1 rounded border border-green-500/30">
                                <i class="fas fa-check-circle mr-1"></i> AI Graded
                            </div>
                            <h3 class="text-white font-semibold mb-2">Essay: The Industrial Revolution</h3>
                            <p class="text-slate-400 text-sm mb-4">Student: Ana Garcia</p>
                            <div class="space-y-3">
                                <div class="bg-slate-900 p-3 rounded border-l-4 border-yellow-500">
                                    <p class="text-slate-300 text-xs leading-relaxed">
                                        <span class="bg-yellow-500/20 text-yellow-200 px-1 rounded">...social impact was devestating...</span>
                                        <br/><br/>
                                        <span class="text-yellow-400 font-bold">Feedback IA:</span> Error ortográfico ("devastador"). Además, profundiza en las consecuencias específicas para la clase trabajadora urbana.
                                    </p>
                                </div>
                                <div class="flex justify-between items-center pt-2">
                                    <span class="text-slate-400 text-sm">Suggested score:</span>
                                    <span class="text-2xl font-bold text-white">8.5/10</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Section: Pain Points (The "Burnout") -->
    <section id="problem" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-dark">The invisible classroom crisis</h2>
                <p class="mt-4 text-lg text-slate-600">Why the best teachers are leaving the profession.</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-red-200 transition-colors">
                    <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600 mb-6 text-xl">
                        <i class="fas fa-battery-empty"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">Real Burnout</h3>
                    <p class="text-slate-600 leading-relaxed">
                        An additional 44 million teachers are needed by 2030. 6.5% leave the profession every year, mainly due to unsustainable administrative workloads.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-orange-200 transition-colors">
                    <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center text-orange-600 mb-6 text-xl">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">Paralyzing Bureaucracy</h3>
                    <p class="text-slate-600 leading-relaxed">
                        Designing complex rubrics and manually aligning assessments with LOMLOE, TEKS, or IB shouldn't be your Sunday afternoon job.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="p-8 rounded-2xl bg-slate-50 border border-slate-100 hover:border-blue-200 transition-colors">
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 mb-6 text-xl">
                        <i class="fas fa-robot"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">The AI Black Box</h3>
                    <p class="text-slate-600 leading-relaxed">
                        Students use AI to take shortcuts. Don't fight fraud with flawed detectors; use AI as your ally to measure real mastery.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Section: Stats (The Math of Savings) -->
    <section id="savings" class="py-20 bg-dark text-white relative overflow-hidden">
        <!-- Abstract Shapes -->
        <div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-primary rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>
        <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-96 h-96 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold">The Math of Time Saving</h2>
                <p class="mt-4 text-lg text-slate-400">Data based on real use in pilot classrooms.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <!-- Stat 1 -->
                <div class="p-8 rounded-2xl bg-slate-800/50 backdrop-blur border border-slate-700">
                    <div class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600 mb-2">-80%</div>
                    <div class="text-xl font-semibold text-white mb-2">Administrative Load</div>
                    <p class="text-sm text-slate-400">Drastic reduction in grading times for writing and orals.</p>
                </div>

                <!-- Stat 2 -->
                <div class="p-8 rounded-2xl bg-slate-800/50 backdrop-blur border border-slate-700">
                    <div class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-600 mb-2">17 min</div>
                    <div class="text-xl font-semibold text-white mb-2">Saved per Student</div>
                    <p class="text-sm text-slate-400">Time saved on pre-analysis of each essay or presentation.</p>
                </div>

                <!-- Stat 3 -->
                <div class="p-8 rounded-2xl bg-slate-800/50 backdrop-blur border border-slate-700">
                    <div class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2">1 Clic</div>
                    <div class="text-xl font-semibold text-white mb-2">Total Synchronization</div>
                    <p class="text-sm text-slate-400">Feedback and grades flow directly to Canvas, Moodle, or Classroom.</p>
                </div>
            </div>
            
            <!-- Visualization of time savings chart -->
            <div class="mt-16 flex flex-col items-center">
                <div class="bg-white/5 p-6 rounded-2xl border border-white/10 w-full max-w-2xl">
                    <h4 class="text-center text-sm font-semibold text-slate-300 mb-6">Weekly time spent on grading (Hours)</h4>
                    <div class="chart-container">
                        <canvas id="savingsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Section: Anti-Toil Features -->
    <section id="features" class="py-24 bg-light">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-dark">"Anti-Toil" Features</h2>
                <p class="mt-4 text-lg text-slate-600">Tools specifically designed to give you your time back.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="group bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100">
                    <div class="w-14 h-14 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 mb-6 text-2xl group-hover:scale-110 transition-transform">
                        <i class="fas fa-signature"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">From Handwriting to Grade</h3>
                    <p class="text-slate-600">
                        Our intelligent OCR reads your students' handwriting (even the toughest ones) and evaluates it against your rubric. No more deciphering paper at night.
                    </p>
                </div>

                <!-- Feature 2 -->
                <div class="group bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100">
                    <div class="w-14 h-14 bg-pink-50 rounded-xl flex items-center justify-center text-pink-600 mb-6 text-2xl group-hover:scale-110 transition-transform">
                        <i class="fas fa-microphone-alt"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">One-Shot Oral Assessment</h3>
                    <p class="text-slate-600">
                        No more endless recordings. The AI transcribes, measures fluency, and detects conceptual errors in a single pass. You just review and sign off.
                    </p>
                </div>

                <!-- Feature 3 -->
                <div class="group bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100">
                    <div class="w-14 h-14 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600 mb-6 text-2xl group-hover:scale-110 transition-transform">
                        <i class="fas fa-magic"></i>
                    </div>
                    <h3 class="text-xl font-bold text-dark mb-3">Rubric Generator</h3>
                    <p class="text-slate-600">
                        Upload your syllabus or teaching guide. The AI extracts criteria and drafts professional SBG descriptors. What used to take an afternoon now takes 30 seconds.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Section: Stakeholders (Bento Grid Style) -->
    <section id="stakeholders" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <span class="text-primary font-semibold tracking-wide uppercase text-sm">Educational Ecosystem</span>
                <h2 class="text-3xl font-bold text-dark mt-2">Custom Pathways</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-4 h-auto md:h-[600px]">
                
                <!-- Departments (Large) -->
                <div class="md:col-span-2 md:row-span-2 bg-gradient-to-br from-indigo-50 to-white p-8 rounded-3xl border border-indigo-100 flex flex-col justify-between hover:shadow-lg transition-shadow">
                    <div>
                        <div class="bg-indigo-600 text-white w-10 h-10 rounded-full flex items-center justify-center mb-4"><i class="fas fa-building"></i></div>
                        <h3 class="text-2xl font-bold text-dark mb-2">For Departments</h3>
                        <p class="text-slate-600">Standardization without meetings. Ensure the whole team grades with the same rigor using shared Master Recipes, eliminating grading discrepancies.</p>
                    </div>
                    <img src="https://via.placeholder.com/400x200?text=Analytics+Dashboard" alt="Department Dashboard" class="rounded-xl shadow-sm mt-6 border border-slate-100 opacity-80">
                </div>

                <!-- Governments (Wide) -->
                <div class="md:col-span-2 bg-slate-50 p-8 rounded-3xl border border-slate-100 hover:shadow-lg transition-shadow">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-dark mb-2">For Governments and Ministries</h3>
                            <p class="text-sm text-slate-600">Invisible LOMLOE/TEKS compliance. National-scale learning gap analytics without asking teachers for extra reports.</p>
                        </div>
                        <div class="bg-slate-200 text-slate-600 w-10 h-10 rounded-full flex items-center justify-center"><i class="fas fa-landmark"></i></div>
                    </div>
                </div>

                <!-- Publishers (Small) -->
                <div class="md:col-span-1 bg-pink-50 p-6 rounded-3xl border border-pink-100 hover:shadow-lg transition-shadow">
                    <div class="bg-pink-500 text-white w-8 h-8 rounded-full flex items-center justify-center mb-3"><i class="fas fa-book"></i></div>
                    <h3 class="text-lg font-bold text-dark mb-2">Publishers</h3>
                    <p class="text-xs text-slate-600">Revitalize your catalog. Turn static books into interactive Socratic Tutors.</p>
                </div>

                <!-- Students (Small) -->
                <div class="md:col-span-1 bg-emerald-50 p-6 rounded-3xl border border-emerald-100 hover:shadow-lg transition-shadow">
                    <div class="bg-emerald-500 text-white w-8 h-8 rounded-full flex items-center justify-center mb-3"><i class="fas fa-user-graduate"></i></div>
                    <h3 class="text-lg font-bold text-dark mb-2">Students</h3>
                    <p class="text-xs text-slate-600">Feedback in minutes. The 24/7 "Learning Gym" to fail and learn before the exam.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- 6. Integrations (Social Proof) -->
    <section class="py-12 bg-slate-50 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-8">Native integration with your tools</p>
            <div class="flex flex-wrap justify-center items-center gap-12 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
                <div class="flex items-center space-x-2 text-xl font-bold text-slate-600"><i class="fas fa-circle text-red-500"></i> <span>Canvas</span></div>
                <div class="flex items-center space-x-2 text-xl font-bold text-slate-600"><i class="fab fa-google text-blue-500"></i> <span>Classroom</span></div>
                <div class="flex items-center space-x-2 text-xl font-bold text-slate-600"><i class="fas fa-graduation-cap text-orange-500"></i> <span>Moodle</span></div>
                <div class="flex items-center space-x-2 text-xl font-bold text-slate-600"><i class="fas fa-globe text-blue-700"></i> <span>IB World</span></div>
            </div>
            <p class="mt-8 text-sm text-slate-500">Two-way sync: Grades, assignments, and announcements flow without copying a single piece of data.</p>
        </div>
    </section>

    <!-- 7. Methodology (Steps) -->
    <section id="methodology" class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-3xl font-bold text-dark">The 3-Phase Methodology</h2>
                <p class="mt-4 text-lg text-slate-600">Pedagogical security and academic integrity.</p>
            </div>

            <div class="relative">
                <!-- Vertical Line -->
                <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-slate-200 md:left-1/2 md:-ml-px"></div>

                <!-- Step 1 -->
                <div class="relative mb-12">
                    <div class="flex items-center mb-4 md:justify-end md:pr-12 md:mb-0">
                        <div class="absolute left-0 w-16 h-16 bg-white border-4 border-indigo-500 rounded-full flex items-center justify-center z-10 md:left-1/2 md:-ml-8">
                            <span class="text-xl font-bold text-indigo-600">1</span>
                        </div>
                        <div class="ml-20 md:ml-0 md:w-5/12 bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
                            <h3 class="text-lg font-bold text-indigo-600">The Gym (Practice)</h3>
                            <p class="text-slate-600 mt-2">Students train with a Socratic AI that guides, but doesn't solve. Zero grading effort for you, maximum learning for them.</p>
                        </div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="relative mb-12">
                    <div class="flex items-center mb-4 md:justify-start md:pl-12 md:mb-0 md:flex-row-reverse">
                        <div class="absolute left-0 w-16 h-16 bg-white border-4 border-purple-500 rounded-full flex items-center justify-center z-10 md:left-1/2 md:-ml-8">
                            <span class="text-xl font-bold text-purple-600">2</span>
                        </div>
                        <div class="ml-20 md:ml-0 md:w-5/12 bg-white p-6 rounded-xl border border-slate-100 shadow-sm text-right md:text-left">
                            <h3 class="text-lg font-bold text-purple-600">Game Day (Test)</h3>
                            <p class="text-slate-600 mt-2">Proctored and shielded assessment in the classroom. No AI assistance, ensuring total test integrity.</p>
                        </div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="relative">
                    <div class="flex items-center mb-4 md:justify-end md:pr-12 md:mb-0">
                        <div class="absolute left-0 w-16 h-16 bg-white border-4 border-emerald-500 rounded-full flex items-center justify-center z-10 md:left-1/2 md:-ml-8">
                            <span class="text-xl font-bold text-emerald-600">3</span>
                        </div>
                        <div class="ml-20 md:ml-0 md:w-5/12 bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
                            <h3 class="text-lg font-bold text-emerald-600">The Audition (Performance)</h3>
                            <p class="text-slate-600 mt-2">You review the multimodal pre-assessment generated by AI. Validate, add your personal touch, and sign off. Massive time savings.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 8. Final CTA -->
    <section id="cta" class="py-24 bg-primary relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center text-white">
            <h2 class="text-4xl font-extrabold mb-6">Go back to being a teacher. Stop being an administrator.</h2>
            <p class="text-xl text-indigo-100 mb-10">Join the teachers who have already reclaimed their weekends with ColabEdu.</p>
            <a href="#" class="inline-block px-10 py-5 text-xl font-bold text-primary bg-white rounded-full hover:bg-slate-100 transition-transform transform hover:-translate-y-1 shadow-2xl">
                Try ColabEdu Pro for Free
            </a>
            <p class="mt-6 text-sm text-indigo-200">No credit card required to start.</p>
        </div>
    </section>

    <!-- Interactive Scripts -->
    <script is:inline>
        // Chart.js Visualization for Savings
        const ctx = document.getElementById('savingsChart').getContext('2d');
        const savingsChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Before ColabEdu', 'With ColabEdu'],
                datasets: [{
                    label: 'Weekly Grading Hours',
                    data: [15, 3],
                    backgroundColor: [
                        'rgba(239, 68, 68, 0.2)', // Red for 'Before'
                        'rgba(16, 185, 129, 0.2)'  // Green for 'After'
                    ],
                    borderColor: [
                        'rgba(239, 68, 68, 1)',
                        'rgba(16, 185, 129, 1)'
                    ],
                    borderWidth: 2,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + ' Hours';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.1)'
                        },
                        ticks: {
                            color: '#94a3b8'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#e2e8f0',
                            font: {
                                size: 14,
                                weight: 'bold'
                            }
                        }
                    }
                },
                animation: {
                    duration: 2000,
                    easing: 'easeOutQuart'
                }
            }
        });
    </script>
</BaseLayout>