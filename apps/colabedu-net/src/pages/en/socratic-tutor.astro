---
// src/pages/en/socratic-tutor.astro
// Socratic Tutor: 9-Step Scaffolding vs. Commercial Lazy Generation
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Socratic Tutor: Guides, Never Solves For You | ColabEdu.net</title>
    <meta name="description" content="ColabEdu's Socratic Tutoring engine: 9-step pedagogical scaffolding designed to ignite student deduction, contrary to commercial chatbots offering answers to copy and paste.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-socratic {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.6) 0%, rgba(240, 253, 250, 0.5) 50%, rgba(254, 243, 199, 0.3) 100%);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 2rem;
        }
        .step-node {
            position: relative;
            padding-left: 2rem;
            border-left: 2px solid #E2E8F0;
        }
        .step-node:last-child {
            border-left-color: transparent;
        }
        .step-circle {
            position: absolute;
            left: -11px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #2563EB;
            color: white;
            font-size: 10px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body class="selection:bg-blue-600 selection:text-white">

    <Header lang="en" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-socratic p-8 sm:p-14 text-center mb-16">
                <span class="inline-block text-xs font-mono font-bold tracking-widest uppercase text-blue-900 bg-white/80 px-4 py-1.5 rounded-full border border-blue-300 mb-6">
                    <i class="fas fa-brain mr-1.5 text-blue-600"></i> Active Inquiry Pedagogy
                </span>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Make students think.<br/>
                    Never give away answers.
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto">
                    Commercial AI chatbots have fueled an epidemic of "lazy generation": students paste the prompt and get a completed essay or equation to copy without understanding. ColabEdu enforces the Socratic method: sequenced questioning that sparks true conceptual deduction.
                </p>
            </div>

            <!-- Comparative Thesis: Commercial Chatbots vs. Socratic Copilot -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                
                <div class="precision-card p-8 bg-red-50/50 border-red-200">
                    <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-xmark"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-red-700 uppercase tracking-wider block mb-1">Commercial Approach (ChatGPT / Generic Bots)</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Cognitive Atrophy & Direct Copy-Paste</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                        <strong>Student:</strong> <em>"How do I solve 3x + 5 = 20?"</em><br/>
                        <strong>Generic Bot:</strong> <em>"Subtract 5 from both sides to get 3x = 15. Then divide by 3. The solution is x = 5."</em>
                    </p>
                    <p class="text-xs text-red-700 font-medium bg-red-100/60 p-3 rounded-lg border border-red-200">
                        Consequence: The student writes down x = 5, hasn't internalized equation equivalence, and will fail the in-person proctored exam.
                    </p>
                </div>

                <div class="precision-card p-8 bg-emerald-50/50 border-emerald-200">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-check"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-emerald-700 uppercase tracking-wider block mb-1">ColabEdu Approach (Socratic Tutor)</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Guided Reasoning & Scaffolding</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                        <strong>Student:</strong> <em>"How do I solve 3x + 5 = 20?"</em><br/>
                        <strong>ColabEdu:</strong> <em>"Picture a balanced scale. On the left you have three mystery bags marked 'x' and 5 loose coins; on the right you have 20 coins. If you remove the 5 loose coins from the left side, what do you need to do to the right side to keep it balanced?"</em>
                    </p>
                    <p class="text-xs text-emerald-800 font-medium bg-emerald-100/60 p-3 rounded-lg border border-emerald-200">
                        Consequence: The student deduces the isolation rule, grasps the mathematical structure, and gains permanent problem-solving autonomy.
                    </p>
                </div>

            </div>

            <!-- Canonical 9-Step Scaffolding of OPS v0.9.6 -->
            <div class="precision-card p-8 sm:p-12 bg-white border-slate-300 mb-16 shadow-sm">
                <div class="max-w-3xl mx-auto mb-10 text-center">
                    <span class="text-xs font-mono font-bold text-blue-700 uppercase tracking-widest block mb-2">
                        Canonical OPS v0.9.6 Methodology
                    </span>
                    <h3 class="text-3xl font-black text-slate-900">
                        The 9-Slide Socratic Scaffolding Sequence
                    </h3>
                    <p class="text-slate-600 text-sm mt-3 leading-relaxed">
                        Every ColabEdu interactive lesson structures learning through a rigorous, non-linear pedagogical cadence:
                    </p>
                </div>

                <div class="max-w-2xl mx-auto space-y-6">
                    <div class="step-node">
                        <span class="step-circle">1</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Initial Provocation & Real-World Connection</h4>
                        <p class="text-xs text-slate-600 mt-1">Presents a tangible dilemma or counter-intuitive puzzle rooted in students' lives.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">2</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Manipulative PhET / GeoGebra Exploration</h4>
                        <p class="text-xs text-slate-600 mt-1">Students tweak variables in an interactive simulation before seeing a single formal formula.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">3</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Misconception Detection</h4>
                        <p class="text-xs text-slate-600 mt-1">A deliberate challenge question designed to uncover the most common cognitive fallacies.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">4</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Rigorous Formalization with KaTeX</h4>
                        <p class="text-xs text-slate-600 mt-1">Introduction of exact mathematical or scientific syntax once the underlying physical phenomenon is understood.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">5</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Guided Practice with Active Copilot</h4>
                        <p class="text-xs text-slate-600 mt-1">First active exercise where the Socratic tutor delivers step-by-step formative feedback.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">6</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Scaffold Fading</h4>
                        <p class="text-xs text-slate-600 mt-1">The copilot systematically dials down hints so the student assumes full cognitive control.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">7</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Transfer to an Unprecedented Context</h4>
                        <p class="text-xs text-slate-600 mt-1">Applying the mastered concept to an entirely different real-world challenge.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">8</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">Metacognition & Self-Evaluation</h4>
                        <p class="text-xs text-slate-600 mt-1">Students formulate and reflect in their own words on how they derived the solution.</p>
                    </div>

                    <div class="step-node">
                        <span class="step-circle">9</span>
                        <h4 class="font-extrabold text-slate-900 text-sm">L0 Competency Certification</h4>
                        <p class="text-xs text-slate-600 mt-1">Automated verification against statutory criteria (Common Core, LOMLOE, AP, IB, SEP/NEM).</p>
                    </div>
                </div>
            </div>

            <!-- Call to action -->
            <div class="p-8 sm:p-12 rounded-2xl bg-slate-900 text-white text-center">
                <h3 class="text-2xl sm:text-3xl font-black mb-3">True education never gives away answers</h3>
                <p class="text-slate-300 text-sm max-w-xl mx-auto mb-6">
                    Experience firsthand how the Socratic copilot guides students through our open learning units.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href={appUrl} target="_blank" class="px-6 py-3.5 text-sm font-extrabold text-slate-900 bg-amber-400 hover:bg-amber-300 rounded-xl transition-all">
                        Try Socratic Tutor in App &rarr;
                    </a>
                    <a href="/en/extension" class="px-6 py-3.5 text-sm font-bold text-slate-300 hover:text-white border border-slate-700 rounded-xl transition-colors">
                        View LMS Extension
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Unified Footer -->
    <Footer lang="en" />

</body>
</html>
