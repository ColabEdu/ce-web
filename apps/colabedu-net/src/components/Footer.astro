---
import { appLink } from "@colabedu/ui-core/navigation";

// src/components/Footer.astro
const { lang = 'es' } = Astro.props;
const orgUrl = appLink('org', '/');
const orgNewsUrl = appLink('org', `/${lang}/news`);
const supportUrl = appLink('support', '/');
const termsUrl = appLink('catalog', '/terms');

const termsLabel = lang === 'en' ? 'Terms of Use (Beta)' : 'Términos de Uso (Beta)';
const privacyLabel = lang === 'en' ? 'Privacy' : 'Privacidad';
const copyrightYear = new Date().getFullYear();
---
<footer class="bg-dark text-slate-400 py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="col-span-1 md:col-span-1">
                <span class="text-2xl font-bold text-white">Colab<span class="text-primary">Edu</span></span>
                <p class="mt-4 text-sm">Tu copiloto de inteligencia pedagógica.</p>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-4">Soluciones</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href={`/${lang}/`} class="hover:text-white">Para Docentes</a></li>
                    <li><a href={`/${lang}/student`} class="hover:text-white">Para Estudiantes</a></li>
                    <li><a href={`/${lang}/school`} class="hover:text-white">Para Colegios</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-4">Institucional</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href={`/${lang}/government`} class="hover:text-white">Para Gobiernos</a></li>
                    <li><a href={`/${lang}/editorial`} class="hover:text-white">Para Editoriales</a></li>
                    <li><a href={orgUrl} class="hover:text-white">OPS Standard</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-4">Recursos & Ayuda</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href={orgNewsUrl} class="hover:text-white">Blog & News</a></li>
                    <li><a href={supportUrl} class="hover:text-white">Soporte y Ayuda</a></li>
                    <li><a href={termsUrl} class="hover:text-white">{termsLabel}</a></li>
                    <li><a href={termsUrl} class="hover:text-white">{privacyLabel}</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-12 pt-8 border-t border-slate-800 text-center text-xs">
            &copy; {copyrightYear} ColabEdu Inc. Todos los derechos reservados.
        </div>
    </div>
</footer>
