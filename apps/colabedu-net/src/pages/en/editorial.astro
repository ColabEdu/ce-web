---
// src/pages/en/editorial.astro
// Publisher Solutions: Editorial IP Activation and Blind Referencing Model
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/navigator/spec_root/0');
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Educational Publishers: IP Activation Without Piracy | ColabEdu.net</title>
    <meta name="description" content="Protect and revitalize your publishing intellectual property. ColabEdu's Blind Referencing model transforms textbooks into interactive Socratic experiences that validate and drive adoption of your physical books.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-editorial {
            background: linear-gradient(135deg, rgba(254, 243, 199, 0.5) 0%, rgba(253, 230, 138, 0.3) 50%, rgba(254, 249, 195, 0.6) 100%);
            border: 1px solid rgba(245, 158, 11, 0.2);
            border-radius: 2rem;
        }
    </style>
</head>
<body class="selection:bg-amber-600 selection:text-white">

    <Header lang="en" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-editorial p-8 sm:p-14 text-center mb-16">
                <span class="inline-block text-xs font-mono font-bold tracking-widest uppercase text-amber-900 bg-white/80 px-4 py-1.5 rounded-full border border-amber-300 mb-6">
                    <i class="fas fa-book-bookmark mr-1.5 text-amber-600"></i> Solutions for Publishers & Authors
                </span>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Revitalize your textbook IP.<br/>
                    <span class="text-amber-700">Without cannibalizing your books.</span>
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto mb-8">
                    Conventional generative AI risks pirating the structured knowledge of educational publishers. At ColabEdu, we engineered the <strong>Blind Referencing</strong> model: transforming your catalog into a Socratic copilot that prompts students to consult their official physical or digital book.
                </p>
                
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="#referencialidad-ciega" class="px-6 py-3.5 rounded-xl bg-amber-600 text-white font-bold text-sm shadow-md hover:bg-amber-700 transition flex items-center gap-2">
                        <i class="fas fa-shield-halved text-xs"></i>
                        <span>Explore Blind Referencing</span>
                    </a>
                    <a href="mailto:publishers@colabedu.net?subject=Publisher%20Alliance%20ColabEdu" class="px-6 py-3.5 rounded-xl bg-white text-slate-800 font-bold text-sm border border-slate-300 hover:bg-slate-50 transition flex items-center gap-2">
                        <i class="fas fa-handshake text-amber-600"></i>
                        <span>Talk with Academic Partnerships</span>
                    </a>
                </div>
            </div>

            <!-- The Publishing Dilemma: Dead PDFs vs Pirated Chatbots -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                <div class="precision-card p-8 bg-white border-red-200">
                    <span class="text-xs font-mono font-bold text-red-600 uppercase tracking-wider block mb-2">The Current Industry Threat</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">Devalued PDFs and Illicit Scraping</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        Static PDFs and web pages get uploaded directly to generic chatbots. Students receive regurgitated answers without ever opening the adopted textbook, destroying classroom engagement and eroding institutional book renewals.
                    </p>
                    <p class="text-xs sm:text-sm text-slate-500 leading-relaxed font-mono">
                        Consequence: Shrinking adoption cycles and declining revenues from core IP.
                    </p>
                </div>

                <div class="precision-card p-8 bg-white border-amber-300 shadow-sm">
                    <span class="text-xs font-mono font-bold text-amber-700 uppercase tracking-wider block mb-2">The ColabEdu Solution</span>
                    <h3 class="text-xl font-black text-slate-900 mb-3">A Socratic Intelligence Layer Over Your IP</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                        ColabEdu processes your manuals via our autonomous <strong>Curator</strong> agent. Instead of copying the book, the engine extracts the learning graph and rubric criteria, converting passive content into guided 9-step A2UI interactive dialogues.
                    </p>
                    <p class="text-xs sm:text-sm text-amber-800 leading-relaxed font-mono">
                        Outcome: The textbook becomes essential on every student's desk to solve the challenges.
                    </p>
                </div>
            </div>

            <!-- HOW BLIND REFERENCING WORKS -->
            <div id="referencialidad-ciega" class="precision-card p-8 sm:p-12 mb-16 border-amber-200 bg-amber-50/20 scroll-mt-24">
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-mono font-bold text-amber-700 uppercase tracking-widest block mb-2">
                        Intellectual Property Protection Doctrine
                    </span>
                    <h2 class="text-3xl font-black text-slate-950 tracking-tight">
                        How Does "Blind Referencing" Work?
                    </h2>
                    <p class="text-sm text-slate-600 mt-2">
                        The AI acts as an authoritative facilitator pointing directly into the physical textbook, never dumping full copyright passages on screen.
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-8">
                    <!-- Example Socratic Dialogue -->
                    <div class="lg:col-span-7 bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-lg font-mono text-xs">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-800 text-slate-400 text-[11px] mb-4">
                            <span><i class="fas fa-shield text-amber-400 mr-1.5"></i>Protected Socratic Session</span>
                            <span class="text-emerald-400">Adopted Textbook: AP Biology</span>
                        </div>
                        <div class="space-y-4">
                            <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
                                <span class="text-amber-400 font-bold block mb-1">ColabEdu Copilot:</span>
                                <p class="text-slate-200 leading-relaxed">
                                    "Open your textbook to <strong>page 142</strong> and examine the diagram of the mitochondrial electron transport chain. What is the terminal electron acceptor in Complex IV?"
                                </p>
                            </div>
                            <div class="p-3 bg-blue-950/60 rounded-xl border border-blue-800/60">
                                <span class="text-blue-300 font-bold block mb-1">Student Answer:</span>
                                <p class="text-slate-300">
                                    "Oxygen, which forms water when protons are added."
                                </p>
                            </div>
                            <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
                                <span class="text-amber-400 font-bold block mb-1">ColabEdu Copilot:</span>
                                <p class="text-slate-200 leading-relaxed">
                                    "Correct. Now look at the highlighted box on <strong>page 143</strong> regarding uncoupling proteins: why do newborns generate heat using brown adipose tissue?"
                                </p>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
                            <span><i class="fas fa-check text-emerald-400 mr-1"></i>Zero full-text leaks on screen</span>
                            <span class="text-amber-400 font-bold">100% Book Consultation Loop</span>
                        </div>
                    </div>

                    <!-- 3 Publisher Benefits -->
                    <div class="lg:col-span-5 space-y-4">
                        <div class="precision-card p-5 bg-white border-slate-200">
                            <div class="font-bold text-slate-900 text-sm mb-1 flex items-center gap-2">
                                <i class="fas fa-cart-shopping text-amber-600"></i>
                                <span>Validates Textbook Purchases</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Students must own the physical textbook or active license. Without the book, they cannot complete the interactive journey.
                            </p>
                        </div>

                        <div class="precision-card p-5 bg-white border-slate-200">
                            <div class="font-bold text-slate-900 text-sm mb-1 flex items-center gap-2">
                                <i class="fas fa-chart-line text-blue-600"></i>
                                <span>+60% Student Engagement</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Replaces passive reading (where 80% is lost within a week) with an active retrieval and inquiry loop.
                            </p>
                        </div>

                        <div class="precision-card p-5 bg-white border-slate-200">
                            <div class="font-bold text-slate-900 text-sm mb-1 flex items-center gap-2">
                                <i class="fas fa-bolt text-teal-600"></i>
                                <span>Time-to-Market in Weeks</span>
                            </div>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Your editorial team retains complete human-in-the-loop oversight without building complex software from scratch.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CURATOR PIPELINE -->
            <div class="precision-card p-8 sm:p-12 mb-16 bg-white border-slate-200">
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest block mb-2">
                        Ingestion & Digitization Engine
                    </span>
                    <h2 class="text-3xl font-black text-slate-900 tracking-tight">
                        The Curriculum Digitization Factory
                    </h2>
                    <p class="text-sm text-slate-600 mt-2">
                        From static print files to interactive pedagogical knowledge graphs in 3 automated stages:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
                                <i class="fas fa-layer-group"></i>
                            </div>
                            <span class="text-[11px] font-mono font-bold text-amber-700 uppercase block mb-1">Stage 1</span>
                            <h4 class="font-black text-slate-900 text-base mb-2">RAG Atomization</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                The <strong>Curator</strong> agent parses the textbook into atomic logical blocks: reading excerpts, key formulas, diagrams, and rubric anchors.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-200 text-[11px] font-mono text-slate-500">
                            Knowledge graphs with zero hallucinations
                        </div>
                    </div>

                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg mb-4">
                                <i class="fas fa-wand-magic-sparkles"></i>
                            </div>
                            <span class="text-[11px] font-mono font-bold text-blue-700 uppercase block mb-1">Stage 2</span>
                            <h4 class="font-black text-slate-900 text-base mb-2">A2UI Instructional Mutation</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Content evolves into interactive exercises, reasoned problem sets, simulations, and oral discussions referencing the textbook.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-200 text-[11px] font-mono text-slate-500">
                            Native Flutter A2UI widgets
                        </div>
                    </div>

                    <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-lg mb-4">
                                <i class="fas fa-tags"></i>
                            </div>
                            <span class="text-[11px] font-mono font-bold text-teal-700 uppercase block mb-1">Stage 3</span>
                            <h4 class="font-black text-slate-900 text-base mb-2">L0 Standards Alignment</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Automatic mapping to official state and national standards: <strong>AP / College Board, Common Core, TEKS (Texas), LOMLOE (Spain), or SEP NEM (Mexico)</strong>.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-200 text-[11px] font-mono text-slate-500">
                            Audited normative certification
                        </div>
                    </div>
                </div>
            </div>

            <!-- PARTNERSHIP MODELS -->
            <div class="precision-card section-tint-amber p-8 sm:p-12 mb-16 border-amber-200">
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-mono font-bold text-amber-800 uppercase tracking-widest block mb-2">
                        Business Alliances
                    </span>
                    <h2 class="text-3xl font-black text-slate-950 tracking-tight">
                        Partnership & Co-Distribution Models
                    </h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="p-6 rounded-2xl bg-white border border-slate-200">
                        <span class="text-xs font-mono font-bold text-amber-700 uppercase block mb-1">Model 1</span>
                        <h4 class="font-black text-slate-900 text-base mb-2">Book + AI License Bundle</h4>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Distribute textbooks packaged with an activation code for ColabEdu's Socratic suite. Higher ASP and clear technological differentiation for school adoptions.
                        </p>
                        <span class="text-[11px] font-mono text-slate-500">Increased margin per adopted book.</span>
                    </div>

                    <div class="p-6 rounded-2xl bg-white border border-slate-200">
                        <span class="text-xs font-mono font-bold text-blue-700 uppercase block mb-1">Model 2</span>
                        <h4 class="font-black text-slate-900 text-base mb-2">LMS Integration (LTI 1.3)</h4>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Embed ColabEdu natively into your existing digital learning platform or portal via LTI 1.3 Advantage for Canvas, Moodle, and Google Classroom.
                        </p>
                        <span class="text-[11px] font-mono text-slate-500">Zero deployment friction for school IT.</span>
                    </div>

                    <div class="p-6 rounded-2xl bg-white border border-slate-200">
                        <span class="text-xs font-mono font-bold text-teal-700 uppercase block mb-1">Model 3</span>
                        <h4 class="font-black text-slate-900 text-base mb-2">White-Label Copilot</h4>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">
                            Deploy a branded Socratic tutor powered by ColabEdu's sovereign supercomputing, multimodal grading, and pedagogical safety rails.
                        </p>
                        <span class="text-[11px] font-mono text-slate-500">Your brand, our pedagogical engine.</span>
                    </div>
                </div>
            </div>

            <!-- FINAL CTA -->
            <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
                <div class="max-w-xl">
                    <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block mb-2">
                        Strategic Alliances
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">
                        Schedule a Pilot with Your Textbooks
                    </h3>
                    <p class="text-sm text-slate-300 leading-relaxed">
                        Send us a sample chapter. Within 5 business days, we will deliver an interactive demonstration of your content powered by the Blind Referencing engine.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
                    <a href="mailto:publishers@colabedu.net?subject=Pilot%20Demonstrator%20Publishing%20IP" class="px-6 py-3.5 rounded-xl bg-amber-400 text-slate-950 font-extrabold text-sm text-center shadow-md hover:bg-amber-300 transition">
                        Request Pilot Demo &rarr;
                    </a>
                    <a href="/en/catalogs" class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-bold text-sm text-center hover:bg-white/20 transition border border-white/20">
                        Explore OER Catalogs
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Unified Footer -->
    <Footer lang="en" />

</body>
</html>
