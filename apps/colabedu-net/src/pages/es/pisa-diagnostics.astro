---
// src/pages/es/pisa-diagnostics.astro
// Diagnóstico Regional & Pruebas PISA Asistidas por IA
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { appLink } from "@colabedu/ui-core/navigation";
import "../../styles/global.css";

const appUrl = appLink('app', '/navigator/spec_root/0');
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnósticos Regionales y PISA Asistidos por IA | ColabEdu.net</title>
    <meta name="description" content="Evaluación diagnóstica masiva y pruebas censales PISA para consejerías y distritos escolares. Calificación forense multimodal de miles de exámenes en días con -45% de varianza inter-docente.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

    <style is:global>
        :root {
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        body {
            font-family: var(--font-sans);
            background-color: #FAF9F6;
            color: #0F172A;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .precision-card {
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease-in-out;
        }
        .precision-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 20px -4px rgba(15, 23, 42, 0.05);
        }
        .hero-pisa {
            background: linear-gradient(135deg, rgba(238, 242, 255, 0.6) 0%, rgba(224, 231, 255, 0.4) 50%, rgba(245, 243, 255, 0.6) 100%);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 2rem;
        }
    </style>
</head>
<body class="selection:bg-indigo-600 selection:text-white">

    <Header lang="es" />

    <main class="py-12 sm:py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Hero Title -->
            <div class="hero-pisa p-8 sm:p-14 text-center mb-16">
                <span class="inline-block text-xs font-mono font-bold tracking-widest uppercase text-indigo-900 bg-white/80 px-4 py-1.5 rounded-full border border-indigo-300 mb-6">
                    <i class="fas fa-chart-line mr-1.5 text-indigo-600"></i> Macro-Evaluación Institucional B2G
                </span>
                <h1 class="text-4xl sm:text-6xl font-black text-slate-950 tracking-tight leading-tight mb-6">
                    Diagnósticos Regionales & PISA.<br/>
                    <span class="text-indigo-600">Resultados en días, no en meses.</span>
                </h1>
                <p class="text-lg sm:text-xl text-slate-700 font-normal leading-relaxed max-w-3xl mx-auto mb-8">
                    Las evaluaciones censales de 4º de Primaria, 2º de ESO o pruebas diagnósticas PISA desbordan los recursos de consejerías y distritos. ColabEdu proporciona un motor de corrección forense asistido por IA que califica decenas de miles de exámenes manuscritos y razonados bajo una vara de medir idéntica y sin sesgo territorial.
                </p>
                
                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="#macro-arquitectura" class="px-6 py-3.5 rounded-xl bg-indigo-600 text-white font-bold text-sm shadow-md hover:bg-indigo-700 transition flex items-center gap-2">
                        <i class="fas fa-network-wired text-xs"></i>
                        <span>Ver Arquitectura de Macro-Evaluación</span>
                    </a>
                    <a href="mailto:instituciones@colabedu.net?subject=Piloto%20Diagnostico%20Regional%20PISA" class="px-6 py-3.5 rounded-xl bg-white text-slate-800 font-bold text-sm border border-slate-300 hover:bg-slate-50 transition flex items-center gap-2">
                        <i class="fas fa-building-columns text-indigo-600"></i>
                        <span>Contactar Unidad de Diagnóstico</span>
                    </a>
                </div>
            </div>

            <!-- Los 3 Grandes Retos de las Evaluaciones de Sistema -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
                <div class="precision-card p-6 bg-white">
                    <div class="w-10 h-10 rounded-xl bg-red-100 text-red-700 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-clock-rotate-left"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-red-700 uppercase tracking-wider block mb-1">El Cuello de Botella</span>
                    <h3 class="text-base font-black text-slate-900 mb-2">3 a 6 Meses de Espera</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Los informes diagnósticos tradicionales se publican cuando los estudiantes ya han cambiado de curso escolar. Se pierde la oportunidad de intervenir a tiempo sobre las brechas de aprendizaje.
                    </p>
                </div>

                <div class="precision-card p-6 bg-white">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-scale-unbalanced"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-amber-700 uppercase tracking-wider block mb-1">Varianza Evaluativa</span>
                    <h3 class="text-base font-black text-slate-900 mb-2">Discrepancias Inter-Docente</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        Centenares de correctores humanos aplican rúbricas de forma heterogénea según cansancio o sesgo del centro. El mismo examen obtiene calificaciones dispares según quién corrija.
                    </p>
                </div>

                <div class="precision-card p-6 bg-white">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg mb-4">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <span class="text-xs font-mono font-bold text-purple-700 uppercase tracking-wider block mb-1">Coste Presupuestario</span>
                    <h3 class="text-base font-black text-slate-900 mb-2">Tribunales Saturados</h3>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        La logística de custodia física, tribunales correctores y dietas genera partidas presupuestarias millonarias para muestreos que a menudo no cubren al 100% de la cohorte.
                    </p>
                </div>
            </div>

            <!-- ARQUITECTURA DE EVALUACIÓN MASIVA -->
            <div id="macro-arquitectura" class="precision-card p-8 sm:p-12 mb-16 border-indigo-200 bg-indigo-50/20 scroll-mt-24">
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-mono font-bold text-indigo-700 uppercase tracking-widest block mb-2">
                        Metodología Operativa
                    </span>
                    <h2 class="text-3xl font-black text-slate-950 tracking-tight">
                        Flujo de Calificación Forense Multimodal
                    </h2>
                    <p class="text-sm text-slate-600 mt-2">
                        Combinamos OCR especializado en caligrafía infantil y juvenil con el motor determinista Grading V2:
                    </p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-8">
                    <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col justify-between">
                        <div>
                            <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1">01. Aplicación</span>
                            <h4 class="font-bold text-slate-900 text-sm mb-2">Folio en Papel o Tablet</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Los centros aplican las pruebas en sus propios cuadernillos de papel oficiales o en dispositivos Chromebook/tablets de aula.
                            </p>
                        </div>
                        <div class="mt-4 pt-2 border-t border-slate-100 text-[11px] text-slate-400 font-mono">
                            Cero cambios curriculares
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col justify-between">
                        <div>
                            <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1">02. Ingesta</span>
                            <h4 class="font-bold text-slate-900 text-sm mb-2">Escaneo Masivo & OCR</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Escáneres de alta velocidad o la app móvil de aula digitalizan los lotes. Nuestro OCR segmenta cada ítem y aísla desarrollos matemáticos y redacciones.
                            </p>
                        </div>
                        <div class="mt-4 pt-2 border-t border-slate-100 text-[11px] text-slate-400 font-mono">
                            99% precisión en manuscrito
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col justify-between">
                        <div>
                            <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1">03. Grading</span>
                            <h4 class="font-bold text-slate-900 text-sm mb-2">Grading V2 Oficial</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Evaluación contra la Receta C1 canónica (PISA Framework o LOMLOE). Desglose por dimensiones: Comprensión Lectora, STEM, e Indagación Científica.
                            </p>
                        </div>
                        <div class="mt-4 pt-2 border-t border-slate-100 text-[11px] text-slate-400 font-mono">
                            -45% varianza evaluativa
                        </div>
                    </div>

                    <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex flex-col justify-between">
                        <div>
                            <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1">04. Acción</span>
                            <h4 class="font-bold text-slate-900 text-sm mb-2">Rutas de Remediation</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                El sistema genera automáticamente el radar de brechas por distrito y propone planes interactivos de refuerzo para cada estudiante rezagado.
                            </p>
                        </div>
                        <div class="mt-4 pt-2 border-t border-slate-100 text-[11px] text-slate-400 font-mono">
                            Intervención en caliente
                        </div>
                    </div>
                </div>

                <!-- Garantía de Anonimización y Soberanía RGPD -->
                <div class="p-4 rounded-xl bg-white border border-indigo-200 flex items-center justify-between text-xs text-indigo-950">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-lock text-indigo-600 text-lg"></i>
                        <span><strong>Privacidad Soberana & Pseudonimización:</strong> Los exámenes se procesan con IDs hash anónimos. Ningún dato identificativo de menores de edad sale de servidores bajo jurisdicción estricta de la UE.</span>
                    </div>
                </div>
            </div>

            <!-- COMPARATIVA: DIAGNÓSTICO MANUAL VS COLABEDU -->
            <div class="precision-card p-8 sm:p-12 mb-16 bg-white border-slate-200">
                <div class="text-center max-w-2xl mx-auto mb-10">
                    <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-widest block mb-2">
                        Impacto Operativo
                    </span>
                    <h2 class="text-3xl font-black text-slate-900 tracking-tight">
                        Transformación de las Pruebas Censales
                    </h2>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse precision-card overflow-hidden">
                        <thead>
                            <tr class="bg-slate-100/80 border-b border-slate-200 text-xs font-mono text-slate-700 uppercase tracking-wider">
                                <th class="p-4">Parámetro de Evaluación</th>
                                <th class="p-4 text-red-700">Modelo Administrativo Tradicional</th>
                                <th class="p-4 text-indigo-700">Modelo Asistido ColabEdu</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 text-xs text-slate-600">
                            <tr>
                                <td class="p-4 font-bold text-slate-900">Tiempo de corrección (cohorte 50.000 alumnos)</td>
                                <td class="p-4 text-red-600">12 a 16 semanas</td>
                                <td class="p-4 text-indigo-700 font-bold">72 a 96 horas</td>
                            </tr>
                            <tr>
                                <td class="p-4 font-bold text-slate-900">Consistencia y Homogeneidad</td>
                                <td class="p-4">Varianza de hasta &plusmn;1.8 puntos entre tribunales</td>
                                <td class="p-4 text-indigo-700 font-bold">Varianza &lt; &plusmn;0.1 (idéntica vara de medir)</td>
                            </tr>
                            <tr>
                                <td class="p-4 font-bold text-slate-900">Impacto en el Alumno</td>
                                <td class="p-4">Cero feedback (estadística puramente archivística)</td>
                                <td class="p-4 text-indigo-700 font-bold">Ruta socrática personalizada para recuperar vacíos</td>
                            </tr>
                            <tr>
                                <td class="p-4 font-bold text-slate-900">Coste por Examen Evaluado</td>
                                <td class="p-4">Logística y dietas de tribunales externos</td>
                                <td class="p-4 text-indigo-700 font-bold">Reducción del 75% en coste operativo global</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CTA FINAL HACIA CONSEJERÍAS Y DISTRITOS -->
            <div class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
                <div class="max-w-xl">
                    <span class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-widest block mb-2">
                        Administraciones Públicas & Distritos
                    </span>
                    <h3 class="text-2xl sm:text-3xl font-black tracking-tight mb-3">
                        Planifique su Próxima Evaluación Censal con Nosotros
                    </h3>
                    <p class="text-sm text-slate-300 leading-relaxed">
                        Presentamos pliegos técnicos, convenios de colaboración administrativa y pilotos express de validación para consejerías y redes escolares.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
                    <a href="mailto:instituciones@colabedu.net?subject=Convocatoria%20Diagnostico%20Regional%20PISA" class="px-6 py-3.5 rounded-xl bg-indigo-500 text-white font-extrabold text-sm text-center shadow-md hover:bg-indigo-400 transition">
                        Solicitar Dossier Técnico &rarr;
                    </a>
                    <a href="/es/institutions" class="px-6 py-3.5 rounded-xl bg-white/10 text-white font-bold text-sm text-center hover:bg-white/20 transition border border-white/20">
                        Convenios de Centro
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- Unified Footer -->
    <Footer lang="es" />

</body>
</html>
