---
interface Props {
  objectives: string[];
}

const { objectives } = Astro.props;
---

{objectives && objectives.length > 0 && (
  <section class="my-10">
    <div class="flex items-center gap-2.5 mb-5">
      <div class="w-8 h-8 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-sm border border-cyan-500/25">
        🎯
      </div>
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">
          Objetivos de Dominio Curricular
        </h2>
        <p class="text-xs text-slate-400">
          Criterios pedagógicos evaluados en esta sesión
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {objectives.map((obj, idx) => (
        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.07] hover:bg-white/[0.04] hover:border-cyan-500/30 transition-all shadow-sm group">
          <div class="w-6 h-6 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform">
            ✓
          </div>
          <p class="text-sm text-slate-300 leading-snug font-medium group-hover:text-slate-100 transition-colors">
            {obj}
          </p>
        </div>
      ))}
    </div>
  </section>
)}
