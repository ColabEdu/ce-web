---
interface Breadcrumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  standard?: string;
  level?: string;
  subject?: string;
  language?: string;
  estimatedMinutes?: number;
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  subtitle,
  standard,
  level,
  subject,
  language,
  estimatedMinutes,
  breadcrumbs = [],
} = Astro.props;
---

<header class="relative pt-12 pb-14 px-4 sm:px-6 lg:px-8 border-b border-white/[0.08] overflow-hidden">
  <!-- Subtle Gradient Background Spot -->
  <div class="absolute inset-0 bg-gradient-to-b from-cyan-950/20 via-slate-950/40 to-transparent pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -top-32 left-1/3 w-[500px] h-[300px] bg-cyan-500/10 blur-3xl pointer-events-none rounded-full" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Breadcrumbs Pill Navigation -->
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="inline-flex flex-wrap items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] text-xs font-medium text-slate-400 backdrop-blur-md">
          {breadcrumbs.map((crumb, idx) => (
            <li class="flex items-center gap-1.5">
              {idx > 0 && <span class="text-slate-600 text-[10px]">/</span>}
              {idx === breadcrumbs.length - 1 ? (
                <span class="text-cyan-300 font-semibold truncate max-w-[200px] sm:max-w-xs">{crumb.label}</span>
              ) : (
                <a href={crumb.href} class="hover:text-slate-200 transition-colors">
                  {crumb.label}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Pill Badges -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      {standard && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/25 shadow-[0_0_15px_-4px_rgba(16,185,129,0.3)]">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{standard}</span>
        </span>
      )}
      {level && (
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/25">
          <span>🎓</span>
          <span>{level}</span>
        </span>
      )}
      {language && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800/90 text-slate-200 border border-slate-700/80 font-mono uppercase tracking-wider">
          <span class="text-cyan-400">🌐</span>
          <span>{language}</span>
        </span>
      )}
      {subject && (
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-300 border border-purple-500/25">
          <span>📖</span>
          <span>{subject.replace(/[-_]/g, ' ')}</span>
        </span>
      )}
      {estimatedMinutes && (
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800/80 text-slate-300 border border-white/[0.08]">
          <span>⏱️</span>
          <span>{estimatedMinutes} min de práctica</span>
        </span>
      )}
    </div>

    <!-- Title and Subtitle -->
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4 leading-[1.15]">
      {title}
    </h1>

    {subtitle && (
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed font-normal">
        {subtitle}
      </p>
    )}
  </div>
</header>
