---
import { appLink } from "@colabedu/ui-core/navigation";
import { JURISDICTIONS_REGISTRY, getAvailableJurisdictions } from "@colabedu/ui-core";

// src/components/Header.astro
const { lang = 'es' } = Astro.props;
const supportUrl = appLink('support', '/');
const appUrl = appLink('app', '/');
// Enlace interactivo principal: catálogo en Flutter Web ejecutable
const catalogUrl = appLink('app', '/navigator/spec_root/0');
const seoCatalogUrl = appLink('catalog', '/');

const jurisdictions = getAvailableJurisdictions();
const currentPath = Astro.url.pathname;
const isEn = lang === 'en';
const t = {
    memberships: isEn ? 'Memberships' : 'Membresías',
    membershipsDesc: isEn ? 'For teachers, students & families' : 'Para docentes, estudiantes y familias',
    sponsored: isEn ? 'Sponsored Memberships' : 'Membresías Esponsorizadas',
    sponsoredDesc: isEn ? 'District funds, B2G grants & vouchers' : 'Fondos de distrito, B2G y vouchers',
    institutions: isEn ? 'Schools & Networks' : 'Colegios y Redes',
    institutionsDesc: isEn ? 'Districts & whole-school deployment' : 'Convenios y despliegue integral',
    pedagogy: isEn ? 'Pedagogy' : 'Pedagogía',
    vision: isEn ? 'Vision & Mission' : 'Visión & Misión',
    visionDesc: isEn ? 'The 4 immutable classroom principles' : 'Los 4 principios inmutables del aula',
    safeSpace: 'Safe Space',
    safeSpaceDesc: isEn ? 'Confidential practice without fear of error' : 'Espacio confidencial sin miedo al error',
    socraticTutor: isEn ? 'Socratic Tutor' : 'Tutor Socrático',
    socraticDesc: isEn ? '9-step scaffolding vs. copy-paste chatbots' : 'Andamiaje de 9 pasos vs. chatbots',
    inclusion: isEn ? 'Linguistic Inclusion' : 'Inclusión Lingüística',
    inclusionDesc: isEn ? 'Real scaffolding for newcomer students' : 'Apoyo a alumnos recién llegados (Newcomers)',
    technology: isEn ? 'Technology & Apps' : 'Tecnología & Apps',
    grounding: isEn ? 'Grounding L0 & C0-C3' : 'Grounding L0 & Capas C0-C3',
    groundingDesc: isEn ? 'Zero tolerance to normative hallucinations' : 'Tolerancia cero a alucinaciones normativas',
    extension: isEn ? 'LMS Extension' : 'Extensión LMS',
    extensionDesc: isEn ? 'Canvas SpeedGrader, Moodle & Classroom' : 'Canvas SpeedGrader, Moodle y Classroom',
    lti: isEn ? 'LTI 1.3 Advantage' : 'Integración LTI 1.3',
    opsSpec: isEn ? 'OPS Specification' : 'Especificación OPS',
    opsSpecDesc: isEn ? 'Open Pedagogy Specification v0.9.6' : 'Especificación abierta declarativa v0.9.6',
    interactiveLessons: isEn ? 'Interactive Lessons' : 'Lecciones Interactivas',
    interactiveLessonsDesc: isEn ? 'Micro-learning, charts & dynamic simulations' : 'Micro-learning, simulaciones y widgets',
    interactiveExams: isEn ? 'Authentic Exams & OCR' : 'Exámenes & Corrección OCR',
    interactiveExamsDesc: isEn ? 'Paper OCR, oral voice & official rubrics' : 'Folios en papel, audio y rúbricas oficiales',
    gradebook: isEn ? 'Classrooms, Gradebook & Feedback' : 'Aulas, Gradebook & Feedback',
    gradebookDesc: isEn ? 'Live lesson radar, exercise gradebook & feedback' : 'Progreso en vivo, notas de ejercicios y feedback',
    catalogs: isEn ? 'The 3 Catalogs' : 'Los 3 Catálogos',
    catalogsDesc: isEn ? 'ColabEdu courses, OER & teacher community' : 'Cursos ensamblados, OER y comunidad docente',
    philosophy: isEn ? 'Catalog Philosophy' : 'Filosofía del Catálogo',
    philosophyDesc: isEn ? '65+ federated OER repositories & open culture' : '65+ repositorios OER y soberanía didáctica',
    howGrading: isEn ? 'AI-Assisted Grading' : 'Evaluación Asistida por IA',
    howGradingDesc: isEn ? '3-step cycle: Catalog, Submissions & LMS' : 'Ciclo en 3 etapas, rúbricas y PISA',
    apps: isEn ? 'Tablets & Mobile Apps' : 'Tablets, Móviles & Apps',
    appsDesc: isEn ? 'Native apps for classroom tablets & phones' : 'Apps nativas para carritos de tablets y móviles',
    pisaDiagnostics: isEn ? 'Regional & PISA Diagnostics' : 'Diagnóstico Regional & PISA',
    pisaDiagnosticsDesc: isEn ? 'AI-assisted census assessments in days' : 'Macro-evaluación censal en días',
    editorial: isEn ? 'For Publishers' : 'Para Editoriales',
    editorialDesc: isEn ? 'IP protection & Blind Referencing' : 'Protección de IP y Referencialidad Ciega',
    dataPrivacy: isEn ? 'Privacy & Data Sovereignty' : 'Privacidad & Soberanía de Datos',
    dataPrivacyDesc: isEn ? 'GDPR, FERPA & zero model training' : 'RGPD, FERPA y cero entrenamiento LLM',
    communityMenu: isEn ? 'Community & Schools' : 'Comunidad & Centros',
    communityServices: isEn ? 'Community & Services' : 'Comunidad & Servicios',
    fellows: isEn ? 'Education Fellows' : 'Education Fellows',
    fellowsDesc: isEn ? 'University internships, institutional partnerships & OER' : 'Prácticas universitarias, alianzas institucionales y OER',
    crossCompetencies: isEn ? 'Cross-Competencies & Shadow' : 'Competencias Cruzadas & Shadow',
    crossCompetenciesDesc: isEn ? 'Autonomous rubric mapping & PISA audits' : 'Mapeo autónomo de rúbricas y auditorías PISA',
    catalog: isEn ? 'OER Catalog' : 'Catálogo OER',
    enterApp: isEn ? 'Enter App' : 'Entrar a la App',
};
---
<nav class="fixed w-full z-50 border-b border-slate-200" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-20 items-center">
            <!-- Brand Logo -->
            <div class="flex items-center gap-4">
                <a href={`/${lang}/`} class="flex items-center gap-2.5 group">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center font-black text-xl shadow-md group-hover:scale-105 transition-transform">
                        C
                    </div>
                    <div class="flex flex-col">
                        <span class="text-2xl font-black tracking-tight text-slate-900 leading-none">
                            Colab<span class="text-blue-600">Edu</span><span class="text-sm font-semibold text-slate-400 ml-1">.net</span>
                        </span>
                        <span class="text-[10px] font-bold text-teal-700 uppercase tracking-wider mt-0.5">{t.communityServices}</span>
                    </div>
                </a>
            </div>

            <!-- Modern Pedagogical & Functional Navigation Links -->
            <div class="hidden lg:flex items-center space-x-7 text-sm font-semibold text-slate-700">
                
                <!-- 1. Dropdown Pedagogía & Aula (Mega-menú estructurado de 2 columnas) -->
                <div class="relative group py-2">
                    <button class="flex items-center gap-1 hover:text-blue-600 transition-colors focus:outline-hidden">
                        <span>{t.pedagogy}</span>
                        <i class="fas fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                    </button>
                    <div class="absolute left-0 mt-2 w-[620px] rounded-2xl bg-white shadow-2xl border border-slate-200 p-4 hidden group-hover:block z-50 text-left animate-in fade-in duration-150">
                        
                        <!-- Bloque Superior Destacado: Visión & Filosofía del Catálogo OER -->
                        <div class="p-3.5 rounded-xl bg-gradient-to-r from-amber-500/10 via-amber-100/40 to-teal-500/10 border border-amber-200/80 mb-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-amber-900 bg-white/80 px-2 py-0.5 rounded-md border border-amber-200">
                                        {isEn ? 'Foundations & Open Culture' : 'Fundamentos & Cultura Abierta'}
                                    </span>
                                    <span class="text-[11px] font-bold text-slate-800">
                                        {isEn ? '65+ Syndicated OER Repositories' : '65+ Repositorios OER Sindicados'}
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-600 leading-snug">
                                    {isEn ? 'Transforming open knowledge into sovereign, interactive classroom software.' : 'Transformamos el conocimiento abierto en software didáctico interactivo y soberano.'}
                                </p>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <a href={`/${lang}/vision`} class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 text-xs font-bold transition-colors flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-compass text-[11px] text-blue-600"></i>
                                    <span>{t.vision}</span>
                                </a>
                                <a href={`/${lang}/catalog-philosophy`} class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-black transition-colors flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-book-open text-[11px]"></i>
                                    <span>{isEn ? 'Philosophy' : 'Filosofía'}</span>
                                </a>
                            </div>
                        </div>

                        <!-- Dos Columnas Paralelas: Experiencias de Aula vs. Catálogos & Equidad -->
                        <div class="grid grid-cols-2 gap-4">
                            <!-- Columna A: Experiencias de Aula & Evaluación -->
                            <div class="space-y-1">
                                <span class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-2 block mb-1">
                                    {isEn ? 'Classroom Experiences' : 'Experiencias de Aula'}
                                </span>

                                <a href={isEn ? '/en/daily-classroom' : '/es/dia-a-dia'} class="block px-3 py-2 rounded-xl hover:bg-amber-50/70 transition-colors">
                                    <div class="text-xs font-bold text-amber-800 flex items-center gap-1.5">
                                        <i class="fas fa-calendar-week text-[11px]"></i>
                                        <span>{isEn ? 'Day-to-Day Classroom' : 'Día a Día en el Aula'}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{isEn ? 'A normal week for teachers & students' : 'Una semana normal para profes y alumnos'}</div>
                                </a>

                                <a href={isEn ? '/en/subjects' : '/es/asignaturas'} class="block px-3 py-2 rounded-xl hover:bg-emerald-50/70 transition-colors">
                                    <div class="text-xs font-bold text-emerald-800 flex items-center gap-1.5">
                                        <i class="fas fa-book-open text-[11px]"></i>
                                        <span>{isEn ? 'Subjects by Region' : 'Asignaturas por Zona'}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{isEn ? 'Everyday units & exercises by grade' : 'Unidades y ejercicios reales por curso'}</div>
                                </a>
                                
                                <a href={`/${lang}/interactive-lessons`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-blue-700 flex items-center gap-1.5">
                                        <i class="fas fa-layer-group text-[11px]"></i>
                                        <span>{t.interactiveLessons}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.interactiveLessonsDesc}</div>
                                </a>

                                <a href={`/${lang}/interactive-exams`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-teal-700 flex items-center gap-1.5">
                                        <i class="fas fa-file-pen text-[11px]"></i>
                                        <span>{t.interactiveExams}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.interactiveExamsDesc}</div>
                                </a>

                                <a href={`/${lang}/classroom-gradebook`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-purple-700 flex items-center gap-1.5">
                                        <i class="fas fa-table-columns text-[11px]"></i>
                                        <span>{t.gradebook}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.gradebookDesc}</div>
                                </a>

                                <a href={`/${lang}/socratic-tutor`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-indigo-700 flex items-center gap-1.5">
                                        <i class="fas fa-comments text-[11px]"></i>
                                        <span>{t.socraticTutor}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.socraticDesc}</div>
                                </a>

                                <a href={`/${lang}/how-grading-works`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-sky-700 flex items-center gap-1.5">
                                        <i class="fas fa-check-double text-[11px]"></i>
                                        <span>{t.howGrading}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.howGradingDesc}</div>
                                </a>
                            </div>

                            <!-- Columna B: Catálogos, Equidad & Acompañamiento -->
                            <div class="space-y-1 border-l border-slate-100 pl-4">
                                <span class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-2 block mb-1">
                                    {isEn ? 'Ecosystem & Equity' : 'Ecosistema & Equidad'}
                                </span>

                                <a href={`/${lang}/catalogs`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-amber-800 flex items-center gap-1.5">
                                        <i class="fas fa-cubes-stacked text-[11px] text-amber-600"></i>
                                        <span>{t.catalogs}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.catalogsDesc}</div>
                                </a>

                                <a href={`/${lang}/safe-space`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-emerald-700 flex items-center gap-1.5">
                                        <i class="fas fa-shield-halved text-[11px]"></i>
                                        <span>{t.safeSpace}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.safeSpaceDesc}</div>
                                </a>

                                <a href={`/${lang}/linguistic-inclusion`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-teal-700 flex items-center gap-1.5">
                                        <i class="fas fa-globe text-[11px]"></i>
                                        <span>{t.inclusion}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.inclusionDesc}</div>
                                </a>

                                <a href={`/${lang}/cross-competencies`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-teal-700 flex items-center gap-1.5">
                                        <i class="fas fa-network-wired text-[11px] text-teal-600"></i>
                                        <span>{t.crossCompetencies}</span>
                                        <span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-teal-100 text-teal-800">PISA</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.crossCompetenciesDesc}</div>
                                </a>

                                <a href={`/${lang}/grounding`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                        <i class="fas fa-certificate text-[11px] text-amber-600"></i>
                                        <span>{t.grounding}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.groundingDesc}</div>
                                </a>

                                <a href={`/${lang}/ops-specification`} class="block px-3 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                                    <div class="text-xs font-bold text-blue-700 flex items-center gap-1.5">
                                        <i class="fas fa-cube text-[11px]"></i>
                                        <span>{t.opsSpec}</span>
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.opsSpecDesc}</div>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 2. Catálogo OER Federado (Embebido en Modal In-Situ) -->
                <button
                    type="button"
                    data-open-catalog-modal
                    class="hover:text-amber-600 transition-colors flex items-center gap-1.5 text-slate-700 font-semibold cursor-pointer"
                    title={isEn ? "Explore OER Catalog (In-Situ Preview)" : "Explorar Catálogo OER (Vista Previa Embebida)"}
                >
                    <span>{t.catalog}</span>
                    <i class="fas fa-layer-group text-[11px] text-amber-500"></i>
                </button>

                <!-- 3. Dropdown Tecnología, Integración & Apps -->
                <div class="relative group py-2">
                    <button class="flex items-center gap-1 hover:text-blue-600 transition-colors focus:outline-hidden">
                        <span>{t.technology}</span>
                        <i class="fas fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                    </button>
                    <div class="absolute left-0 mt-2 w-72 rounded-2xl bg-white shadow-xl border border-slate-200 p-2.5 hidden group-hover:block z-50 text-left">
                        <div class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-3 py-1 block">
                            Aplicaciones & Aula
                        </div>
                        <a href={`/${lang}/apps`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-teal-700 flex items-center gap-1.5">
                                <i class="fas fa-tablet-screen-button text-[11px]"></i>
                                <span>{t.apps}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.appsDesc}</div>
                        </a>
                        <a href={`/${lang}/extension`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-blue-700 flex items-center gap-1.5">
                                <i class="fas fa-puzzle-piece text-[11px]"></i>
                                <span>{t.extension}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.extensionDesc}</div>
                        </a>
                        <a href={`/${lang}/lti`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-indigo-700 flex items-center gap-1.5">
                                <i class="fas fa-network-wired text-[11px]"></i>
                                <span>{t.lti}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.ltiDesc}</div>
                        </a>

                        <div class="my-1.5 border-t border-slate-100"></div>
                        <div class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-3 py-1 block">
                            Estándares Abiertos & Normativa
                        </div>
                        <a href={`/${lang}/ops-specification`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-blue-700 flex items-center gap-1.5">
                                <i class="fas fa-cube text-[11px]"></i>
                                <span>{t.opsSpec}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.opsSpecDesc}</div>
                        </a>
                        <a href={`/${lang}/grounding`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                <i class="fas fa-certificate text-[11px] text-amber-600"></i>
                                <span>{t.grounding}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.groundingDesc}</div>
                        </a>
                        <a href={`/${lang}/data-sovereignty-privacy`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-teal-800 flex items-center gap-1.5">
                                <i class="fas fa-shield-halved text-[11px] text-teal-600"></i>
                                <span>{t.dataPrivacy}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.dataPrivacyDesc}</div>
                        </a>
                    </div>
                </div>

                <!-- 4. Dropdown Centros, Convenios & Membresías -->
                <div class="relative group py-2">
                    <button class="flex items-center gap-1 hover:text-blue-600 transition-colors focus:outline-hidden text-slate-600">
                        <span>{t.communityMenu}</span>
                        <i class="fas fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                    </button>
                    <div class="absolute right-0 mt-2 w-72 rounded-2xl bg-white shadow-xl border border-slate-200 p-2.5 hidden group-hover:block z-50 text-left">
                        <div class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-3 py-1 block">
                            Instituciones & Distritos
                        </div>
                        <a href={`/${lang}/institutions`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                <i class="fas fa-building-columns text-[11px] text-blue-600"></i>
                                <span>{t.institutions}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.institutionsDesc}</div>
                        </a>
                        <a href={`/${lang}/pisa-diagnostics`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-indigo-700 flex items-center gap-1.5">
                                <i class="fas fa-chart-line text-[11px] text-indigo-600"></i>
                                <span>{t.pisaDiagnostics}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.pisaDiagnosticsDesc}</div>
                        </a>
                        <a href={`/${lang}/sponsored`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-amber-700 flex items-center gap-1.5">
                                <i class="fas fa-hand-holding-dollar text-[11px] text-amber-600"></i>
                                <span>{t.sponsored}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.sponsoredDesc}</div>
                        </a>
                        <a href={`/${lang}/fellows`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-teal-800 flex items-center gap-1.5">
                                <i class="fas fa-graduation-cap text-[11px] text-teal-600"></i>
                                <span>{t.fellows}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.fellowsDesc}</div>
                        </a>

                        <div class="my-1.5 border-t border-slate-100"></div>
                        <div class="text-[10px] font-mono font-bold text-slate-400 uppercase tracking-wider px-3 py-1 block">
                            Docentes, Alumnos & Familias
                        </div>
                        <a href={`/${lang}/memberships`} class="block px-3.5 py-2 rounded-xl hover:bg-slate-50 transition-colors">
                            <div class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
                                <i class="fas fa-id-card text-[11px] text-teal-600"></i>
                                <span>{t.memberships}</span>
                            </div>
                            <div class="text-[10px] text-slate-500 font-normal mt-0.5">{t.membershipsDesc}</div>
                        </a>
                    </div>
                </div>

            </div>
            
            <!-- Actions & App Entry -->
            <div class="flex items-center gap-3.5">
                <!-- Sovereign Jurisdiction & Language Selector -->
                <div class="relative group py-2">
                    <button
                        type="button"
                        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200/80 rounded-full transition-all border border-slate-200/80 cursor-pointer focus:outline-hidden"
                        title={isEn ? "Select Educational Jurisdiction & Language" : "Seleccionar Marco Educativo e Idioma"}
                    >
                        <i class="fas fa-earth-americas text-slate-500 text-[11px]"></i>
                        <span class="uppercase tracking-wide">{lang}</span>
                        <i class="fas fa-chevron-down text-[9px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                    </button>

                    <!-- Dropdown Mega-Menu for Jurisdictions & Languages -->
                    <div class="absolute right-0 mt-2 w-80 rounded-2xl bg-white shadow-2xl border border-slate-200 p-3 hidden group-hover:block z-50 text-left animate-in fade-in duration-150">
