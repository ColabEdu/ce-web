---
import "@colabedu/ui-core/styles/global.css";
import FlutterDemo from "../components/FlutterDemo.astro";
import { DEMO_SUBMISSIONS } from "../data/demoSubmissions";

Astro.response.status = 200;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Laboratorio de Demos Interactivas | ColabEdu (OPS Engine)</title>
        <meta
            name="description"
            content="Explora el potencial y las capacidades ejecutables de Open Pedagogy Specification (OPS): evaluación multimodal, simulacros de examen, lecciones interactivas A2UI y analítica formativa."
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col">
        <!-- Promobar -->
        <div class="bg-indigo-600 text-white text-xs font-semibold text-center py-2 px-4 shadow-inner">
            <span class="opacity-90">🚀 Sandbox interactivo conectado al motor A2UI y SpecManager de ColabEdu</span>
        </div>

        <!-- Header -->
        <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-lg border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-16">
                    <div class="flex items-center gap-3">
                        <a href="/" class="text-2xl font-black text-white tracking-tighter hover:opacity-90 transition-opacity">
                            Colab<span class="text-indigo-500">Edu</span>.org
                        </a>
                        <span class="text-[0.65rem] font-bold text-indigo-400 border border-indigo-500/30 bg-indigo-500/10 rounded-full px-2.5 py-0.5 tracking-wider uppercase">
                            Interactive Lab
                        </span>
                    </div>
                    <nav class="hidden md:flex space-x-6 items-center text-sm font-medium">
                        <a href="/catalog" class="text-slate-300 hover:text-white transition-colors">Catálogo Curricular</a>
                        <a href="/demos" class="text-indigo-400 font-bold border-b-2 border-indigo-500 pb-0.5">Demos & Sandbox</a>
                        <a href="/es/oas-spec/" class="text-slate-300 hover:text-white transition-colors">Especificación OPS</a>
                        <a href="https://github.com/colabedu" class="text-slate-400 hover:text-white transition-colors">GitHub</a>
                        <div class="h-4 w-px bg-slate-800"></div>
                        <a href="/en/demos" class="text-xs font-bold text-slate-500 hover:text-indigo-400 transition-colors">EN</a>
                    </nav>
                    <div class="flex items-center space-x-3">
                        <a href="/catalog" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-bold shadow-md shadow-indigo-600/20 transition-all">
                            Ver Catálogo Abierto
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1">
            <!-- Hero Section -->
            <section class="relative pt-16 pb-14 px-4 sm:px-6 lg:px-8 text-center bg-radial from-indigo-950/40 via-slate-950 to-slate-950 border-b border-slate-800/80">
                <div class="max-w-4xl mx-auto">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 text-xs font-bold mb-4 border border-indigo-500/20">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Laboratorio Abierto de Potencialidades OPS
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-4">
                        Descubre lo que ocurre cuando la pedagogía <br class="hidden sm:inline" />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-sky-300 to-teal-300">se convierte en código ejecutable.</span>
                    </h1>
                    <p class="text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8">
                        ColabEdu trasciende el papel y las leyes educativas para materializarse en componentes interactivos, asistentes de corrección multimodal y evaluación socrática en tiempo real.
                    </p>

                    <!-- Quick Navigation Anchors -->
                    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold">
                        <a href="#lecciones-interactivas" class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-indigo-400 hover:text-indigo-300 text-slate-300 transition-colors">
                            📱 1. Lecciones Interactivas A2UI
                        </a>
                        <a href="#evaluacion-multimodal" class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-indigo-400 hover:text-indigo-300 text-slate-300 transition-colors">
                            📸 2. Evaluación Multimodal & Rúbrica
                        </a>
                        <a href="#simulacion-estudiantes" class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-indigo-400 hover:text-indigo-300 text-slate-300 transition-colors">
                            ⚡ 3. Sandbox & Simulador de Cohortes
                        </a>
                        <a href="#analitica-calibracion" class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-slate-700 hover:border-indigo-400 hover:text-indigo-300 text-slate-300 transition-colors">
                            📊 4. Calibración & Benchmarks
                        </a>
                    </div>
                </div>
            </section>

            <!-- Container for Demos -->
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-24">

                <!-- Demo 1: Lecciones Interactivas A2UI y Tipologías de Ejercicio -->
                <section id="lecciones-interactivas" class="scroll-mt-24">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>01 · Micro-Aprendizaje y Andamiaje Socrático</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
                            Lección Interactiva Multimodal y Andamiaje A2UI Server-Driven
                        </h2>
                        <p class="text-slate-400 max-w-3xl text-sm sm:text-base leading-relaxed">
                            Las lecciones interactivas de ColabEdu se ensamblan a partir de especificaciones pedagógicas YAML (OPS). Un único motor Server-Driven orquesta múltiples tipologías de ejercicio con andamiaje socrático guiado, feedback inmediato y evaluación formativa.
                        </p>
                    </div>

                    <!-- Slide Typology Quick Switcher -->
                    <div class="mb-4 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-xl">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800">
                            <div>
                                <h3 class="text-xs font-bold text-white flex items-center gap-1.5">
                                    <span>🧩 Explorador Rápido de Tipologías de Ejercicio (Lección Canónica 1º ESO):</span>
                                </h3>
                                <p class="text-[11px] text-slate-400 mt-0.5">
                                    Haz clic en cualquiera de las tipologías para saltar instantáneamente a su diapositiva interactiva dentro del motor.
                                </p>
                            </div>
                            <span class="text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-md self-start sm:self-auto">
                                13 Slides en Vivo
                            </span>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2 mt-3" id="lesson-typology-tabs">
                            <button
                                type="button"
                                data-slide-index="2"
                                data-slide-id="slide_03_comprension_infanta"
                                class="lesson-slide-btn active p-2 rounded-lg border border-indigo-500 bg-indigo-950/40 text-white text-left transition-all text-xs flex flex-col gap-1 ring-1 ring-indigo-500"
                            >
                                <span class="text-sm">❓</span>
                                <span class="font-bold line-clamp-1">Quiz Lectura</span>
                                <span class="text-[10px] text-slate-400">Slide 3 · Wilde</span>
                            </button>
                            <button
                                type="button"
                                data-slide-index="3"
                                data-slide-id="slide_04_diptongos_hiatos"
                                class="lesson-slide-btn p-2 rounded-lg border border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 text-left transition-all text-xs flex flex-col gap-1"
                            >
                                <span class="text-sm">🗂️</span>
                                <span class="font-bold line-clamp-1">Clasificación</span>
                                <span class="text-[10px] text-slate-400">Slide 4 · Diptongos</span>
                            </button>
                            <button
                                type="button"
                                data-slide-index="4"
                                data-slide-id="slide_05_lexico_formacion"
                                class="lesson-slide-btn p-2 rounded-lg border border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 text-left transition-all text-xs flex flex-col gap-1"
                            >
                                <span class="text-sm">🔗</span>
                                <span class="font-bold line-clamp-1">Emparejamiento</span>
                                <span class="text-[10px] text-slate-400">Slide 5 · Léxico</span>
                            </button>
                            <button
                                type="button"
                                data-slide-index="5"
                                data-slide-id="slide_06_carta_formal"
                                class="lesson-slide-btn p-2 rounded-lg border border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 text-left transition-all text-xs flex flex-col gap-1"
                            >
                                <span class="text-sm">✍️</span>
                                <span class="font-bold line-clamp-1">Ensayo / Pizarra</span>
                                <span class="text-[10px] text-slate-400">Slide 6 · Carta Formal</span>
                            </button>
                            <button
                                type="button"
                                data-slide-index="8"
                                data-slide-id="slide_09_debate_reciclaje"
                                class="lesson-slide-btn p-2 rounded-lg border border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 text-left transition-all text-xs flex flex-col gap-1"
                            >
                                <span class="text-sm">⚖️</span>
                                <span class="font-bold line-clamp-1">Debate Socrático</span>
                                <span class="text-[10px] text-slate-400">Slide 9 · Dialéctica</span>
                            </button>
                            <button
                                type="button"
                                data-slide-index="11"
                                data-slide-id="slide_12_creacion_oral_tutankamon"
                                class="lesson-slide-btn p-2 rounded-lg border border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 text-left transition-all text-xs flex flex-col gap-1"
                            >
                                <span class="text-sm">🎙️</span>
                                <span class="font-bold line-clamp-1">Grabación Oral</span>
                                <span class="text-[10px] text-slate-400">Slide 12 · Oratoria</span>
                            </button>
                        </div>
                    </div>

                    <FlutterDemo
                        id="demo-interactive-lesson-iframe"
                        route="/lesson/es.lomloe.eso1.lcl.unidad_3.socratic.v1?slide=2&embed=true"
                        title="Interactive Lesson Engine · Resolución Guiada Multimodal"
                        height="1050px"
                    />
                </section>

                <!-- Demo 2: Evaluación Multimodal y Rúbricas Oficiales -->
                <section id="evaluacion-multimodal" class="scroll-mt-24">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>02 · Corrección Formativa Determinista</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
                            Evaluación Multimodal: De Manuscritos a Feedback con Rúbrica
                        </h2>
                        <p class="text-slate-400 max-w-3xl text-sm sm:text-base leading-relaxed">
                            Carga un examen manuscrito o un ensayo de texto. El motor de <strong>Grading V2</strong> analiza el contenido frente a la especificación de rúbrica oficial (EBAU, AP o IB), califica criterio a criterio y ofrece explicaciones pedagógicas auditables sin alucinación.
                        </p>
                    </div>

                    <!-- Static Submissions Selector & Interactive Sandbox -->
                    <div class="mb-6 p-5 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-xl">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-800">
                            <div>
                                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                    <span>🎯 Selecciona una Entrega de Alumno para Evaluar en Directo:</span>
                                </h3>
                                <p class="text-xs text-slate-400 mt-0.5">
                                    Elige entre distintas tipologías de respuesta escolar y observa cómo el motor calibra la nota y el radar competencial en tiempo real.
                                </p>
                            </div>
                            <span class="text-[11px] font-semibold text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-1 rounded-md self-start sm:self-auto">
                                4 Submissions Preconfiguradas
                            </span>
                        </div>

                        <!-- Selector Buttons / Tabs -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 mt-4" id="submission-selector-tabs">
                            {DEMO_SUBMISSIONS.map((sub, idx) => (
                                <button
                                    type="button"
                                    data-sub-id={sub.id}
                                    class={`submission-tab-btn text-left p-3 rounded-xl border transition-all flex flex-col justify-between gap-2 ${
                                        idx === 0
                                            ? "active border-indigo-500 bg-indigo-950/40 text-white shadow-md shadow-indigo-500/10 ring-1 ring-indigo-500"
                                            : "border-slate-800 bg-slate-950/50 hover:border-slate-700 text-slate-300 hover:text-white"
                                    }`}
                                >
                                    <div class="flex items-center justify-between w-full">
                                        <span class="text-base">{sub.icon}</span>
                                        <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                                            sub.badgeColor === 'emerald' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' :
                                            sub.badgeColor === 'amber' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' :
                                            sub.badgeColor === 'indigo' ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30' :
                                            'bg-rose-500/20 text-rose-300 border border-rose-500/30'
                                        }`}>
                                            {sub.expectedScore}
                                        </span>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white line-clamp-1">{sub.shortTitle}</div>
                                        <div class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">{sub.author}</div>
                                    </div>
                                </button>
                            ))}
                        </div>

                        <!-- Active Submission Preview & Action -->
                        <div class="mt-4 p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span id="sub-active-icon" class="text-base">📄</span>
                                        <h4 id="sub-active-title" class="text-xs font-bold text-white">
                                            {DEMO_SUBMISSIONS[0].title}
                                        </h4>
                                    </div>
                                    <p id="sub-active-desc" class="text-[11.5px] text-slate-400 mt-1">
                                        {DEMO_SUBMISSIONS[0].previewDescription}
                                    </p>
                                </div>
                                <div class="flex items-center gap-2 self-end md:self-auto shrink-0">
                                    <button
                                        type="button"
                                        id="btn-evaluate-submission"
                                        class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-600/30 flex items-center gap-1.5 transition-all"
                                    >
                                        <span>⚡ Cargar y Evaluar en Simulador</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Media Preview (Handwritten Image or Audio Player if present) -->
                            <div id="sub-active-media" class="mt-3">
                                {DEMO_SUBMISSIONS[0].imageUrl && (
                                    <div class="p-3 rounded-lg bg-slate-900 border border-slate-800 flex flex-col sm:flex-row gap-3 items-center">
                                        <img
                                            src={DEMO_SUBMISSIONS[0].imageUrl}
                                            alt="Manuscrito Escaneado"
                                            class="w-full sm:w-48 h-32 object-cover rounded border border-slate-700 shadow-md cursor-pointer hover:opacity-90 transition-opacity"
                                            onclick="window.open(this.src, '_blank')"
                                            title="Haz clic para ver la imagen a tamaño completo"
                                        />
                                        <div class="text-[11.5px] text-slate-300">
                                            <div class="font-bold text-white flex items-center gap-1.5 mb-1">
                                                <span>📷 Cuaderno Real Escolar (OCR Vision)</span>
                                                <span class="text-[10px] text-indigo-400 bg-indigo-500/10 px-1.5 py-0.5 rounded">Tachaduras y homófonos</span>
                                            </div>
                                            <p class="text-slate-400 leading-snug">
                                                Fotografía con luz de flexo que muestra correcciones sobre la marcha ("tubo / tuvo"), vacilaciones sintácticas y palabras tachadas.
                                            </p>
                                        </div>
                                    </div>
                                )}
                            </div>

                            <!-- Expandable preview of submission text / OCR transcription -->
                            <details class="group mt-2">
                                <summary class="cursor-pointer text-[11px] font-semibold text-indigo-400 hover:text-indigo-300 flex items-center gap-1 select-none">
                                    <span class="group-open:hidden">👁️ Ver transcripción / texto original de la entrega</span>
                                    <span class="hidden group-open:inline">✕ Ocultar transcripción</span>
                                </summary>
                                <div class="mt-3 p-3 rounded-lg bg-slate-900 border border-slate-800 font-mono text-[11.5px] text-slate-300 whitespace-pre-line leading-relaxed max-h-48 overflow-y-auto" id="sub-active-content">
                                    {DEMO_SUBMISSIONS[0].content}
                                </div>
                            </details>
                        </div>
                    </div>

                    <FlutterDemo
                        id="demo-essay-iframe"
                        route={`/lesson/${DEMO_SUBMISSIONS[0].targetLesson}?slide=${DEMO_SUBMISSIONS[0].slideId}&embed=true&mode=feedback`}
                        title="Grading V2 · Feedback de Ensayo y Rúbrica Oficial (Evaluación en Vivo)"
                        height="1050px"
                    />
                </section>

                <!-- Demo 3: Sandbox Abierto & Ingesta -->
                <section id="simulacion-estudiantes" class="scroll-mt-24">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>03 · Generación e Ingesta de Cursos</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
                            Sandbox Abierto y Simulador de Perfiles de Alumno
                        </h2>
                        <p class="text-slate-400 max-w-3xl text-sm sm:text-base leading-relaxed">
                            Experimenta cómo el motor ingesta documentos curriculares oficiales o simula diferentes perfiles de respuesta estudiantil (alumno sobresaliente vs alumno con dificultades de comprensión).
                        </p>
                    </div>

                    <FlutterDemo
                        route="/demo"
                        title="ColabEdu Open Sandbox · Ingesta Instantánea y Simulación"
                        height="720px"
                    />
                </section>

                <!-- Demo 4: Matriz de Calibración de Rúbricas -->
                <section id="analitica-calibracion" class="scroll-mt-24">
                    <div class="mb-6">
                        <div class="inline-flex items-center gap-2 text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2">
                            <span>04 · Calidad y Benchmarking LLM-as-a-Judge</span>
                        </div>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
                            Matriz de Calibración Sintética y Benchmarks de Evaluación
                        </h2>
                        <p class="text-slate-400 max-w-3xl text-sm sm:text-base leading-relaxed">
                            Garantía de fiabilidad: auditoría visual de consistencia inter-juez para validar que el modelo de IA evalúa con la misma severidad y equidad que los tribunales oficiales de examen.
                        </p>
                    </div>

                    <FlutterDemo
                        route="/calibration/matrix/102"
                        title="Grading V2 · Matriz de Calibración Sintética y Anchors"
                        height="680px"
                    />
                </section>

            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-slate-950 border-t border-slate-800 py-12 text-center text-slate-500">
            <div class="max-w-7xl mx-auto px-4 flex flex-col items-center gap-4">
                <p class="text-sm font-semibold tracking-wider uppercase text-slate-400">ColabEdu.org · Open Pedagogy Specification</p>
                <div class="flex gap-4 items-center flex-wrap justify-center text-xs">
                    <a href="/" class="hover:text-white transition-colors">Inicio</a>
                    <span>|</span>
                    <a href="/catalog" class="hover:text-white transition-colors">Catálogo Curricular</a>
                    <span>|</span>
                    <a href="/es/oas-spec/" class="hover:text-white transition-colors">Especificación OPS</a>
                    <span>|</span>
                    <a href="https://github.com/colabedu" class="hover:text-white transition-colors">GitHub</a>
                </div>
                <p class="text-xs text-slate-600 mt-4">🌍 Built in California & Spain · Cupertino | Madrid | Ciudad de México</p>
            </div>
        </footer>

        <!-- Script para alternancia e inyección dinámica de Submissions -->
        <script define:vars={{ demoSubmissions: DEMO_SUBMISSIONS }}>
            document.addEventListener('DOMContentLoaded', () => {
                const tabs = document.querySelectorAll('.submission-tab-btn');
                const titleEl = document.getElementById('sub-active-title');
                const descEl = document.getElementById('sub-active-desc');
                const iconEl = document.getElementById('sub-active-icon');
                const contentEl = document.getElementById('sub-active-content');
                const evalBtn = document.getElementById('btn-evaluate-submission');
                const iframe = document.getElementById('demo-essay-iframe');

                const mediaEl = document.getElementById('sub-active-media');

                let currentSubmission = demoSubmissions[0];

                function selectSubmission(sub) {
                    currentSubmission = sub;
                    if (titleEl) titleEl.textContent = sub.title;
                    if (descEl) descEl.textContent = sub.previewDescription;
                    if (iconEl) iconEl.textContent = sub.icon;
                    if (contentEl) contentEl.textContent = sub.content;

                    if (mediaEl) {
                        if (sub.imageUrl) {
                            mediaEl.innerHTML = `
                                <div class="p-3 rounded-lg bg-slate-900 border border-slate-800 flex flex-col sm:flex-row gap-3 items-center">
                                    <img
                                        src="${sub.imageUrl}"
                                        alt="Manuscrito Escaneado"
                                        class="w-full sm:w-48 h-32 object-cover rounded border border-slate-700 shadow-md cursor-pointer hover:opacity-90 transition-opacity"
                                        onclick="window.open(this.src, '_blank')"
                                        title="Haz clic para ver la imagen a tamaño completo"
                                    />
                                    <div class="text-[11.5px] text-slate-300">
                                        <div class="font-bold text-white flex items-center gap-1.5 mb-1">
                                            <span>📷 Cuaderno Real Escolar (OCR Vision)</span>
                                            <span class="text-[10px] text-indigo-400 bg-indigo-500/10 px-1.5 py-0.5 rounded">Tachaduras y homófonos</span>
                                        </div>
                                        <p class="text-slate-400 leading-snug">
                                            Fotografía cenital con luz de flexo que muestra correcciones sobre la marcha ("tubo / tuvo"), vacilaciones sintácticas y palabras tachadas capturadas por el motor.
                                        </p>
                                    </div>
                                </div>
                            `;
                        } else if (sub.audioUrl) {
                            mediaEl.innerHTML = `
                                <div class="p-3 rounded-lg bg-slate-900 border border-slate-800 flex flex-col sm:flex-row gap-3 items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg shrink-0">
                                            🎙️
                                        </div>
                                        <div class="text-[11.5px]">
                                            <div class="font-bold text-white flex items-center gap-1.5">
                                                <span>Audio Oral Escolar (Voz Sintética de Joven)</span>
                                                <span class="text-[10px] text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded">Vacilaciones y Muletillas</span>
                                            </div>
                                            <p class="text-slate-400 text-[11px] mt-0.5">
                                                Escucha la alocución real con titubeos ("eh...", "o sea"), léxico juvenil ("postureo", "chavales") y muletillas de relleno.
                                            </p>
                                        </div>
                                    </div>
                                    <audio controls class="w-full sm:w-64 h-9 shrink-0">
                                        <source src="${sub.audioUrl}" type="audio/mpeg" />
                                        Tu navegador no soporta reproducción de audio.
                                    </audio>
                                </div>
                            `;
                        } else {
                            mediaEl.innerHTML = '';
                        }
                    }

                    tabs.forEach(btn => {
                        const id = btn.getAttribute('data-sub-id');
                        if (id === sub.id) {
                            btn.classList.add('active', 'border-indigo-500', 'bg-indigo-950/40', 'text-white', 'ring-1', 'ring-indigo-500');
                            btn.classList.remove('border-slate-800', 'bg-slate-950/50', 'text-slate-300');
                        } else {
                            btn.classList.remove('active', 'border-indigo-500', 'bg-indigo-950/40', 'text-white', 'ring-1', 'ring-indigo-500');
                            btn.classList.add('border-slate-800', 'bg-slate-950/50', 'text-slate-300');
                        }
                    });
                }

                function injectSubmissionIntoIframe() {
                    if (!iframe || !currentSubmission) return;

                    // 1. Intentar comunicación reactiva postMessage si el iframe está cargado
                    let postMessageSent = false;
                    try {
                        if (iframe.contentWindow) {
                            iframe.contentWindow.postMessage({
                                type: 'colabedu:set_submission',
                                slideId: currentSubmission.slideId,
                                slideIndex: currentSubmission.slideIndex,
                                submissionText: currentSubmission.content,
                                activityType: currentSubmission.activityType,
                                rubricCriteriaRef: currentSubmission.rubricStandard,
                                mode: currentSubmission.type === 'manuscript_ocr' ? 'whiteboard' : 'text',
                                audioUrl: currentSubmission.audioUrl,
                                autoEvaluate: true,
                            }, '*');
                            postMessageSent = true;
                        }
                    } catch (e) {
                        console.warn('[ColabEdu Demos] postMessage failed:', e);
                    }

                    // 2. Fallback solo si postMessage falló
                    if (!postMessageSent) {
                        try {
                            const currentSrc = iframe.getAttribute('src') || '';
                            const baseUrl = currentSrc.split('/#')[0] || currentSrc.split('#')[0] || 'http://localhost:8080';
                            const encodedSub = encodeURIComponent(currentSubmission.content);
                            const targetSlide = currentSubmission.slideId || currentSubmission.slideIndex;
                            const newHashRoute = `/#/lesson/${currentSubmission.targetLesson}?slide=${targetSlide}&embed=true&mode=feedback&submissionText=${encodedSub}`;
                            const fullTargetUrl = `${baseUrl}${newHashRoute}`;

                            iframe.setAttribute('src', fullTargetUrl);
                        } catch (err) {
                            console.error('[ColabEdu Demos] Error updating iframe src:', err);
                        }
                    }
                }

                // Lesson typology slide switcher
                const lessonSlideBtns = document.querySelectorAll('.lesson-slide-btn');
                const lessonIframe = document.getElementById('demo-interactive-lesson-iframe');

                lessonSlideBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const targetSlide = btn.getAttribute('data-slide-index') || '2';
                        const targetSlideId = btn.getAttribute('data-slide-id') || '';

                        lessonSlideBtns.forEach(b => {
                            if (b === btn) {
                                b.classList.add('active', 'border-indigo-500', 'bg-indigo-950/40', 'text-white', 'ring-1', 'ring-indigo-500');
                                b.classList.remove('border-slate-800', 'bg-slate-950/50', 'text-slate-300');
                            } else {
                                b.classList.remove('active', 'border-indigo-500', 'bg-indigo-950/40', 'text-white', 'ring-1', 'ring-indigo-500');
                                b.classList.add('border-slate-800', 'bg-slate-950/50', 'text-slate-300');
                            }
                        });

                        if (lessonIframe) {
                            let postMessageSent = false;
                            try {
                                if (lessonIframe.contentWindow) {
                                    // Send both slideIndex and slideId for maximum compatibility
                                    lessonIframe.contentWindow.postMessage({
                                        type: 'colabedu:goto_slide',
                                        slideIndex: parseInt(targetSlide, 10),
                                        slideId: targetSlideId,
                                    }, '*');
                                    postMessageSent = true;
                                }
                            } catch (e) {
                                console.warn('[ColabEdu Demos] postMessage failed:', e);
                            }

                            // Only fallback to URL src reload if postMessage could not be sent
                            if (!postMessageSent) {
                                try {
                                    const currentSrc = lessonIframe.getAttribute('src') || '';
                                    const baseUrl = currentSrc.split('/#')[0] || currentSrc.split('#')[0] || 'http://localhost:8080';
                                    const newRoute = `/#/lesson/es.lomloe.eso1.lcl.unidad_3.socratic.v1?slide=${targetSlide}&embed=true`;
                                    lessonIframe.setAttribute('src', `${baseUrl}${newRoute}`);
                                } catch (err) {
                                    console.error('[ColabEdu Demos] Error switching lesson slide:', err);
                                }
                            }
                        }
                    });
                });

                tabs.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const subId = btn.getAttribute('data-sub-id');
                        const sub = demoSubmissions.find(s => s.id === subId);
                        if (sub) {
                            selectSubmission(sub);
                            injectSubmissionIntoIframe();
                        }
                    });
                });

                if (evalBtn) {
                    evalBtn.addEventListener('click', () => {
                        injectSubmissionIntoIframe();
                    });
                }
            });
        </script>
    </body>
</html>
