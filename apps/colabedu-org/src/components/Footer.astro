---
import Default from '@astrojs/starlight/components/Footer.astro';
import type { Props } from '@astrojs/starlight/props';
import GlobalModalHost from '@colabedu/ui-core/components/GlobalModalHost.astro';

const lang = Astro.props.locale || 'es';
const isEn = lang === 'en';
---

<Default {...Astro.props} />

<div class="colabedu-custom-footer">
  <div class="footer-links">
    <button type="button" data-open-catalog-modal class="modal-link-btn">
      {isEn ? 'OER Catalog (Modal)' : 'Catálogo OER (Modal)'}
    </button>
    <span class="separator">·</span>
    <button type="button" data-open-support-modal data-support-tab="chat" data-support-lang={currentLang} class="modal-link-btn">
      {isEn ? 'Support & Help' : 'Soporte y Ayuda'}
    </button>
    <span class="separator">·</span>
    <a href="/catalog/terms">{isEn ? 'Terms of Service' : 'Términos de Servicio (Beta)'}</a>
    <span class="separator">·</span>
    <a href="/catalog">{isEn ? 'Curricular Catalog' : 'Catálogo Curricular'}</a>
    <span class="separator">·</span>
    <a href="https://github.com/colabedu" target="_blank" rel="noopener">GitHub</a>
  </div>
  <div class="footer-primary">
    🌍 Built in California & Spain
  </div>
  <div class="footer-secondary">
    Cupertino | Madrid | Ciudad de México
  </div>
</div>

<GlobalModalHost lang={lang} />

<style>
  .colabedu-custom-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .footer-links {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .footer-links a,
  .footer-links .modal-link-btn {
    color: var(--sl-color-gray-3);
    background: transparent;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--sl-text-xs);
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover,
  .footer-links .modal-link-btn:hover {
    color: var(--sl-color-accent-high);
  }

  .footer-links .separator {
    color: var(--sl-color-gray-5);
  }

  .footer-primary {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  
  .footer-secondary {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
    letter-spacing: 0.05em;
  }
</style>
