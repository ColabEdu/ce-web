---
import CatalogLayout from '@/layouts/CatalogLayout.astro';
import ExamJsonLd from '@/components/seo/ExamJsonLd.astro';
import BreadcrumbJsonLd from '@/components/seo/BreadcrumbJsonLd.astro';
import { loadCatalog, BASE_APP_URL } from '@/lib/catalogLoader';
import type { ExamSpecItem, CourseSpecItem } from '@/lib/types';

export function getStaticPaths() {
  const { exams, courses } = loadCatalog();

  return exams.map((exam) => {
    const parentCourse = courses.find((c) => c.country === exam.country && c.level === exam.level && c.computedSlug === exam.subject);
    return {
      params: {
        country: exam.country,
        level: exam.level,
        subject: exam.subject,
        examSlug: exam.computedSlug,
      },
      props: {
        exam,
        course: parentCourse,
      },
    };
  });
}

interface Props {
  exam: ExamSpecItem;
  course?: CourseSpecItem;
}

const { exam, course } = Astro.props;

const canonicalUrl = `https://colabedu.org${exam.canonicalPath}`;

const breadcrumbs = [
  { label: "Catálogo", href: "/catalog" },
  { label: exam.country.toUpperCase(), href: `/catalog/${exam.country}` },
  { label: course ? course.name : exam.subject, href: course ? course.canonicalPath : `/catalog/${exam.country}` },
  { label: "Exámenes", href: `/catalog/${exam.country}/${exam.level}/${exam.subject}/examenes` },
  { label: exam.title, href: exam.canonicalPath },
];

const breadcrumbSchema = [
  { name: "Catálogo", url: "https://colabedu.org/catalog" },
  { name: exam.country.toUpperCase(), url: `https://colabedu.org/catalog/${exam.country}` },
  { name: course ? course.name : exam.subject, url: course ? `https://colabedu.org${course.canonicalPath}` : `https://colabedu.org/catalog/${exam.country}` },
  { name: "Exámenes", url: `https://colabedu.org/catalog/${exam.country}/${exam.level}/${exam.subject}/examenes` },
  { name: exam.title, url: canonicalUrl },
];
---

<CatalogLayout
  title={exam.computedMetaTitle}
  description={exam.computedMetaDescription}
  canonicalUrl={canonicalUrl}
>
  <ExamJsonLd slot="head" exam={exam} canonicalUrl={canonicalUrl} />
  <BreadcrumbJsonLd slot="head" items={breadcrumbSchema} />

  <!-- Exam Hero Section -->
  <header class="relative pt-12 pb-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800/80 bg-gradient-to-b from-[#0F172A] via-[#0A0E1A] to-[#070A12] overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(6,182,212,0.18),transparent)] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 flex-wrap">
        {breadcrumbs.map((b, idx) => (
          <div class="flex items-center gap-2">
            {idx > 0 && <span class="text-slate-600">/</span>}
            <a href={b.href} class="hover:text-cyan-400 transition-colors">
              {b.label}
            </a>
          </div>
        ))}
      </nav>

      <div class="flex items-center gap-2 flex-wrap mb-4">
        {exam.year && (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">
            Convocatoria Oficial {exam.year}
          </span>
        )}
        {exam.organization && (
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-slate-200 border border-slate-700">
            {exam.organization}
          </span>
        )}
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
          Duración: {exam.estimatedMinutes} min
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
          Nota Máxima: {exam.totalMaxScore} pts
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        {exam.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl">
        {exam.computedMetaDescription}
      </p>

      <!-- Main Action Bar -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          href={exam.appPracticeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-bold text-sm shadow-[0_0_25px_rgba(6,182,212,0.35)] transition-all hover:scale-102 flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span>Iniciar Simulacro en el Simulador ({exam.estimatedMinutes}m) ↗</span>
        </a>

        {course && (
          <a
            href={course.canonicalPath}
            class="px-5 py-3 rounded-xl bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700 text-xs font-semibold transition-all flex items-center justify-center gap-2"
          >
            <span>Ver Temario del Curso Completo</span>
          </a>
        )}
      </div>
    </div>
  </header>

  <!-- Exam Content Body -->
  <main class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-10">
    <!-- Context / Text Fragment -->
    {exam.contextText && (
      <section class="p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111726]/90 to-[#0A0E1A]/90 border border-slate-800 shadow-sm relative overflow-hidden">
        <div class="flex items-center gap-2 mb-4 text-xs uppercase tracking-wider font-semibold text-cyan-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Texto Oficial de Referencia / Enunciado Canónico</span>
        </div>
        <div class="text-sm sm:text-base text-slate-300 leading-relaxed font-serif whitespace-pre-line border-l-2 border-cyan-500/40 pl-4 py-1">
          {exam.contextText}
        </div>
      </section>
    )}

    <!-- Questions / Tasks Breakdown -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-white tracking-tight">
          Cuestiones y Criterios Oficiales de Calificación
        </h2>
        <span class="text-xs text-slate-400 font-mono">
          {exam.tasks.length} preguntas
        </span>
      </div>

      <div class="space-y-4">
        {exam.tasks.map((task, idx) => (
          <article class="p-6 rounded-2xl bg-gradient-to-b from-[#111726]/60 to-[#0A0E1A]/60 border border-slate-800/80 hover:border-slate-700 transition-all shadow-sm">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-cyan-500/15 text-cyan-400 font-bold text-xs flex items-center justify-center border border-cyan-500/30">
                  {idx + 1}
                </span>
                <h3 class="text-base font-bold text-white">
                  {task.title || `Cuestión ${idx + 1}`}
                </h3>
              </div>

              {task.score && (
                <span class="px-2.5 py-0.5 rounded font-mono font-bold text-xs bg-slate-800 text-cyan-300 border border-slate-700 shrink-0">
                  {task.score} pts
                </span>
              )}
            </div>

            <p class="text-sm text-slate-300 leading-relaxed whitespace-pre-line pl-8">
              {task.prompt}
            </p>

            <div class="mt-4 pt-3 border-t border-slate-800/50 flex items-center justify-between text-xs text-slate-500 pl-8">
              <span class="font-mono uppercase text-[10px] text-slate-400">
                Tipo: {task.type} {task.expectedOutputFormat ? `(${task.expectedOutputFormat})` : ''}
              </span>

              <a
                href={`${exam.appPracticeUrl}&question=${encodeURIComponent(task.id)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyan-400 hover:text-cyan-300 font-semibold inline-flex items-center gap-1 transition-colors"
              >
                <span>Resolver esta cuestión en simulador</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <div class="p-8 rounded-2xl bg-gradient-to-r from-cyan-950/40 via-blue-950/30 to-indigo-950/40 border border-cyan-500/30 text-center relative overflow-hidden shadow-lg">
      <div class="max-w-xl mx-auto relative z-10 space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          ¿Listo para poner a prueba tus conocimientos?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Accede al entorno de práctica socrático de ColabEdu con temporizador, corrección basada en las directrices de la {exam.organization || 'entidad oficial'} y retroalimentación paso a paso.
        </p>
        <div class="pt-2">
          <a
            href={exam.appPracticeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-wider shadow-[0_0_20px_rgba(6,182,212,0.3)] transition-all hover:scale-102"
          >
            <span>Comenzar Examen Completo ↗</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</CatalogLayout>
